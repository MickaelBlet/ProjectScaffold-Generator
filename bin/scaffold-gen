#!/bin/sh
# scaffold-gen: generates code skeletons from ProjectScaffold project files.
set -u
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=${here%/*}
jinja=$root/sh_jinja/lib/awk
lib=$root/lib/awk
if [ -z "${SCAFFOLD_AWK:-}" ]; then
	if command -v gawk >/dev/null 2>&1; then SCAFFOLD_AWK=gawk; else SCAFFOLD_AWK=awk; fi
fi

# run the awk program; arguments: awk -v assignments
run_awk() {
	set -- "$@"
	for f in value utf8 lexer parser runtime filters tests builtins json yaml; do
		set -- "$@" -f "$jinja/$f.awk"
	done
	for f in util case schema load values validate context ext cli main; do
		set -- "$@" -f "$lib/$f.awk"
	done
	# shellcheck disable=SC2086 # SCAFFOLD_AWK may hold arguments ("busybox awk")
	LC_ALL=C $SCAFFOLD_AWK "$@" </dev/null
}

case ${1-} in
--dump-context)
	run_awk -v MODE=dump-context -v FILE="$2" -v LABEL="$2" -v SCHEMA="$root/schema/scaffold.schema.json"
	;;
esac
