{
  "name": "project-scaffold-generator",
  "version": "1.0.0",
  "description": "Code skeleton generator for ProjectScaffold project files: Liquid template sets for C++, Python and SCA",
  "author": "Mickaël Blet",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "schema": "tsx scripts/gen-schema.ts",
    "generate": "tsx scripts/generate.ts",
    "cli": "tsx scripts/build-cli.ts"
  },
  "dependencies": {
    "liquidjs": "^10.29.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "immer": "^11.1.18",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
