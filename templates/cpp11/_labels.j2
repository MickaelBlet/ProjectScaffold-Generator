{% macro labels(c=none, t=none, d=none) %}
{% from '_value.j2' import value as _value %}
{#
  C++ test of discriminator `d` against the labels of a union case: `d == 1 || d == 2`.
  Parameters: c (the case), t (the discriminator type), d (expression).
#}
{% filter inline %}
{% for l in c.labels %}
  {{ d }} == {{ _value(v=l, t=t) }}{% if not loop.last %} || {% endif %}
{% endfor %}
{% endfilter %}
{% endmacro %}
