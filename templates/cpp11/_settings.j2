{% macro settings(s=none) %}
{% set ns = namespace(parts=[]) %}
{#
  Settings of a link's transport set in the project, as text: `broker 10.0.0.1:1883, topic rover, qos=1`
  (empty when none). Parameter: s (a link's `constraints.remote.settings`).
#}
{% for e in ['client', 'server', 'broker'] %}
  {% set at = s[e] if e in s else none %}
  {% if at.host != none or at.port != none %}
    {% set ns.parts = ns.parts + [e ~ ' ' ~ at.host ~ ':' ~ at.port] %}
  {% endif %}
{% endfor %}
{% for k in ['path', 'name', 'capacity', 'maxMessages', 'messageSize', 'socket', 'topic', 'interface', 'id', 'device', 'baud'] %}
  {% set v = s[k] if k in s else none %}
  {% if v != none %}
    {% set ns.parts = ns.parts + [k ~ ' ' ~ v] %}
  {% endif %}
{% endfor %}
{% for o in s.options %}
  {% set ns.parts = ns.parts + [o.name ~ '=' ~ o.value] %}
{% endfor %}
{{ ns.parts|join(', ') }}{% endmacro %}
