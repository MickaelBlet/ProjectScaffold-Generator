{% macro generated_transport(transport=none) %}
{#
  `true` for a transport written by transport.cpp and transport.py: tcp, udp, http, websocket, shm.
  Parameter: transport.
#}
{% filter inline %}
{% if transport in ['tcp', 'udp', 'http', 'websocket', 'shm'] %}true{% endif %}
{% endfilter %}
{% endmacro %}
