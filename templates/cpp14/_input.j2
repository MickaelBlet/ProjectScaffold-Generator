{% macro input(t=none) %}
{% from '_scalar.j2' import scalar as _scalar %}
{% from '_type.j2' import type as _type %}
{#
  Type of a value read only: `T` for scalars, else `const T&`. Parameter: t.
#}
{% set scalar -%}
  {{- _scalar(t=t) -}}
{%- endset -%}
{%- if scalar == 'true' -%}
  {{- _type(t=t) -}}
{%- else -%}
  {{- 'const ' -}}
  {{- _type(t=t) -}}
  {{- '&' -}}
{%- endif %}
{%+ endmacro %}
