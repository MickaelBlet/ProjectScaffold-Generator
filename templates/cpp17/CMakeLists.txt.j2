{#
  Generates CMakeLists.txt: one library for the whole project (INTERFACE when it has no .cpp file), its
  dependencies on other projects, the platform libraries of the remote transports, and one executable per
  system.
  Rendered once (manifest.yaml).
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    project: {name: Relay, ident: Relay}
    generator: {name: scaffold-gen}
    files: [include/relay/ports.hpp, src/Caller.cpp, src/client/main.cpp, ...]
    remoteLinks: [{index: 0, link: {name: echo_tcp, ...}}, ...]
    dependencies: [{name: Common, file: common.scaffold.yaml}]
    modules: [{entity: module, name: Caller, ...}, ...]
    systems: [{name: ClientSystem, binary: {name: Client}}, {name: ServerSystem, binary: {name: Server}}]
#}
{% from '_main_path.j2' import main_path as _main_path %}
{% set state = namespace() %}
# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.
{% set library = project.ident|snake %}
cmake_minimum_required(VERSION 3.16)
project({{ library }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

{% filter user('options') +%}
{% endfilter +%}

{# `files` lists the paths generated before this one: the library sources are its .cpp files. #}
{% set state.cpp_file_count = 0 %}
{% for generated_file in files %}
{% if '.cpp' in generated_file %}
{% set state.cpp_file_count = (state.cpp_file_count + 1) %}
{% endif %}
{% endfor %}
{% if state.cpp_file_count > 0 %}
add_library({{ library }}
{% for generated_file in files %}
{% if '.cpp' in generated_file %}
    {{ generated_file }}
{% endif %}
{% endfor %}
)
set(SCAFFOLD_SCOPE PUBLIC)
{% else %}
add_library({{ library }} INTERFACE)
set(SCAFFOLD_SCOPE INTERFACE)
{% endif %}
target_include_directories({{ library }} ${SCAFFOLD_SCOPE} ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features({{ library }} ${SCAFFOLD_SCOPE} cxx_std_17)

{# The generated transports need threads, and POSIX shared memory (rt) on Linux. #}
{% if remoteLinks|length > 0 %}
# Transports of the links between binaries (src/remote/transport.cpp).
find_package(Threads REQUIRED)
target_link_libraries({{ library }} ${SCAFFOLD_SCOPE} Threads::Threads)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries({{ library }} ${SCAFFOLD_SCOPE} rt)
endif()

{% endif %}
{% filter user('dependencies') +%}
{% for dependency in dependencies %}
{% set dependency_name = dependency.name|snake %}
if(NOT TARGET {{ dependency_name }} AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/../{{ dependency_name }}/CMakeLists.txt)
    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../{{ dependency_name }} ${CMAKE_CURRENT_BINARY_DIR}/{{ dependency_name }})
endif()
if(TARGET {{ dependency_name }})
    target_link_libraries({{ library }} ${SCAFFOLD_SCOPE} {{ dependency_name }})
else()
    message(WARNING "dependency {{ dependency.name }} ({{ dependency.file }}) not found: generate it in ../{{ dependency_name }}")
endif()
{% endfor %}
{% endfilter +%}
{# One executable per system (binary), built from its main.cpp. #}
{% if modules|length > 0 %}
{% for system in systems %}
{% if system.binary %}
{% set executable = (library ~ '_' ~ system.binary.name)|snake %}
{% else %}
{% set executable = library ~ '_app' %}
{% endif %}

add_executable({{ executable }} src/{{ _main_path(system=system) }})
target_link_libraries({{ executable }} PRIVATE {{ library }})
{% endfor %}
{% endif %}

{% filter user('end') +%}
{% endfilter +%}
