{#
  Name of the accessor of a child module: its name in lower camel case, `Module` appended when that is a
  C++ keyword. Its data member is the accessor followed by `_`.
  Parameters:
    name: the child's name in the model.
  Examples:
    name: Sensor   -> sensor
    name: Operator -> operatorModule
#}
{% macro accessor(name=none) %}
{% from '_lcfirst.j2' import lcfirst as _lcfirst %}
{% set accessor_name = _lcfirst(name=name) %}
{% filter inline %}
{{ accessor_name }}{% if accessor_name in generator.reserved %}Module{% endif %}
{% endfilter %}
{% endmacro %}
