{% macro address_variable(remote_link=none, side=none) %}
{#
  Environment variable overriding the address of a link between binaries: the project and link names in
  upper case, `_LISTEN` appended on the server side.
  Parameters:
    remote_link: an entry of `remoteLinks` (`link.name`).
    side: 'client' or 'server'.
  Example (project Rover):
    remote_link: {link: {name: supervise_camera}}
    side: server  -> ROVER_SUPERVISE_CAMERA_LISTEN
#}
{% filter inline %}
{{ (project.name|underscore_normalize|constant ~ '_' ~ remote_link.link.name)|constant }}{% if side == 'server' %}_LISTEN{% endif %}
{% endfilter %}
{% endmacro %}
