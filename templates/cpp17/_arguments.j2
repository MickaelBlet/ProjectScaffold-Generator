{% macro arguments(parameter_list=none) %}
{% from '_identifier.j2' import identifier as _identifier %}
{#
  Arguments passing a method's parameters on to another call, by name.
  Parameters:
    parameter_list: the `params` of a message or method (each with `name`).
  Example:
    parameter_list: [{name: pose, ...}, {name: tags, ...}]  -> pose, tags
#}
{% filter inline %}
{% for parameter in parameter_list %}
  {{ _identifier(name=parameter.name) }}{% if not loop.last %}, {% endif %}
{% endfor %}
{% endfilter %}
{% endmacro %}
