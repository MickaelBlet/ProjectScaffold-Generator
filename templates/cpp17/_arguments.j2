{#
  Arguments passing a method's parameters on to another call, by name.
  Parameters:
    parameters: the `params` of a message (Interface.messages[]) or method (Module.methods[]), each
      with `name`.
  Example:
    parameters: [{name: pose, ...}, {name: tags, ...}]  -> pose, tags
#}
{% macro arguments(parameters=none) %}
{% from '_identifier.j2' import identifier as _identifier %}
{% filter inline %}
{% for parameter in parameters %}
  {{ _identifier(name=parameter.name) }}{% if not loop.last %}, {% endif %}
{% endfor %}
{% endfilter %}
{% endmacro %}
