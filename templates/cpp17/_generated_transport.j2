{% macro generated_transport(transport=none) %}
{#
  `true` for a transport implemented by transport.cpp / transport.py (tcp, udp, http, websocket, shm),
  empty for the others (written by the user).
  Parameters:
    transport: a link's `constraints.remote.transport` (links[].constraints.remote.transport).
  Example:
    transport: tcp   -> true
    transport: mqtt  -> (empty)
#}
{% filter inline %}
{% if transport in ['tcp', 'udp', 'http', 'websocket', 'shm'] %}true{% endif %}
{% endfilter %}
{% endmacro %}
