{% macro header(entity=none) %}
{% from '_name.j2' import name as _name %}
{#
  Header of an entity, relative to `include/`: `<project>/types/`, `<project>/interfaces/`, the module's
  namespace path for modules, the module's path for a type of a module; a dependency's own directory for
  its types and interfaces.
  Parameters:
    entity: a type, interface, module or system, or `constantsFile` (`entity`, `name`, `dependency`, `scope`,
      `namespace`).
  Examples (project Robot):
    entity: {entity: type, name: Pose, dependency: null, scope: []}       -> robot/types/Pose.hpp
    entity: {entity: type, name: Mode, dependency: null, scope: [Core, Sensor]} -> robot/core/sensor/Mode.hpp
    entity: {entity: module, name: Sensor, namespace: [Core]}             -> robot/core/Sensor.hpp
#}
{% set project_directory = project.name|as_identifier|snake %}
{% filter inline %}
{% if entity.entity == 'type' or entity.entity == 'interface' %}
  {{ entity.dependency|snake if entity.dependency else project_directory }}
  {% if entity.entity == 'type' and entity.scope|length > 0 %}
    {# A type of a module: beside the content of the module. #}
    {% for part in entity.scope %}/{{ part|snake }}{% endfor %}/
  {% elif entity.entity == 'type' %}
    /types/
  {% else %}
    /interfaces/
  {% endif %}
  {{ _name(entity=entity) }}
{% elif entity.entity == 'module' %}
  {{ project_directory }}{% for parent in entity.namespace %}/{{ parent|snake }}{% endfor %}/{{ entity.name }}
{% else %}
  {{ project_directory }}/{{ entity.name }}
{% endif %}
.hpp
{% endfilter %}
{% endmacro %}
