{% macro includes(entity=none) %}
{% from '_header.j2' import header as _header %}
{% set state = namespace() %}
{#
  `#include` lines of an entity: the standard headers of the primitives and containers it uses, then
  the headers of the user types, interfaces, base modules, child modules it uses, each once, sorted,
  without its own header.
  Parameters:
    entity: a type, interface, module or system (`uses.builtins`, `uses.types`; for a module `bases`,
      `ports` with their `interface` and `role`; for a module or system `instances`).
  Example (project Plant):
    entity:
      entity: type
      name: Reading
      uses: {builtins: [float64, map, string], types: [{entity: type, name: State, scope: []}]}
    -> #include <cstdint>  #include <map>  #include <string>  #include <plant_demo/types/State.hpp>
       (one per line)
#}
{% set project_directory = project.name|as_identifier|snake %}
{% set state.standard_headers = [] %}
{% set state.project_headers = [] %}
{% for builtin in entity.uses.builtins %}
  {% if builtin in ['int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64'] %}
    {% set state.standard_headers = state.standard_headers + ['<cstdint>'] %}
  {% elif builtin == 'bytes' %}
    {% set state.standard_headers = state.standard_headers + ['<cstdint>', '<vector>'] %}
  {% elif builtin in ['string', 'array', 'vector', 'list', 'set', 'optional', 'map'] %}
    {% set state.standard_headers = state.standard_headers + ['<' ~ builtin ~ '>'] %}
  {% elif builtin == 'variant' %}
    {% set state.standard_headers = state.standard_headers + ['<utility>', '<variant>'] %}
  {% elif builtin == 'exception' %}
    {% set state.standard_headers = state.standard_headers + ['<exception>'] %}
  {% endif %}
{% endfor %}
{% for type_definition in entity.uses.types %}
  {% set state.project_headers = state.project_headers + ['<' ~ _header(entity=type_definition) ~ '>'] %}
{% endfor %}
{% if entity.entity == 'module' %}
  {% for base in entity.bases %}
    {% set state.project_headers = state.project_headers + ['<' ~ _header(entity=base) ~ '>'] %}
  {% endfor %}
  {% for port in entity.ports %}
    {% if port.interface %}
      {% set state.project_headers = state.project_headers + ['<' ~ _header(entity=port.interface) ~ '>'] %}
      {% if port.role == 'out' %}
        {% set state.project_headers = state.project_headers + ['<' ~ project_directory ~ '/ports.hpp>'] %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if entity.entity == 'module' or entity.entity == 'system' %}
  {% for instance in entity.instances %}
    {% set state.project_headers = state.project_headers + ['<' ~ _header(entity=instance) ~ '>'] %}
    {% if instance.abstract %}
      {% set state.standard_headers = state.standard_headers + ['<memory>'] %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set own_header = '<' ~ _header(entity=entity) ~ '>' %}
{% set state.standard_headers = state.standard_headers|unique|list|sort %}
{% set state.project_headers = state.project_headers|unique|list|sort %}
{% for header in state.standard_headers %}
#include {{ header }}
{% endfor %}
{% for header in state.project_headers %}
{% if header != own_header %}
#include {{ header }}
{% endif %}
{% endfor %}
{%+ endmacro %}
