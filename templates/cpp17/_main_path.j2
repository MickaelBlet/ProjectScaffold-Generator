{#
  Source file of the `main` of a system, relative to `src/`: in the directory of its binary when the
  project has binaries.
  Parameters:
    system: an entry of `systems` (`binary`: none, or the binary with its `name`).
  Examples:
    system: {binary: null}            -> main.cpp
    system: {binary: {name: Onboard}} -> onboard/main.cpp
#}
{% macro main_path(system=none) %}
{% from '_snake.j2' import snake as _snake %}
{% filter inline %}
{% if system.binary %}{{ _snake(name=system.binary.name) }}/{% endif %}main.cpp
{% endfilter %}
{% endmacro %}
