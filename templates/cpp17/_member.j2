{#
  C++ data member holding an attribute or an out port: the name followed by `_` (`Member_` for C++
  keywords).
  Parameters:
    name: the attribute's or port's name.
  Examples:
    name: rateHz  -> rateHz_
    name: class   -> classMember_
#}
{% macro member(name=none) %}
{% filter inline %}
{{ name }}{% if name in generator.reserved %}Member{% endif %}_
{% endfilter %}
{% endmacro %}
