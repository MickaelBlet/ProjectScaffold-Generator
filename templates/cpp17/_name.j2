{% macro name(entity=none) %}
{% from '_identifier.j2' import identifier as _identifier %}
{#
  C++ class name of an entity: interfaces get an `I` prefix; the others their name as an identifier.
  Parameters:
    entity: a type, interface, module or system (`entity`, `name`).
  Examples:
    entity: {entity: interface, name: Lifecycle} -> ILifecycle
    entity: {entity: type, name: Reading}        -> Reading
#}
{% filter inline %}
{% if entity.entity == 'interface' %}I{{ entity.name }}{% else %}{{ _identifier(name=entity.name) }}{% endif %}
{% endfilter %}
{% endmacro %}
