{% macro py_encode(type_reference=none, expression=none, writer=none, prefix=none) %}
{% from '_py_encoder.j2' import py_encoder as _py_encoder %}
{#
  Python statement encoding a value with a wire.py `Writer`; bounds passed last.
  Parameters:
    type_reference: a TypeRef (schema $defs/TypeRef): `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
    expression: the Python expression of the value.
    writer: the Python expression of the writer (`w`).
    prefix: `data.` outside data.py, else ''.
  Example:
    type_reference: {kind: vector, max: null, of: {kind: ref, name: Vec3}}
    expression: v.path
    writer: w
    prefix: data.
    -> w.seq(v.path, data.encode_Vec3)
#}
{% filter inline %}
{% if type_reference.kind == 'primitive' %}
  {{ writer }}.{{ type_reference.name }}({{ expression }}{% if type_reference.max is not none %}, {{ type_reference.max }}{% endif %})
{% elif type_reference.kind == 'ref' %}
  {{ prefix }}encode_{{ type_reference.name }}({{ writer }}, {{ expression }})
{% elif type_reference.kind == 'array' %}
  {{ writer }}.array({{ expression }}, {{ type_reference.size }}, {{ _py_encoder(type_reference=type_reference.of, prefix=prefix) }})
{% elif type_reference.kind == 'optional' %}
  {{ writer }}.optional({{ expression }}, {{ _py_encoder(type_reference=type_reference.of, prefix=prefix) }})
{% elif type_reference.kind == 'map' %}
  {{ writer }}.map({{ expression }}, {{ _py_encoder(type_reference=type_reference.key, prefix=prefix) }}, {{ _py_encoder(type_reference=type_reference.value, prefix=prefix) }}{% if type_reference.max is not none %}, {{ type_reference.max }}{% endif %})
{% else %}
  {{ writer }}.seq({{ expression }}, {{ _py_encoder(type_reference=type_reference.of, prefix=prefix) }}{% if type_reference.max is not none %}, {{ type_reference.max }}{% endif %})
{% endif %}
{% endfilter %}
{% endmacro %}
