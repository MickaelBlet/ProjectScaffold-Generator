{% macro py_identifier(name=none) %}
{#
  A name of the model as a Python identifier: Python keywords (and `self`) get a trailing `_`.
  Parameters:
    name: a name of the model.
  Examples:
    name: speed  -> speed
    name: from   -> from_
#}
{% set keywords = 'False None True and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return self try while with yield'|split(' ')|list %}
{% filter inline %}
{{ name }}{% if name in keywords %}_{% endif %}
{% endfilter %}
{% endmacro %}
