{#
  What a message gives back in Python: its return value then its out / inout parameters, as a tuple when
  there are several.
  Parameters:
    message: a message of an Interface (Interface.messages[]: `returns`: type reference or none; `outputs`: out / inout params).
    what: 'hint' (type hint), 'names' (`_v0, _v1`...), 'zero' (default values, inout parameters
      unchanged).
    prefix: `data.` outside data.py, else ''.
  Example:
    message:
      returns: {kind: primitive, name: bool}
      outputs: [{name: position, direction: out, type: {kind: ref, name: Pose, flatName: Pose, scope: []}}]
    what: hint  -> Tuple[bool, data.Pose]
    what: names -> _v0, _v1
    what: zero  -> False, data.Pose()
#}
{% macro py_results(message=none, what=none, prefix=none) %}
{% from '_py_identifier.j2' import py_identifier as _py_identifier %}
{% from '_py_type.j2' import py_type as _py_type %}
{% from '_py_zero.j2' import py_zero as _py_zero %}
{% set result_count = message.outputs|length + (1 if message.returns else 0) %}
{% filter inline %}
{% if what == 'hint' %}
  {% if result_count == 0 %}None{% elif result_count > 1 %}Tuple[{% endif %}
  {% if message.returns %}
    {{ _py_type(type_reference=message.returns, prefix=prefix) }}{% if message.outputs|length > 0 %}, {% endif %}
  {% endif %}
  {% for parameter in message.outputs %}
    {{ _py_type(type_reference=parameter.type, prefix=prefix) }}{% if not loop.last %}, {% endif %}
  {% endfor %}
  {% if result_count > 1 %}]{% endif %}
{% elif what == 'names' %}
  {% for index in range(result_count) %}_v{{ index }}{% if not loop.last %}, {% endif %}{% endfor %}
{% elif what == 'zero' %}
  {% if message.returns %}
    {{ _py_zero(type_reference=message.returns, prefix=prefix) }}{% if message.outputs|length > 0 %}, {% endif %}
  {% endif %}
  {% for parameter in message.outputs %}
    {% if parameter.direction == 'inout' %}
      {{ _py_identifier(name=parameter.name) }}
    {% else %}
      {{ _py_zero(type_reference=parameter.type, prefix=prefix) }}
    {% endif %}
    {% if not loop.last %}, {% endif %}
  {% endfor %}
{% endif %}
{% endfilter %}
{% endmacro %}
