{#
  Python type hint of a type reference; aliases spelled as the type they stand for, custom primitives
  as `Any`; `None` for no type.
  Parameters:
    type_reference: a TypeRef (schema $defs/TypeRef): `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
      Or none.
    prefix: `data.` outside data.py, else ''.
  Example:
    type_reference: {kind: map, key: {kind: primitive, name: string}, value: {kind: vector, of: {kind: ref, name: Pose, flatName: Pose, scope: []}}}
    prefix: data.
    -> Dict[str, List[data.Pose]]
#}
{% macro py_type(type_reference=none, prefix=none) %}
{% from '_py_reference.j2' import py_reference as _py_reference %}
{% filter inline %}
{% if type_reference == none %}
  None
{% elif type_reference.kind == 'primitive' %}
  {% if type_reference.name == 'bool' %}
    bool
  {% elif type_reference.name == 'char' or type_reference.name == 'string' %}
    str
  {% elif type_reference.name == 'float32' or type_reference.name == 'float64' %}
    float
  {% elif type_reference.name == 'bytes' %}
    bytes
  {% else %}
    int
  {% endif %}
{% elif type_reference.kind == 'ref' %}
  {% set type_definition = typeByKey[type_reference.key] %}
  {% if type_definition.kind == 'alias' %}
    {{ py_type(type_reference=type_definition.type, prefix=prefix) }}
  {% elif type_definition.kind == 'primitive' %}
    Any
  {% else %}
    {{ _py_reference(type_reference=type_reference, prefix=prefix) }}
  {% endif %}
{% elif type_reference.kind == 'optional' %}
  Optional[{{ py_type(type_reference=type_reference.of, prefix=prefix) }}]
{% elif type_reference.kind == 'set' %}
  Set[{{ py_type(type_reference=type_reference.of, prefix=prefix) }}]
{% elif type_reference.kind == 'map' %}
  Dict[{{ py_type(type_reference=type_reference.key, prefix=prefix) }}, {{ py_type(type_reference=type_reference.value, prefix=prefix) }}]
{% else %}
  List[{{ py_type(type_reference=type_reference.of, prefix=prefix) }}]
{% endif %}
{% endfilter %}
{% endmacro %}
