{% macro py_zero(type_reference=none, prefix=none) %}
{% from '_py_identifier.j2' import py_identifier as _py_identifier %}
{% from '_py_reference.j2' import py_reference as _py_reference %}
{#
  Python expression of the default value of a type: what C++ value-initializes it to (an enum gets its
  first value, a struct its defaults, an array its size of elements); `None` for no type.
  Parameters:
    type_reference: a TypeRef (schema $defs/TypeRef): `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
      Or none.
    prefix: `data.` outside data.py, else ''.
  Examples (prefix: data.):
    type_reference: {kind: primitive, name: float64}                   -> 0.0
    type_reference: {kind: array, size: 3, of: {kind: primitive, name: int8}} -> [0 for _ in range(3)]
    type_reference: {kind: ref, name: Pose, key: Pose, flatName: Pose, scope: []} (a struct) -> data.Pose()
#}
{% filter inline %}
{% if type_reference == none %}
  None
{% elif type_reference.kind == 'primitive' %}
  {% if type_reference.name == 'bool' %}
    False
  {% elif type_reference.name == 'char' %}
    '\0'
  {% elif type_reference.name == 'string' %}
    ''
  {% elif type_reference.name == 'bytes' %}
    b''
  {% elif type_reference.name == 'float32' or type_reference.name == 'float64' %}
    0.0
  {% else %}
    0
  {% endif %}
{% elif type_reference.kind == 'ref' %}
  {% set type_definition = typeByKey[type_reference.key] %}
  {% if type_definition.kind == 'struct' or type_definition.kind == 'union' %}
    {{ _py_reference(type_reference=type_reference, prefix=prefix) }}()
  {% elif type_definition.kind == 'enum' %}
    {% if type_definition['values']|length > 0 %}
      {{ _py_reference(type_reference=type_reference, prefix=prefix) }}.{{ _py_identifier(name=type_definition['values'][0].name) }}
    {% else %}
      0
    {% endif %}
  {% elif type_definition.kind == 'bitmask' %}
    {{ _py_reference(type_reference=type_reference, prefix=prefix) }}(0)
  {% elif type_definition.kind == 'alias' %}
    {{ py_zero(type_reference=type_definition.type, prefix=prefix) }}
  {% else %}
    None
  {% endif %}
{% elif type_reference.kind == 'optional' %}
  None
{% elif type_reference.kind == 'set' %}
  set()
{% elif type_reference.kind == 'map' %}
  {}
{% elif type_reference.kind == 'array' %}
  [{{ py_zero(type_reference=type_reference.of, prefix=prefix) }} for _ in range({{ type_reference.size }})]
{% else %}
  []
{% endif %}
{% endfilter %}
{% endmacro %}
