{#
  `true` for a type cheap to copy, passed and returned by value: numbers, bool, char, enums, bitmasks,
  aliases of those; empty for the others.
  Parameters:
    type_reference: a TypeRef (schema $defs/TypeRef): `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
  Examples:
    type_reference: {kind: primitive, name: uint32}  -> true
    type_reference: {kind: primitive, name: string}  -> (empty)
    type_reference: {kind: ref, name: State, key: State, typeKind: enum} -> true
#}
{% macro scalar(type_reference=none) %}
{% filter inline %}
{% if type_reference.kind == 'primitive' %}
  {% if not (type_reference.name == 'string' or type_reference.name == 'bytes') %}true{% endif %}
{% elif type_reference.kind == 'ref' %}
  {% set type_definition = typeByKey[type_reference.key] %}
  {% if type_definition.kind == 'enum' or type_definition.kind == 'bitmask' %}
    true
  {% elif type_definition.kind == 'alias' %}
    {{ scalar(type_reference=type_definition.type) }}
  {% endif %}
{% endif %}
{% endfilter %}
{% endmacro %}
