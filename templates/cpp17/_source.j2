{#
  Source file of a module or the system, relative to `src/`: in the directories of the module's
  namespace.
  Parameters:
    entity: a module (`name`, `namespace`) or a system (`name`).
  Example:
    entity: {entity: module, name: Sensor, namespace: [Core]}  -> core/Sensor.cpp
#}
{% macro source(entity=none) %}
{% from '_snake.j2' import snake as _snake %}
{% filter inline %}
{% if entity.entity == 'module' %}{% for parent in entity.namespace %}{{ _snake(name=parent) }}/{% endfor %}{% endif %}
{{ entity.name }}.cpp
{% endfilter %}
{% endmacro %}
