{% macro type(type_reference=none) %}
{% from '_identifier.j2' import identifier as _identifier %}
{% from '_primitive.j2' import primitive as _primitive %}
{#
  C++ spelling of a type reference; `void` for no type. A user type is fully qualified: its project's
  namespace, then the path of its module for a type of a module.
  Parameters:
    type_reference: a type reference of the model: `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
      Or none.
  Examples (project Robot):
    type_reference: {kind: map, key: {kind: primitive, name: string}, value: {kind: ref, name: Pose, dependency: Common, scope: []}}
      -> std::map<std::string, ::common::Pose>
    type_reference: {kind: ref, name: Mode, dependency: null, scope: [Core, Sensor]}
      -> ::robot::core::sensor::Mode
#}
{% filter inline %}
{% if type_reference == none %}
  void
{% elif type_reference.kind == 'primitive' %}
  {{ _primitive(name=type_reference.name) }}
{% elif type_reference.kind == 'ref' %}
  ::{{ (type_reference.dependency or project.name|as_identifier)|snake }}
  {% for part in type_reference.scope %}::{{ part|snake }}{% endfor %}
  ::{{ _identifier(name=type_reference.name) }}
{% elif type_reference.kind == 'array' %}
  std::array<{{ type(type_reference=type_reference.of) }}, {{ type_reference.size }}>
{% elif type_reference.kind == 'map' %}
  std::map<{{ type(type_reference=type_reference.key) }}, {{ type(type_reference=type_reference.value) }}>
{% else %}
  std::{{ type_reference.kind }}<{{ type(type_reference=type_reference.of) }}>
{% endif %}
{% endfilter %}
{% endmacro %}
