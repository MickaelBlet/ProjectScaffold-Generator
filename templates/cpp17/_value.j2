{% macro value(v=none, t=none) %}
{% from '_id.j2' import id as _id %}
{% from '_type.j2' import type as _type %}
{% set ns = namespace() %}
{#
  C++ literal of a default value of the model (as in the YAML file) of type t.
  Parameters: v, t.
#}
{% filter inline %}
{% if t.kind == 'primitive' %}
  {% if t.name == 'bool' %}
    {% if v == true or v == 'true' %}true{% else %}false{% endif %}
  {% elif t.name == 'char' %}
    '{{ v|replace('\\', '\\\\')|replace("'", "\\'") }}'
  {% elif t.name == 'string' %}
    "{{ v|replace('\\', '\\\\')|replace('"', '\\"')|replace('\n', '\\n')|replace('\t', '\\t') }}"
  {% elif t.name == 'bytes' %}
    {# The text's characters, one byte each. #}
    {
    {% for ch in v|split('')|select %}
      '{{ ch|replace('\\', '\\\\')|replace("'", "\\'") }}'{% if not loop.last %}, {% endif %}
    {% endfor %}
    }
  {% elif t.name == 'float32' or t.name == 'float64' %}
    {% set number = v ~ '' %}
    {{ number }}
    {% if not ('.' in number or 'e' in number) %}.0{% endif %}
    {% if t.name == 'float32' %}f{% endif %}
  {% elif t.name == 'int64' %}
    {{ v }}LL
  {% elif t.name == 'uint64' %}
    {{ v }}ULL
  {% elif t.name == 'uint32' %}
    {{ v }}U
  {% else %}
    {{ v }}
  {% endif %}
{% elif t.kind == 'optional' %}
  {% if v == none %}std::nullopt{% else %}{{ value(v=v, t=t.of) }}{% endif %}
{% elif t.kind == 'array' or t.kind == 'vector' or t.kind == 'list' or t.kind == 'set' %}
  {
  {% for item in v %}
    {{ value(v=item, t=t.of) }}{% if not loop.last %}, {% endif %}
  {% endfor %}
  }
{% elif t.kind == 'map' %}
  {
  {% for entry in v.items() %}
    { {{- value(v=entry[0], t=t.key) }}, {{ value(v=entry[1], t=t.value) -}} }
    {% if not loop.last %}, {% endif %}
  {% endfor %}
  }
{% elif t.kind == 'ref' %}
  {% set def = typeByKey[t.key] %}
  {% if def.kind == 'enum' %}
    {{ _type(t=t) }}::{{ _id(name=v) }}
  {% elif def.kind == 'bitmask' %}
    {# The flags of the list, or no flag. #}
    {% if v|length == 0 %}{{ _type(t=t) }}{}{% endif %}
    {% for flag in v %}
      {{ _type(t=t) }}::{{ _id(name=flag) }}{% if not loop.last %} | {% endif %}
    {% endfor %}
  {% elif def.kind == 'union' %}
    {# The case of the one-entry mapping, set by a lambda. #}
    {% for entry in v.items() %}
      {% set ns.c = def.cases|selectattr('name', 'equalto', entry[0])|first %}
      [] { {{ _type(t=t) }} u; u.{{ _id(name=ns.c.name) }}({{ value(v=entry[1], t=ns.c.type) }}); return u; }()
    {% endfor %}
  {% elif def.kind == 'alias' %}
    {{ value(v=v, t=def.type) }}
  {% elif def.kind == 'struct' %}
    {# Fields in order: the value's, else the field's default, else value-initialized. #}
    {{ _type(t=t) }}{
    {% for f in def.fields %}
      {% if f.name in v %}
        {{ value(v=v[f.name], t=f.type) }}
      {% elif f.hasDefault %}
        {{ value(v=f.default, t=f.type) }}
      {% else %}
        {}
      {% endif %}
      {% if not loop.last %}, {% endif %}
    {% endfor %}
    }
  {% else %}
    {# Custom primitive: the value is written as it is (a string is a C++ expression). #}
    {{ v }}
  {% endif %}
{% endif %}
{% endfilter %}
{% endmacro %}
