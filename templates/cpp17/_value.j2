{% macro value(model_value=none, type_reference=none) %}
{% from '_identifier.j2' import identifier as _identifier %}
{% from '_type.j2' import type as _type %}
{% set state = namespace() %}
{#
  C++ literal of a value of the model (a default value or a constant, as written in the YAML file) of a
  given type: enums by enumerator, bitmasks as or-ed flags, unions through a lambda setting their case,
  structs as braced lists of all their fields (the value's, else the field's default, else `{}`).
  Parameters:
    model_value: a value as read from the project file: a field's or attribute's `default`, a Constant's
      `value` (number, string, list, mapping).
    type_reference: a TypeRef (schema $defs/TypeRef): `kind` primitive (`name`, bound `max`), ref (a user
      type: `key`, `name`, `typeKind`, `dependency`, `scope`, `flatName`), optional / vector / list / set
      (`of`, `max`), array (`of`, `size`), map (`key`, `value`, `max`).
  Examples (project Plant):
    model_value: 1.5, type_reference: {kind: primitive, name: float64}  -> 1.5
    model_value: On, type_reference: {kind: ref, name: State, key: State, typeKind: enum, scope: []}
      -> ::plant_demo::State::On
    model_value: {a: 1}, type_reference: {kind: map, key: {kind: primitive, name: string}, value: {kind: primitive, name: int32}}
      -> { {"a", 1} }
#}
{% filter inline %}
{% if type_reference.kind == 'primitive' %}
  {% if type_reference.name == 'bool' %}
    {% if model_value == true or model_value == 'true' %}true{% else %}false{% endif %}
  {% elif type_reference.name == 'char' %}
    '{{ model_value|replace('\\', '\\\\')|replace("'", "\\'") }}'
  {% elif type_reference.name == 'string' %}
    "{{ model_value|replace('\\', '\\\\')|replace('"', '\\"')|replace('\n', '\\n')|replace('\t', '\\t') }}"
  {% elif type_reference.name == 'bytes' %}
    {# The text's characters, one byte each. #}
    {
    {% for character in model_value|split('')|select %}
      '{{ character|replace('\\', '\\\\')|replace("'", "\\'") }}'{% if not loop.last %}, {% endif %}
    {% endfor %}
    }
  {% elif type_reference.name == 'float32' or type_reference.name == 'float64' %}
    {% set number = model_value ~ '' %}
    {{ number }}
    {% if not ('.' in number or 'e' in number) %}.0{% endif %}
    {% if type_reference.name == 'float32' %}f{% endif %}
  {% elif type_reference.name == 'int64' %}
    {{ model_value }}LL
  {% elif type_reference.name == 'uint64' %}
    {{ model_value }}ULL
  {% elif type_reference.name == 'uint32' %}
    {{ model_value }}U
  {% else %}
    {{ model_value }}
  {% endif %}
{% elif type_reference.kind == 'optional' %}
  {% if model_value == none %}std::nullopt{% else %}{{ value(model_value=model_value, type_reference=type_reference.of) }}{% endif %}
{% elif type_reference.kind == 'array' or type_reference.kind == 'vector' or type_reference.kind == 'list' or type_reference.kind == 'set' %}
  {
  {% for item in model_value %}
    {{ value(model_value=item, type_reference=type_reference.of) }}{% if not loop.last %}, {% endif %}
  {% endfor %}
  }
{% elif type_reference.kind == 'map' %}
  {
  {% for entry in model_value.items() %}
    { {{- value(model_value=entry[0], type_reference=type_reference.key) }}, {{ value(model_value=entry[1], type_reference=type_reference.value) -}} }
    {% if not loop.last %}, {% endif %}
  {% endfor %}
  }
{% elif type_reference.kind == 'ref' %}
  {% set type_definition = typeByKey[type_reference.key] %}
  {% if type_definition.kind == 'enum' %}
    {{ _type(type_reference=type_reference) }}::{{ _identifier(name=model_value) }}
  {% elif type_definition.kind == 'bitmask' %}
    {# The flags of the list, or no flag. #}
    {% if model_value|length == 0 %}{{ _type(type_reference=type_reference) }}{}{% endif %}
    {% for flag in model_value %}
      {{ _type(type_reference=type_reference) }}::{{ _identifier(name=flag) }}{% if not loop.last %} | {% endif %}
    {% endfor %}
  {% elif type_definition.kind == 'union' %}
    {# The case of the one-entry mapping, set by a lambda. #}
    {% for entry in model_value.items() %}
      {% set state.case = type_definition.cases|selectattr('name', 'equalto', entry[0])|first %}
      [] { {{ _type(type_reference=type_reference) }} u; u.{{ _identifier(name=state.case.name) }}({{ value(model_value=entry[1], type_reference=state.case.type) }}); return u; }()
    {% endfor %}
  {% elif type_definition.kind == 'alias' %}
    {{ value(model_value=model_value, type_reference=type_definition.type) }}
  {% elif type_definition.kind == 'struct' %}
    {# Fields in order: the value's, else the field's default, else value-initialized. #}
    {{ _type(type_reference=type_reference) }}{
    {% for field in type_definition.fields %}
      {% if field.name in model_value %}
        {{ value(model_value=model_value[field.name], type_reference=field.type) }}
      {% elif field.hasDefault %}
        {{ value(model_value=field.default, type_reference=field.type) }}
      {% else %}
        {}
      {% endif %}
      {% if not loop.last %}, {% endif %}
    {% endfor %}
    }
  {% else %}
    {# Custom primitive: the value is written as it is (a string is a C++ expression). #}
    {{ model_value }}
  {% endif %}
{% endif %}
{% endfilter %}
{% endmacro %}
