/// A call to an active module failed: its queue was full (overflow `error`, or `drop` for a call waiting
/// for its result), or its result did not come within the module's timeout.
class ActiveError : public std::runtime_error {
public:
    using std::runtime_error::runtime_error;
};

namespace detail {
/// A call waiting for its result: shared by the caller and the queued job (one allocation per call), freed
/// by the last of them.
template <class F, class Result>
class ActiveCall {
public:
    explicit ActiveCall(F f) : f_(std::move(f)) {}

    /// On the thread: runs `f` unless the caller gave up, then lets go of the job's share.
    void run()
    {
        int expected = 0;
        if (state_.compare_exchange_strong(expected, 1)) {
            try {
                if constexpr (std::is_void_v<Result>)
                    f_();
                else
                    result_.emplace(f_());
            } catch (...) {
                error_ = std::current_exception();
            }
            {
                const std::lock_guard<std::mutex> lock(mutex_);
                done_ = true;
            }
            finished_.notify_all();
        }
        release();
    }

    /// False at `deadline` with no result.
    bool waitUntil(std::chrono::steady_clock::time_point deadline)
    {
        std::unique_lock<std::mutex> lock(mutex_);
        return finished_.wait_until(lock, deadline, [this] { return done_; });
    }

    void wait()
    {
        std::unique_lock<std::mutex> lock(mutex_);
        finished_.wait(lock, [this] { return done_; });
    }

    /// Before it has started: true when `f` will never run.
    bool giveUp()
    {
        int expected = 0;
        return state_.compare_exchange_strong(expected, 2);
    }

    Result get()
    {
        if (error_) std::rethrow_exception(error_);
        if constexpr (std::is_void_v<Result>)
            return;
        else
            return std::move(*result_);
    }

    void release()
    {
        if (shares_.fetch_sub(1, std::memory_order_acq_rel) == 1) delete this;
    }

private:
    using Stored = std::conditional_t<std::is_void_v<Result>, bool, Result>;

    F f_;
    // 0: queued, 1: running or done, 2: given up by the caller (then never run: `f` refers to its
    // arguments).
    std::atomic<int> state_{0};
    std::atomic<int> shares_{2}; // the caller's and the job's
    std::mutex mutex_;
    std::condition_variable finished_;
    bool done_ = false;
    std::optional<Stored> result_;
    std::exception_ptr error_;
};
} // namespace detail

/// Thread of an active module: runs the jobs queued by the adapters of its `in` ports, one at a time, in
/// their order. The destructor runs the jobs still queued, then joins the thread.
class ActiveQueue {
public:
    /// What a job reaching a full queue does: waits for room, is dropped, or fails (ActiveError).
    enum class Overflow { block, drop, error };

    ActiveQueue(std::size_t capacity, std::chrono::milliseconds timeout, Overflow overflow)
        : capacity_(capacity), timeout_(timeout), overflow_(overflow), thread_([this] { run(); })
    {
    }

    ~ActiveQueue()
    {
        {
            std::lock_guard<std::mutex> lock(mutex_);
            stopping_ = true;
        }
        ready_.notify_all();
        room_.notify_all();
        thread_.join();
    }

    ActiveQueue(const ActiveQueue&) = delete;
    ActiveQueue& operator=(const ActiveQueue&) = delete;

    /// Queues `job` and returns: a call without a result. Its exceptions are dropped.
    void post(std::function<void()> job)
    {
        if (!push(std::move(job), std::chrono::steady_clock::time_point::max()))
            if (overflow_ == Overflow::error) throw ActiveError("active module: queue full");
    }

    /// Runs `f` on the thread and returns its result, or rethrows its exception; throws ActiveError when
    /// the queue is full or `f` has not started within the timeout (once started, it is waited for).
    /// `f` runs at once when called from the thread itself.
    template <class F>
    auto call(F f) -> decltype(f())
    {
        if (onThread()) return f();
        using Call = detail::ActiveCall<F, decltype(f())>;
        Call* const slot = new Call(std::move(f));
        // The caller's share, let go of on return.
        const std::unique_ptr<Call, void (*)(Call*)> mine(slot, [](Call* c) { c->release(); });
        const auto deadline = std::chrono::steady_clock::now() + timeout_;
        bool queued = false;
        try {
            // A job of one pointer: no allocation of its own.
            queued = push([slot] { slot->run(); }, deadline);
        } catch (...) {
            slot->release(); // the job's share: never queued
            throw;
        }
        if (!queued) {
            slot->release();
            throw ActiveError("active module: queue full");
        }
        if (!slot->waitUntil(deadline)) {
            if (slot->giveUp()) throw ActiveError("active module: no result in time");
            slot->wait();
        }
        return slot->get();
    }

private:
    /// Queues `job`, waiting for room until `deadline` (overflow `block`); false when not queued. Jobs
    /// queued by the thread itself never wait. Throws ActiveError once the queue is stopping (the job
    /// would never run).
    bool push(std::function<void()> job, std::chrono::steady_clock::time_point deadline)
    {
        std::unique_lock<std::mutex> lock(mutex_);
        const auto room = [this] { return jobs_.size() < capacity_ || stopping_; };
        if (!onThread() && !room()) {
            if (overflow_ != Overflow::block) return false;
            ++blocked_;
            bool got = true;
            if (deadline == std::chrono::steady_clock::time_point::max())
                room_.wait(lock, room);
            else
                got = room_.wait_until(lock, deadline, room);
            --blocked_;
            if (!got) return false;
        }
        if (stopping_) throw ActiveError("active module: stopped");
        jobs_.push_back(std::move(job));
        lock.unlock();
        ready_.notify_one();
        return true;
    }

    bool onThread() const { return std::this_thread::get_id() == id_.load(std::memory_order_relaxed); }

    void run()
    {
        id_.store(std::this_thread::get_id(), std::memory_order_relaxed);
        for (;;) {
            std::function<void()> job;
            bool blocked;
            {
                std::unique_lock<std::mutex> lock(mutex_);
                ready_.wait(lock, [this] { return stopping_ || !jobs_.empty(); });
                if (jobs_.empty()) return;
                job = std::move(jobs_.front());
                jobs_.pop_front();
                blocked = blocked_ > 0;
            }
            if (blocked) room_.notify_one();
            try {
                job();
            } catch (...) {
                // A call without a result: nobody to tell.
            }
        }
    }

    const std::size_t capacity_;
    const std::chrono::milliseconds timeout_;
    const Overflow overflow_;
    std::mutex mutex_;
    std::condition_variable ready_;
    std::condition_variable room_;
    std::deque<std::function<void()>> jobs_;
    std::size_t blocked_ = 0; // callers waiting for room
    bool stopping_ = false;
    std::atomic<std::thread::id> id_{}; // of the thread, once it runs
    std::thread thread_; // last: started once the members above are made
};

} // namespace {{ _project_identifier() }}
