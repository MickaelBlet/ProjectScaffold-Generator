{% for t in remoteTypes %}
{% if t.kind == 'struct' or t.kind == 'exception' %}

inline void encode(Writer& w, const {{ _qualified(e=t) }}& v)
{
{% for f in t.fields %}
{% set ns.value = 'v.' ~ _id(name=f.name) %}
{% set ns.check = _bounds(t=f.type, v=ns.value, depth=0) %}
{% if ns.check != '' %}
    {{ ns.check }}
{% endif %}
    encode(w, {{ ns.value }});
{% else %}
    (void)w;
    (void)v;
{% endfor %}
}

inline void decode(Reader& r, {{ _qualified(e=t) }}& v)
{
{% for f in t.fields %}
{% set ns.value = 'v.' ~ _id(name=f.name) %}
{% set ns.check = _bounds(t=f.type, v=ns.value, depth=0) %}
{# Decoded, then checked. #}
    decode(r, {{ ns.value }});
{% if ns.check != '' %}
    {{ ns.check }}
{% endif %}
{% else %}
    (void)r;
    (void)v;
{% endfor %}
}
{% elif t.kind == 'union' %}
{% set ns.fallback = none %}
{% for c in t.cases %}
{% if c.isDefault %}
{% set ns.fallback = c %}
{% endif %}
{% endfor %}
{% set disc = _type(t=t.discriminator) %}
{# The discriminator, then the case it selects. #}

inline void encode(Writer& w, const {{ _qualified(e=t) }}& v)
{
    const {{ disc }} d = v._d();
    encode(w, d);
{% set ns.branch = 'if' %}
{% for c in t.cases %}
{% if c.labels|length > 0 %}
{% set ns.test = _labels(c=c, t=t.discriminator, d='d') %}
{% set ns.value = 'v.' ~ _id(name=c.name) ~ '()' %}
{% set ns.check = _bounds(t=c.type, v=ns.value, depth=0) %}
{# Its labels. #}
    {{ ns.branch }} ({{ ns.test }}) {
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
        encode(w, {{ ns.value }});
{% set ns.branch = '} else if' %}
{% endif %}
{% endfor %}
{% if ns.fallback %}
{% set ns.value = 'v.' ~ _id(name=ns.fallback.name) ~ '()' %}
{% set ns.check = _bounds(t=ns.fallback.type, v=ns.value, depth=0) %}
{% if ns.branch == 'if' %}
{% if ns.check != '' %}
    {{ ns.check }}
{% endif %}
    encode(w, {{ ns.value }});
{% else %}
    } else {
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
        encode(w, {{ ns.value }});
    }
{% endif %}
{% elif ns.branch != 'if' %}
    }
{% endif %}
}

inline void decode(Reader& r, {{ _qualified(e=t) }}& v)
{
    {{ disc }} d{};
    decode(r, d);
{% set ns.branch = 'if' %}
{% for c in t.cases %}
{% if c.labels|length > 0 %}
{% set ns.test = _labels(c=c, t=t.discriminator, d='d') %}
{% set ns.check = _bounds(t=c.type, v='x', depth=0) %}
{# Its labels. #}
    {{ ns.branch }} ({{ ns.test }}) {
        {{ _type(t=c.type) }} x{};
        decode(r, x);
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
        v.{{ _id(name=c.name) }}(std::move(x), d);
{% set ns.branch = '} else if' %}
{% endif %}
{% endfor %}
{% if ns.branch != 'if' %}
    } else {
{% endif %}
{% if ns.fallback %}
{% set ns.check = _bounds(t=ns.fallback.type, v='x', depth=0) %}
{# The default case. #}
        {{ _type(t=ns.fallback.type) }} x{};
        decode(r, x);
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
        v.{{ _id(name=ns.fallback.name) }}(std::move(x), d);
{% else %}
        v._default(d);
{% endif %}
{% if ns.branch != 'if' %}
    }
{% endif %}
}
