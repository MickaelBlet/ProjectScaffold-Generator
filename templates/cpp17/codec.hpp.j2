{#
  Generates include/<project>/remote/codec.hpp: encode()/decode() overloads of the user types that cross
  a link (struct, exception, union; custom primitives get a user section). Enums, bitmasks and aliases
  need none (see wire.hpp). Bounds (max length of strings, vectors, maps) are checked around each member.
  Rendered once (manifest.yaml), when `remoteLinks` is not empty.
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    remoteTypes:
      - entity: type
        kind: struct
        name: Badge
        key: Badge
        scope: []
        fields:
          - {name: code, type: {kind: primitive, name: string, max: 4}, hasDefault: false, default: null}
          - {name: access, type: {kind: ref, name: Access, typeKind: bitmask, key: Access, scope: [], flatName: Access}}
      - entity: type
        kind: union
        name: Command
        discriminator: {kind: ref, name: Mode, typeKind: enum, key: Mode, scope: [], flatName: Mode}
        cases:
          - {name: note, type: {kind: primitive, name: string, max: 8}, labels: [Idle], isDefault: false}
          - {name: speed, type: {kind: primitive, name: float64, max: null}, labels: [Run], isDefault: false}
  Also reads: project.name.
#}
