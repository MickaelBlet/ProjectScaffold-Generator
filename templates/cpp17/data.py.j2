{#
  Generates python/<project>/data.py: the types used by the remote calls (enum, bitmask, union, struct,
  exception, alias, custom primitive) as Python classes, then their encode_/decode_ functions (wire.py).
  Rendered once (manifest.yaml), when `remoteLinks` is not empty.
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    remoteTypes:
      - {entity: type, kind: enum, name: Mode, values: [{name: Idle, value: 0}, {name: Run, value: 1}]}
      - entity: type
        kind: union
        name: Item
        discriminator: {kind: primitive, name: int16, max: null}
        cases:
          - {name: number, type: {kind: primitive, name: int32, max: null}, labels: [1, 2], label: 1, isDefault: false}
          - {name: text, type: {kind: primitive, name: string, max: null}, labels: [], label: 0, isDefault: true}
#}
