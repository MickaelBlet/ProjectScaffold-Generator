{#
  Generates include/<project>/interfaces/<Interface>.hpp: one interface, an abstract class of pure virtual methods.
  Rendered (manifest.yaml): once per entry of `interfaces`, as `interface`: an Interface
  (schema $defs/Interface).
  Example input (from tests/fixtures/plant.scaffold.yaml, trimmed):
    interface:
      entity: interface
      name: Sink
      scope: []
      messages:
        - name: push
          params: [{name: reading, type: {kind: ref, name: Reading, typeKind: struct, key: Reading}, direction: in, const: false}]
          returns: null
          raises: []
#}
{% from '_cpp_namespace.j2' import cpp_namespace as _cpp_namespace %}
{% from '_doc_comment.j2' import doc_comment as _doc_comment %}
{% from '_identifier.j2' import identifier as _identifier %}
{% from '_includes.j2' import includes as _includes %}
{% from '_name.j2' import name as _name %}
{% from '_parameters.j2' import parameters as _parameters %}
{% from '_type.j2' import type as _type %}
{% include '_banner.j2' %}
#pragma once

{{ _includes(entity=interface) }}
{%- filter user('includes') +%}
{% endfilter +%}

namespace {{ _cpp_namespace(entity=interface) }} {

{{ _doc_comment(text=interface.description) }}{##}
class {{ _name(entity=interface) }} {
public:
    virtual ~{{ _name(entity=interface) }}() = default;
{# One pure virtual method per message; its `raises` become @throws lines. #}
{% for message in interface.messages %}

{{ _doc_comment(text=message.description, prefix='    /// ') }}{##}
{% for raised_type in message.raises %}
    /// @throws {{ _type(type_reference=raised_type) }}
{% endfor %}
    virtual {{ _type(type_reference=message.returns) }} {{ _identifier(name=message.name) }}({{ _parameters(parameters=message.params) }}) = 0;
{% endfor %}

    {%+ filter user('members') +%}
    {%+ endfilter +%}
};

{% filter user('end') +%}
{% endfilter +%}

} // namespace {{ _cpp_namespace(entity=interface) }}
