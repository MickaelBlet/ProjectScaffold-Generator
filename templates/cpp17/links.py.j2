{#
  Generates python/<project>/links.py: one `Link` per remote link (transport, addresses, settings, ack), as
  the C++ side knows them.
  Rendered once (manifest.yaml), when `remoteLinks` is not empty.
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    remoteLinks:
      - index: 0
        link:
          name: echo_tcp
          description: ''
          constraints:
            ack: {required: true, timeoutMs: 2000}
            remote:
              transport: tcp
              settings: {client: {host: 127.0.0.1, port: 47210}, server: {host: 0.0.0.0, port: 47210}}
        interface: {name: Echo}
        from: {binary: Client, module: Caller, port: tcp}
        to: {binary: Server, module: Service, port: tcp}
        settings: {path: null, capacity: null, options: []}
#}
{% from '_address.j2' import address as _address %}
{% from '_address_variable.j2' import address_variable as _address_variable %}
{% from '_transport_settings.j2' import transport_settings as _transport_settings %}
{% include '_py_banner.j2' %}
"""Links between the binaries of {{ project.name }}. The address of a link is the value of its environment
variable, else its default (as in C++): one for the client (the caller connects to it), one for the
server (the callee listens on it)."""
from __future__ import annotations

import os
from typing import Dict, List, NamedTuple


class Link(NamedTuple):
    name: str
    index: int
    interface: str
    transport: str
    client_variable: str
    client_default: str
    server_variable: str
    server_default: str
    # Request path (http, websocket).
    path: str
    # Bytes of each ring (shm).
    capacity: int
    # Settings of the transport set in the project, as text (see `options` for the free ones).
    settings: str
    options: Dict[str, str]
    # Every call waits for its reply.
    ack: bool
    # Seconds to wait for a reply.
    timeout: float
    # Binary calling through a proxy.
    caller: str
    # Binary receiving the calls through a stub.
    callee: str

    @property
    def client_address(self) -> str:
        return os.environ.get(self.client_variable) or self.client_default

    @property
    def server_address(self) -> str:
        return os.environ.get(self.server_variable) or self.server_default

{# One Link constant per remote link; `options` is the free settings as a dict literal. #}
{% for remote_link in remoteLinks %}

{{ remote_link.link.description|doc_comment('# ') }}
{{ remote_link.link.name|constant }} = Link('{{ remote_link.link.name }}', {{ remote_link.index }}, '{{ remote_link.interface.name }}', '{{ remote_link.link.constraints.remote.transport }}', '{{ _address_variable(remote_link=remote_link, side='client') }}', '{{ _address(remote_link=remote_link, side='client') }}', '{{ _address_variable(remote_link=remote_link, side='server') }}', '{{ _address(remote_link=remote_link, side='server') }}', '{{ remote_link.settings.path|default('/', true) }}', {{ remote_link.settings.capacity|default(1048576, true) }}, '{{ _transport_settings(settings=remote_link.link.constraints.remote.settings) }}', { {%- for option in remote_link.settings.options %}'{{ option.name }}': '{{ option.value }}'{% if not loop.last %}, {% endif %}{% endfor -%} }, {% if remote_link.link.constraints.ack.required %}True{% else %}False{% endif %}, {{ '%.12g'|format(remote_link.link.constraints.ack.timeoutMs|default(5000, true) / 1000.0) }}, '{{ remote_link.from.binary }}', '{{ remote_link.to.binary }}')
{% endfor %}

LINKS: List[Link] = [{% for remote_link in remoteLinks %}{{ remote_link.link.name|constant }}{% if not loop.last %}, {% endif %}{% endfor %}]
