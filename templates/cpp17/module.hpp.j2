{% endif %}
{% endfor %}
{% for instance in module.instances %}
{% if instance.abstract %}
    std::unique_ptr<{{ _qualified_name(entity=instance) }}> {{ _accessor(name=instance.name) }}_; // abstract: created in the constructor
{% else %}
    {{ _qualified_name(entity=instance) }} {{ _accessor(name=instance.name) }}_;
{% endif %}
{% endfor %}
{% for attribute in module.attributes %}
