{#
  Generates include/<project>/<namespace>/<Module>.hpp: the class of one module (class, abstract class or
  interface class): constructor, port accessors, instances of child modules, attributes, and the adapters
  that route the calls received by `in` ports to `on<Port><Message>` methods.
  Rendered (manifest.yaml): once per entry of `modules`, as `module`: a Module (schema
  $defs/Module).
  Example input (from tests/fixtures/plant.scaffold.yaml, trimmed):
    module:
      entity: module
      name: Plant
      kind: class
      abstract: false
      isBase: false
      namespace: []
      bases: []
      methods: []
      attributes: []
      ports:
        - name: feed
          role: in
          interface: {entity: interface, name: Sink, messages: [{name: push, ...}]}
          delegates: [{via: [Group, Filter], module: Plant.Group.Filter, port: in}]
        - {name: out, role: out, interface: {entity: interface, name: Sink, ...}, delegates: [{via: [Group], module: Plant.Group, port: out}]}
      instances: [{entity: module, name: Sensor, abstract: false, ...}, {name: Store, ...}, {name: Group, ...}]
  Also reads: project.name.
#}
