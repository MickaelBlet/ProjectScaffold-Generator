{{ _doc_comment(text=port.description, prefix='    /// ') }}{##}
{% if port.role == 'out' %}
    ::{{ root }}::OutPort<{{ _qualified_name(entity=port.interface) }}>& {{ _identifier(name=port.name) }}() { return {{ _member(name=port.name) }}; }
{% elif port.delegates|length > 0 %}
    {{ _qualified_name(entity=port.interface) }}& {{ _identifier(name=port.name) }}() { return {{ _endpoint(link_end=port.delegates[0]) }}; }
{% else %}
