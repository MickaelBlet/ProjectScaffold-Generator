{#
  Generates python/<project>/peers/<binary>.py: a Python peer standing in for one binary, to test the others:
  serves the calls the binary receives (stubs) and makes those it sends (proxies).
  Rendered (manifest.yaml): once per entry of `systems` that has proxies or stubs, as `system`.
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    system:
      binary: {name: Server, description: ''}
      stubs:
        - link: {name: echo_tcp, constraints: {remote: {transport: tcp}}}
          interface: {name: Echo}
          peer: {binary: Client, module: Caller, port: tcp}
          local: {module: Service, port: tcp}
      proxies: []
  Also reads: project.name.
#}
{% from '_constant.j2' import constant as _constant %}
{% from '_doc_comment.j2' import doc_comment as _doc_comment %}
{% from '_project_identifier.j2' import project_identifier as _project_identifier %}
{% from '_py_identifier.j2' import py_identifier as _py_identifier %}
{% from '_snake.j2' import snake as _snake %}
{% include '_py_banner.j2' %}
{% set module_name = _project_identifier() %}
{% set binary = system.binary.name %}
{% set faces = (system.proxies|map(attribute='interface')|list + system.stubs|map(attribute='interface')|list)|unique|list %}
{# Transports the Python peers implement; the others are left to the user. #}
{% set generated = ['tcp', 'udp', 'http', 'websocket', 'shm', 'mq'] %}
"""Stands in for binary {{ binary }} of {{ project.name }}, to test the other binaries: serves the calls
{{ binary }} receives, makes those it sends.

    python -m {{ module_name }}.peers.{{ _snake(name=binary) }}    # from the python/ directory; Ctrl-C stops
"""
from __future__ import annotations

import logging
import time
from typing import List, Optional

from .. import links
from ..transport import Server
{% for interface in faces %}
from ..remote.{{ _py_identifier(name=_snake(name=interface.name)) }} import {{ interface.name }}Handler, {{ interface.name }}Proxy, {{ interface.name }}Stub
{% endfor %}
{% filter user('imports') +%}
{% endfilter +%}


class {{ binary }}Peer:
{{ _doc_comment(text=system.binary.description, prefix='    # ') }}{##}
    """Binary {{ binary }}: one handler per link it receives (default: logging ones), one proxy per link it
    calls (connecting on the first call). serve() starts receiving, close() stops."""

    def __init__(self{% for remote_link in system.stubs %}{% if remote_link.link.constraints.remote.transport in generated %}, {{ _py_identifier(name=remote_link.link.name) }}: Optional[{{ remote_link.interface.name }}Handler] = None{% endif %}{% endfor %}) -> None:
{# One handler attribute per link received by the binary. #}
{% for remote_link in system.stubs %}
        # {{ remote_link.link.name }}: binary {{ remote_link.peer.binary }}, {{ remote_link.peer.module }}:{{ remote_link.peer.port }} -> {{ remote_link.local.module }}:{{ remote_link.local.port }} over {{ remote_link.link.constraints.remote.transport }}
{% if remote_link.link.constraints.remote.transport in generated %}
        self.{{ remote_link.link.name }}_handler = {{ _py_identifier(name=remote_link.link.name) }} if {{ _py_identifier(name=remote_link.link.name) }} is not None else {{ remote_link.interface.name }}Handler()
{% else %}
        # Transport not generated: receive its frames into {{ remote_link.interface.name }}Stub(handler) yourself.
{% endif %}
{% endfor %}
{# One connected proxy attribute per link called by the binary. #}
{% for remote_link in system.proxies %}
        # {{ remote_link.link.name }}: {{ remote_link.local.module }}:{{ remote_link.local.port }} -> binary {{ remote_link.peer.binary }}, {{ remote_link.peer.module }}:{{ remote_link.peer.port }} over {{ remote_link.link.constraints.remote.transport }}
{% if remote_link.link.constraints.remote.transport in generated %}
        self.{{ remote_link.link.name }} = {{ remote_link.interface.name }}Proxy.connect(links.{{ _constant(name=remote_link.link.name) }})
{% else %}
        # Transport not generated: give {{ remote_link.interface.name }}Proxy a Channel of your own.
{% endif %}
{% endfor %}
        self._servers: List[Server] = []
        {%+ filter user('init') +%}
        {%+ endfilter +%}

    def serve(self) -> {{ binary }}Peer:
        """Starts receiving the calls of the other binaries."""
        if not self._servers:
            self._servers = [
{# One server per received link, each feeding its stub. #}
{% for remote_link in system.stubs %}
{% if remote_link.link.constraints.remote.transport in generated %}
                {{ remote_link.interface.name }}Stub.serve(links.{{ _constant(name=remote_link.link.name) }}, self.{{ remote_link.link.name }}_handler),
{% endif %}
{% endfor %}
            ]
        return self

    def close(self) -> None:
        for server in self._servers:
            server.close()
        self._servers = []
{# Proxies are closed with the peer. #}
{% for remote_link in system.proxies %}
{% if remote_link.link.constraints.remote.transport in generated %}
        self.{{ remote_link.link.name }}.close()
{% endif %}
{% endfor %}

    def __enter__(self) -> {{ binary }}Peer:
        return self.serve()

    def __exit__(self, *_: object) -> None:
        self.close()

    {%+ filter user('peer') +%}
    {%+ endfilter +%}


def main() -> None:
    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(name)s: %(message)s')
    with {{ binary }}Peer() as peer:
        {%+ filter user('main') +%}
        print('{{ binary }} peer running; Ctrl-C stops')
        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            pass
        {%+ endfilter +%}


if __name__ == '__main__':
    main()
