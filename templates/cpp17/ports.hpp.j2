#pragma once

#include <cstddef>
#include <stdexcept>
#include <vector>

namespace {{ _project_identifier() }} {

/// Out port of a module: its calls go to the `in` ports it is connected to, and to those of the
/// out ports it forwards to (the out ports of enclosing modules it goes out through).
template <class Interface>
class OutPort {
public:
    /// Sends the calls of this port to `peer`.
    void connect(Interface& peer) { peers_.push_back(&peer); }

    /// Sends the calls of this port to the peers of `port` as well.
    void forward(OutPort& port) { forwards_.push_back(&port); }

    /// Every peer, forwarded ones included.
    std::vector<Interface*> peers() const
    {
        std::vector<Interface*> all(peers_);
        for (const OutPort* f : forwards_) {
            const std::vector<Interface*> more = f->peers();
            all.insert(all.end(), more.begin(), more.end());
        }
        return all;
    }

    bool connected() const { return first(); }

    /// The only peer: throws std::logic_error unless exactly one is connected.
    Interface* operator->() const
    {
        Interface* sole = nullptr;
        if (count(sole) != 1) throw std::logic_error("out port with no or several peers");
        return sole;
    }

    /// Calls `f(peer)` for each peer.
    template <class F>
    void each(F&& f) const
    {
        for (Interface* peer : peers_) f(*peer);
        for (const OutPort* port : forwards_) port->each(f);
    }

private:
    Interface* first() const
    {
        if (!peers_.empty()) return peers_.front();
        for (const OutPort* port : forwards_)
            if (Interface* peer = port->first()) return peer;
        return nullptr;
    }

    /// The number of peers, up to 2 (enough to tell one from several); `sole`: the first one.
    std::size_t count(Interface*& sole) const
    {
        std::size_t n = peers_.size();
        if (n) sole = peers_.front();
        for (const OutPort* port : forwards_) {
            if (n > 1) break;
            Interface* more = nullptr;
            const std::size_t k = port->count(more);
            if (k && !n) sole = more;
            n += k;
        }
        return n;
    }

    std::vector<Interface*> peers_;
    std::vector<OutPort*> forwards_;
};

} // namespace {{ _project_identifier() }}
