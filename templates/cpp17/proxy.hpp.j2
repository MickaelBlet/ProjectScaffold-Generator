  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    item:
      entity: interface
      name: Echo
      messages:
        - name: scale
          params:
            - {name: v, type: {kind: ref, name: Vec3, typeKind: struct, key: Vec3, scope: [], flatName: Vec3}, direction: inout}
            - {name: factor, type: {kind: primitive, name: float64, max: null}, direction: in}
          inputs: [v, factor]     # the `in` and `inout` parameters, as above
          outputs: [v]            # the `out` and `inout` parameters
          returns: {kind: primitive, name: bool, max: null}
          raises: []
