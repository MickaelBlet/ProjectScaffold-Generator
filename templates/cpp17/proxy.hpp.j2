class {{ item.name }}Proxy final : public {{ _qualified_name(entity=item) }} {
public:
    /// Sends the calls over `channel`; `ack`: every call waits for its reply, within `timeout`.
    void open(std::unique_ptr<Channel> channel, bool ack = false,
              std::chrono::milliseconds timeout = std::chrono::milliseconds(5000))
    {
        caller_.open(std::move(channel), ack, timeout);
    }
{# One overriding method per message; its index in the interface is the message number on the wire. #}
{% for message in item.messages %}
{% set call_prefix %}{% if message.raises|length > 0 %}callRaising<{% for exception_type in message.raises %}{{ _type(type_reference=exception_type) }}{% if not loop.last %}, {% endif %}{% endfor %}>(caller_, {% else %}caller_.call({% endif %}{% endset %}
{# Declared exceptions thrown as such. #}

    {{ _type(type_reference=message.returns) }} {{ _identifier(name=message.name) }}({{ _parameters(parameter_list=message.params) }}) override
    {
        Writer request_;
{% for parameter in message.inputs %}
{% set state.expression = _identifier(name=parameter.name) %}
{% set state.bounds_check = _bounds(type_reference=parameter.type, expression=state.expression, depth=0) %}
{% if state.bounds_check != '' %}
        {{ state.bounds_check }}
{% endif %}
        encode(request_, {{ state.expression }});
{% endfor %}
{% if message.returns or message.outputs|length > 0 %}
        const Bytes reply_ = {{ call_prefix }}{{ loop.index0 }}, request_.bytes(), true);
        Reader reader_(reply_);
{% if message.returns %}
        {{ _type(type_reference=message.returns) }} result_{};
        decode(reader_, result_);
{% set state.bounds_check = _bounds(type_reference=message.returns, expression='result_', depth=0) %}
{% if state.bounds_check != '' %}
        {{ state.bounds_check }}
{% endif %}
{% endif %}
{% for parameter in message.outputs %}
{% set state.expression = _identifier(name=parameter.name) %}
{% set state.bounds_check = _bounds(type_reference=parameter.type, expression=state.expression, depth=0) %}
{# Decoded, then checked. #}
        decode(reader_, {{ state.expression }});
{% if state.bounds_check != '' %}
        {{ state.bounds_check }}
{% endif %}
{% endfor %}
        reader_.end();
{% if message.returns %}
        return result_;
{% endif %}
{% else %}
        {{ call_prefix }}{{ loop.index0 }}, request_.bytes(), false);
{% endif %}
    }
{% endfor %}

    {%+ filter user('public') +%}
    {%+ endfilter +%}

private:
    Caller caller_;
    {%+ filter user('private') +%}
    {%+ endfilter +%}
};

} // namespace {{ project.name|as_identifier|snake }}::remote
