{#
  Generates python/<project>/remote/__init__.py: re-exports the Handler, Proxy and Stub of every remote interface.
  Rendered once (manifest.yaml), when `remoteLinks` is not empty.
  Example input (trimmed):
    remoteInterfaces:
      - {entity: interface, name: Echo, messages: [...]}
      - {entity: interface, name: Notify, messages: [...]}
#}
{% from '_py_identifier.j2' import py_identifier as _py_identifier %}
{% include '_py_banner.j2' %}
"""Proxies, handlers and stubs of the interfaces of the links between binaries."""
{# One import line per interface. #}
{% for interface in remoteInterfaces %}
from .{{ _py_identifier(name=interface.name|snake) }} import {{ interface.name }}Handler, {{ interface.name }}Proxy, {{ interface.name }}Stub
{% endfor %}
