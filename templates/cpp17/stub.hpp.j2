namespace {{ project.name|as_identifier|snake }}::remote {

/// Receives the calls of {{ _name(entity=item) }} from another binary and makes them on the
/// port bound. The calls come on the threads of the transport: several at once over tcp, http and
/// websocket (one per connection).
class {{ item.name }}Stub {
public:
    {{ item.name }}Stub() = default;
    {{ item.name }}Stub(const {{ item.name }}Stub&) = delete;
    {{ item.name }}Stub& operator=(const {{ item.name }}Stub&) = delete;
    ~{{ item.name }}Stub() { server_.reset(); }

    void bind({{ _qualified_name(entity=item) }}& target) { target_ = &target; }

    /// Receives the calls over `transport`, at `address`; `capacity`: bytes of each ring of shm.
    void serve(const std::string& transport, const std::string& address,
               std::uint32_t capacity = remote::ringCapacity)
    {
        server_ = remote::serve(
            transport, address, [this](const Bytes& frame) { return dispatch(frame); }, capacity);
    }

    /// Makes the call of a frame: the reply frame, or nothing when the call wants none.
    std::optional<Bytes> dispatch(const Bytes& frame)
    {
        return respond(frame, [this](std::uint16_t message_, Reader& reader_, [[maybe_unused]] Writer& writer_) {
            if (!target_) throw Error("{{ item.name }}Stub not bound");
            switch (message_) {
{# One switch case per message number: decode inputs, call the target, encode result and outputs. #}
{% for message in item.messages %}
            case {{ loop.index0 }}: {
{% for parameter in message.params %}
                {{ _type(type_reference=parameter.type) }} {{ _identifier(name=parameter.name) }}{};
{% endfor %}
{% for parameter in message.inputs %}
{% set state.expression = _identifier(name=parameter.name) %}
{% set state.bounds_check = _bounds(type_reference=parameter.type, expression=state.expression, depth=0) %}
{# Decoded, then checked. #}
                decode(reader_, {{ state.expression }});
{% if state.bounds_check != '' %}
                {{ state.bounds_check }}
{% endif %}
{% endfor %}
                reader_.end();
{# The call and the encoding of its reply, indented below when the message has declared exceptions to catch. #}
{% set call_statements %}
{% if message.returns %}
{% set state.bounds_check = _bounds(type_reference=message.returns, expression='result_', depth=0) %}
{% if state.bounds_check != '' %}
                const auto result_ = target_->{{ _identifier(name=message.name) }}({{ _arguments(parameters=message.params) }});
                {{ state.bounds_check }}
                encode(writer_, result_);
{% else %}
                encode(writer_, target_->{{ _identifier(name=message.name) }}({{ _arguments(parameters=message.params) }}));
{% endif %}
{% else %}
                target_->{{ _identifier(name=message.name) }}({{ _arguments(parameters=message.params) }});
{% endif %}
{% for parameter in message.outputs %}
{% set state.expression = _identifier(name=parameter.name) %}
{% set state.bounds_check = _bounds(type_reference=parameter.type, expression=state.expression, depth=0) %}
{% if state.bounds_check != '' %}
                {{ state.bounds_check }}
{% endif %}
                encode(writer_, {{ state.expression }});
{% endfor %}
{% endset %}
{% if message.raises|length > 0 %}
                try {
{{ '    ' ~ call_statements.rstrip()|replace('\n', '\n    ') }}
{% for raised_type in message.raises %}
                } catch (const {{ _type(type_reference=raised_type) }}& e) {
                    throw raised({{ loop.index0 }}, e);
{% endfor %}
                }
{% else %}
{{ call_statements.rstrip() }}
{% endif %}
                return true;
            }
{% endfor %}
            default:
                return false;
            }
        });
    }

