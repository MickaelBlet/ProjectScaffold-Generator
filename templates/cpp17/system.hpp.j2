{#
  Generates include/<project>/<System>.hpp: the class instantiating the top-level modules of one binary
  (or of the whole project), plus the proxies and stubs of its links with other binaries.
  Rendered (manifest.yaml): once per entry of `systems`, as `system`, when `modules` is not empty.
  Example input (from tests/fixtures/relay.scaffold.yaml, trimmed):
    system:
      name: ClientSystem
      binary: {name: Client, description: ''}
      instances: [{entity: module, name: Caller, abstract: false, ...}]
      proxies:
        - link: {name: echo_tcp, ...}
          local: {via: [Caller], module: Caller, port: tcp}
          peer: {binary: Server, module: Service, port: tcp}
          interface: {entity: interface, name: Echo, ...}
      stubs:
        - link: {name: status, ...}
          local: {via: [Caller], module: Caller, port: status}
          peer: {binary: Server, module: Service, port: status}
          interface: {entity: interface, name: Status, ...}
  Also reads: project.name, project.description.
#}
{% from '_accessor.j2' import accessor as _accessor %}
{% from '_camel.j2' import camel as _camel %}
{% from '_cpp_namespace.j2' import cpp_namespace as _cpp_namespace %}
{% from '_doc_comment.j2' import doc_comment as _doc_comment %}
{% from '_includes.j2' import includes as _includes %}
{% from '_project_identifier.j2' import project_identifier as _project_identifier %}
{% from '_qualified_name.j2' import qualified_name as _qualified_name %}
{% set state = namespace() %}
{% include '_banner.j2' %}
#pragma once

{{ _includes(entity=system) -}}
{# Headers of the proxy and stub classes this system needs, once each and sorted. #}
{% set state.remote_headers = [] %}
{% for remote_link in system.proxies %}
  {% set state.remote_headers = state.remote_headers + [remote_link.interface.name ~ 'Proxy'] %}
{% endfor %}
{% for remote_link in system.stubs %}
  {% set state.remote_headers = state.remote_headers + [remote_link.interface.name ~ 'Stub'] %}
{% endfor %}
{% set state.remote_headers = state.remote_headers|unique|list|sort %}
{% for remote_link in state.remote_headers %}
#include <{{ _project_identifier() }}/remote/{{ remote_link }}.hpp>
{% endfor %}
{% filter user('includes') +%}
{% endfilter +%}

namespace {{ _cpp_namespace(entity=system) }} {

{{ _doc_comment(text=project.description) }}{##}
{% if system.binary %}
{{ _doc_comment(text=system.binary.description) }}{##}
/// The top-level modules of binary {{ system.binary.name }} of {{ project.name }}, wired together and to
/// the other binaries.
{% else %}
/// The top-level modules of {{ project.name }}, wired together.
{% endif %}
class {{ system.name }} {
public:
    {{ system.name }}();
    ~{{ system.name }}();
    {{ system.name }}(const {{ system.name }}&) = delete;
    {{ system.name }}& operator=(const {{ system.name }}&) = delete;

{# Accessors of the top-level modules. #}
{% for instance in system.instances %}
    {{ _qualified_name(entity=instance) }}& {{ _accessor(name=instance.name) }}() { return {% if instance.abstract %}*{% endif %}{{ _accessor(name=instance.name) }}_; }
{% endfor %}

    {%+ filter user('public') +%}
    {%+ endfilter +%}

private:
{% for instance in system.instances %}
{% if instance.abstract %}
    std::unique_ptr<{{ _qualified_name(entity=instance) }}> {{ _accessor(name=instance.name) }}_; // abstract: created in the constructor
{% else %}
    {{ _qualified_name(entity=instance) }} {{ _accessor(name=instance.name) }}_;
{% endif %}
{% endfor %}
{# One proxy per link sending calls to another binary, one stub per link receiving them. #}
{% for remote_link in system.proxies %}
    remote::{{ remote_link.interface.name }}Proxy {{ _camel(name=remote_link.link.name) }}Proxy_; // {{ remote_link.link.name }}, to binary {{ remote_link.peer.binary }}
{% endfor %}
{% for remote_link in system.stubs %}
    remote::{{ remote_link.interface.name }}Stub {{ _camel(name=remote_link.link.name) }}Stub_; // {{ remote_link.link.name }}, from binary {{ remote_link.peer.binary }}
{% endfor %}
    {%+ filter user('private') +%}
    {%+ endfilter +%}
};

} // namespace {{ _cpp_namespace(entity=system) }}
