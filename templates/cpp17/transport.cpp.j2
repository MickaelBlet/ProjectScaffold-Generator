/// Largest datagram payload.
constexpr std::size_t maxDatagram = 65507;

/// End of a stream, closed by the peer.
class Closed : public Error {
public:
    Closed() : Error("connection closed") {}
};

[[noreturn]] void fail(const std::string& what) { throw Error(what + ": " + std::strerror(errno)); }

/// File descriptor, closed on destruction.
class Fd {
public:
    Fd() = default;
    explicit Fd(int fd) : fd_(fd) {}
    Fd(Fd&& other) noexcept : fd_(std::exchange(other.fd_, -1)) {}
    Fd& operator=(Fd&& other) noexcept
    {
        if (this != &other) {
            reset();
            fd_ = std::exchange(other.fd_, -1);
        }
        return *this;
    }
    Fd(const Fd&) = delete;
    Fd& operator=(const Fd&) = delete;
    ~Fd() { reset(); }

    int get() const { return fd_; }
    explicit operator bool() const { return fd_ >= 0; }
    void reset()
    {
        if (fd_ >= 0) ::close(fd_);
        fd_ = -1;
    }

private:
    int fd_ = -1;
};

struct HostPort {
    std::string host;
    std::string port;
};

HostPort split(const std::string& address)
{
    const std::size_t colon = address.rfind(':');
    if (colon == std::string::npos) throw Error("address '" + address + "' is not host:port");
    std::string host = address.substr(0, colon);
    if (host.size() >= 2 && host.front() == '[' && host.back() == ']') host = host.substr(1, host.size() - 2);
    return {host, address.substr(colon + 1)};
}

void configure(int fd, int type)
{
    const int one = 1;
    if (type == SOCK_STREAM) ::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
#ifdef SO_NOSIGPIPE
    ::setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
#endif
}

/// Waits until `fd` has input (or room for output with POLLOUT): false at `deadline`, or when
/// `stop` is set.
bool await(int fd, Clock::time_point deadline, const std::atomic<bool>* stop, short events = POLLIN)
{
    for (;;) {
        if (stop && *stop) return false;
        const Clock::time_point now = Clock::now();
        if (now >= deadline) return false;
        const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count() + 1;
        pollfd p{fd, events, 0};
        const int rc = ::poll(&p, 1, static_cast<int>(std::min<long long>(left, 100)));
        if (rc > 0) return true;
        if (rc < 0 && errno != EINTR) fail("poll");
    }
}

/// Connects `fd` to `a` before `deadline`.
bool connectBy(int fd, const addrinfo* a, Clock::time_point deadline)
{
    const int flags = ::fcntl(fd, F_GETFL, 0);
    ::fcntl(fd, F_SETFL, flags | O_NONBLOCK);
    bool connected = ::connect(fd, a->ai_addr, a->ai_addrlen) == 0;
    if (!connected && errno == EINPROGRESS && await(fd, deadline, nullptr, POLLOUT)) {
        int error = 0;
        socklen_t size = sizeof error;
        connected = ::getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) == 0 && error == 0;
    }
    ::fcntl(fd, F_SETFL, flags);
    return connected;
}

/// Socket connected to `address`, or bound to it (and listening for a stream) when `bind`.
Fd openSocket(const std::string& address, int type, bool bind, Clock::time_point deadline = forever)
{
    const HostPort at = split(address);
    addrinfo hints{};
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = type;
    if (bind) hints.ai_flags = AI_PASSIVE;
    addrinfo* found = nullptr;
    const int rc = ::getaddrinfo(at.host.empty() ? nullptr : at.host.c_str(), at.port.c_str(), &hints, &found);
    if (rc != 0) throw Error("cannot resolve '" + address + "': " + ::gai_strerror(rc));
    const std::unique_ptr<addrinfo, void (*)(addrinfo*)> list(found, ::freeaddrinfo);
    for (const addrinfo* a = found; a; a = a->ai_next) {
        Fd fd(::socket(a->ai_family, a->ai_socktype, a->ai_protocol));
        if (!fd) continue;
        ::fcntl(fd.get(), F_SETFD, FD_CLOEXEC);
        configure(fd.get(), type);
        if (bind) {
            const int one = 1;
            ::setsockopt(fd.get(), SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
            if (::bind(fd.get(), a->ai_addr, a->ai_addrlen) != 0) continue;
            if (type == SOCK_STREAM && ::listen(fd.get(), 16) != 0) continue;
            return fd;
        }
        if (connectBy(fd.get(), a, deadline)) return fd;
    }
    fail((bind ? "cannot listen on " : "cannot connect to ") + address);
}

/// Sends everything before `deadline` or `stop` (a peer not reading blocks no one past them).
void sendAll(int fd, const void* data, std::size_t size, Clock::time_point deadline = forever,
             const std::atomic<bool>* stop = nullptr)
{
    const auto* p = static_cast<const char*>(data);
    while (size) {
        const ssize_t n = ::send(fd, p, size, sendFlags | MSG_DONTWAIT);
        if (n < 0) {
            if (errno == EINTR) continue;
            if (errno == EAGAIN || errno == EWOULDBLOCK) {
                if (!await(fd, deadline, stop, POLLOUT)) throw Error(stop && *stop ? "stopped" : "send timed out");
                continue;
            }
            fail("send");
        }
        p += n;
        size -= static_cast<std::size_t>(n);
    }
}

void sendAll(int fd, const std::string& text, Clock::time_point deadline = forever,
             const std::atomic<bool>* stop = nullptr)
{
    sendAll(fd, text.data(), text.size(), deadline, stop);
}

/// Buffered input of a stream socket. Nothing is consumed by a read that fails (deadline, stop): the
/// stream stays in step.
class Input {
public:
    explicit Input(int fd) : fd_(fd) {}

    /// Waits for `size` bytes buffered: false at `deadline` or on `stop`; throws Closed at the end of the
    /// stream.
    bool need(std::size_t size, Clock::time_point deadline, const std::atomic<bool>* stop)
    {
        while (available() < size)
            if (!fill(size, deadline, stop)) return false;
        return true;
    }

    const std::uint8_t* data() const { return buffer_.data() + begin_; }
    std::size_t available() const { return end_ - begin_; }

    void consume(std::size_t size)
    {
        begin_ += size;
        if (begin_ == end_) {
            begin_ = end_ = 0;
            // A large frame does not keep its memory.
            if (buffer_.size() > largeBuffer) Bytes().swap(buffer_);
        }
    }

    /// The next `size` bytes.
    bool take(std::size_t size, std::string& out, Clock::time_point deadline, const std::atomic<bool>* stop)
    {
        if (!need(size, deadline, stop)) return false;
        out.assign(reinterpret_cast<const char*>(data()), size);
        consume(size);
        return true;
    }
    bool take(std::size_t size, Bytes& out, Clock::time_point deadline, const std::atomic<bool>* stop)
    {
        if (!need(size, deadline, stop)) return false;
        out.assign(data(), data() + size);
        consume(size);
        return true;
    }

    /// The bytes up to `delimiter` included, at most `limit` of them.
    bool until(const std::string& delimiter, std::string& out, std::size_t limit, Clock::time_point deadline,
               const std::atomic<bool>* stop)
    {
        std::size_t from = 0;
        for (;;) {
            const auto* first = reinterpret_cast<const char*>(data());
            const std::string_view seen(first, available());
            const std::size_t at = seen.find(delimiter, from);
            if (at != std::string_view::npos) return take(at + delimiter.size(), out, deadline, stop);
            if (available() > limit) throw Error("header too long");
            from = available() >= delimiter.size() ? available() - delimiter.size() + 1 : 0;
            if (!fill(available() + 1, deadline, stop)) return false;
        }
    }

private:
    static constexpr std::size_t chunk = 65536;
    static constexpr std::size_t largeBuffer = 1u << 20;

    /// Reads what came, room made for `want` bytes buffered (a whole frame is read into place).
    bool fill(std::size_t want, Clock::time_point deadline, const std::atomic<bool>* stop)
    {
        if (!await(fd_, deadline, stop)) return false;
        if (begin_ > 0) {
            std::memmove(buffer_.data(), buffer_.data() + begin_, available());
            end_ -= begin_;
            begin_ = 0;
        }
        const std::size_t room = std::max(want, end_ + chunk);
        if (buffer_.size() < room) buffer_.resize(room);
        ssize_t n;
        do {
            n = ::recv(fd_, buffer_.data() + end_, buffer_.size() - end_, 0);
        } while (n < 0 && errno == EINTR);
        if (n < 0) fail("recv");
        if (n == 0) throw Closed();
        end_ += static_cast<std::size_t>(n);
        return true;
    }

    int fd_;
    Bytes buffer_;
    std::size_t begin_ = 0;
    std::size_t end_ = 0;
};

/// A frame read from a stream: false at `deadline` or on `stop`.
bool readFrame(Input& in, Bytes& frame, Clock::time_point deadline, const std::atomic<bool>* stop)
{
    if (!in.need(Header::size, deadline, stop)) return false;
    const std::size_t size = Header::size + header(in.data(), Header::size).length;
    if (!in.need(size, deadline, stop)) return false;
    frame.assign(in.data(), in.data() + size);
    in.consume(size);
    return true;
}

std::string lower(std::string s)
{
    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
    return s;
}

/// Value of header `name` (lower case) in an HTTP head.
std::optional<std::string> headerValue(const std::string& head, const std::string& name)
{
    std::size_t start = head.find("\r\n");
    while (start != std::string::npos) {
        start += 2;
        const std::size_t end = head.find("\r\n", start);
        if (end == std::string::npos) break;
        const std::string line = head.substr(start, end - start);
        const std::size_t colon = line.find(':');
        if (colon != std::string::npos && lower(line.substr(0, colon)) == name) {
            const std::size_t first = line.find_first_not_of(" \t", colon + 1);
            const std::size_t last = line.find_last_not_of(" \t");
            return first == std::string::npos ? std::string() : line.substr(first, last - first + 1);
        }
        start = end;
    }
    return std::nullopt;
}

std::size_t contentLength(const std::string& head)
{
    const std::optional<std::string> value = headerValue(head, "content-length");
    if (!value) return 0;
    char* end = nullptr;
    const unsigned long long n = std::strtoull(value->c_str(), &end, 10);
    if (end == value->c_str() || *end || n > Header::size + Header::maxLength) throw Error("bad Content-Length");
    return static_cast<std::size_t>(n);
}

// WebSocket handshake: base64(SHA-1(key + GUID)).

std::array<std::uint8_t, 20> sha1(const std::string& text)
{
    std::uint32_t h[5] = {0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u};
    std::string m = text;
    const std::uint64_t bits = static_cast<std::uint64_t>(text.size()) * 8;
    m += static_cast<char>(0x80);
    while (m.size() % 64 != 56) m += '\0';
    for (int i = 7; i >= 0; --i) m += static_cast<char>((bits >> (8 * i)) & 0xff);
    const auto rol = [](std::uint32_t x, int n) { return (x << n) | (x >> (32 - n)); };
    for (std::size_t c = 0; c < m.size(); c += 64) {
        std::uint32_t w[80];
        for (std::size_t i = 0; i < 16; ++i) {
            const auto byte = [&](std::size_t k) { return static_cast<std::uint32_t>(static_cast<std::uint8_t>(m[c + 4 * i + k])); };
            w[i] = byte(0) << 24 | byte(1) << 16 | byte(2) << 8 | byte(3);
        }
        for (std::size_t i = 16; i < 80; ++i) w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        std::uint32_t a = h[0], b = h[1], x = h[2], d = h[3], e = h[4];
        for (std::size_t i = 0; i < 80; ++i) {
            std::uint32_t f, k;
            if (i < 20) {
                f = (b & x) | (~b & d);
                k = 0x5A827999u;
            } else if (i < 40) {
                f = b ^ x ^ d;
                k = 0x6ED9EBA1u;
            } else if (i < 60) {
                f = (b & x) | (b & d) | (x & d);
                k = 0x8F1BBCDCu;
            } else {
                f = b ^ x ^ d;
                k = 0xCA62C1D6u;
            }
            const std::uint32_t t = rol(a, 5) + f + e + k + w[i];
            e = d;
            d = x;
            x = rol(b, 30);
            b = a;
            a = t;
        }
        h[0] += a;
        h[1] += b;
        h[2] += x;
        h[3] += d;
        h[4] += e;
    }
    std::array<std::uint8_t, 20> out{};
    for (std::size_t i = 0; i < 20; ++i) out[i] = static_cast<std::uint8_t>(h[i / 4] >> (24 - 8 * (i % 4)));
    return out;
}

std::string base64(const std::uint8_t* p, std::size_t n)
{
    static const char* abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::string out;
    for (std::size_t i = 0; i < n; i += 3) {
        const std::uint32_t v = static_cast<std::uint32_t>(p[i]) << 16 |
                                (i + 1 < n ? static_cast<std::uint32_t>(p[i + 1]) << 8 : 0) |
                                (i + 2 < n ? static_cast<std::uint32_t>(p[i + 2]) : 0);
        out += abc[(v >> 18) & 63];
        out += abc[(v >> 12) & 63];
        out += i + 1 < n ? abc[(v >> 6) & 63] : '=';
        out += i + 2 < n ? abc[v & 63] : '=';
    }
    return out;
}

std::string acceptKey(const std::string& key)
{
    const std::array<std::uint8_t, 20> digest = sha1(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    return base64(digest.data(), digest.size());
}

enum Opcode : std::uint8_t { continuation = 0x0, text = 0x1, binary = 0x2, close = 0x8, ping = 0x9, pong = 0xA };

/// A WebSocket frame; clients mask theirs with `mask` (the key comes from it).
std::string wsFrame(std::uint8_t opcode, const std::uint8_t* data, std::size_t size, std::mt19937* mask)
{
    std::string out;
    out.reserve(14 + size);
    out += static_cast<char>(0x80 | opcode);
    const std::uint8_t masked = mask ? 0x80 : 0;
    if (size < 126) {
        out += static_cast<char>(masked | size);
    } else if (size <= 0xffff) {
        out += static_cast<char>(masked | 126);
        out += static_cast<char>(size >> 8);
        out += static_cast<char>(size & 0xff);
    } else {
        out += static_cast<char>(masked | 127);
        for (int i = 7; i >= 0; --i) out += static_cast<char>((static_cast<std::uint64_t>(size) >> (8 * i)) & 0xff);
    }
    if (!mask) {
        out.append(reinterpret_cast<const char*>(data), size);
        return out;
    }
    std::uint8_t key[4];
    for (std::uint8_t& k : key) k = static_cast<std::uint8_t>((*mask)() & 0xff);
    out.append(reinterpret_cast<const char*>(key), 4);
    const std::size_t at = out.size();
    out.resize(at + size);
    char* p = &out[at];
    for (std::size_t i = 0; i < size; ++i) p[i] = static_cast<char>(data[i] ^ key[i & 3]);
    return out;
}

/// The next WebSocket message (fragments joined), answering pings: false at `deadline` or on
/// `stop`; throws Closed on a close frame.
bool wsRead(int fd, Input& in, Bytes& message, std::mt19937* mask, Clock::time_point deadline,
            const std::atomic<bool>* stop, std::mutex* sending = nullptr)
{
    message.clear();
    for (;;) {
        std::string head;
        if (!in.take(2, head, deadline, stop)) return false;
        const auto b0 = static_cast<std::uint8_t>(head[0]);
        const auto b1 = static_cast<std::uint8_t>(head[1]);
        std::uint64_t size = b1 & 0x7f;
        std::string more;
        if (size >= 126) {
            const std::size_t k = size == 126 ? 2 : 8;
            if (!in.take(k, more, deadline, stop)) return false;
            size = 0;
            for (const char c : more) size = size << 8 | static_cast<std::uint8_t>(c);
        }
        const bool control = (b0 & 0x08) != 0;
        // Control frames: whole, 125 bytes at most (RFC 6455).
        if (control && (size > 125 || !(b0 & 0x80))) throw Error("bad WebSocket control frame");
        if (message.size() + size > Header::size + Header::maxLength) throw Error("WebSocket message too large");
        std::string key;
        if ((b1 & 0x80) && !in.take(4, key, deadline, stop)) return false;
        const auto n = static_cast<std::size_t>(size);
        if (!in.need(n, deadline, stop)) return false;
        const std::uint8_t* data = in.data();
        // Unmasked where it is kept: the message, or a control frame's own buffer.
        std::uint8_t control_data[125];
        std::uint8_t* out = control_data;
        const std::uint8_t opcode = b0 & 0x0f;
        const bool kept = opcode == continuation || opcode == text || opcode == binary;
        if (kept) {
            const std::size_t at = message.size();
            message.resize(at + n);
            out = message.data() + at;
        } else if (opcode != close && opcode != ping && opcode != pong) {
            throw Error("bad WebSocket opcode");
        } else if (n > sizeof control_data) {
            throw Error("bad WebSocket control frame");
        }
        if (key.empty()) {
            if (n) std::memcpy(out, data, n);
        } else {
            for (std::size_t i = 0; i < n; ++i) out[i] = static_cast<std::uint8_t>(data[i] ^ static_cast<std::uint8_t>(key[i & 3]));
        }
        in.consume(n);
        switch (opcode) {
        case close:
            throw Closed();
        case ping: {
            const std::string reply = wsFrame(pong, control_data, n, mask);
            std::unique_lock<std::mutex> lock;
            if (sending) lock = std::unique_lock<std::mutex>(*sending);
            sendAll(fd, reply, deadline, stop);
            break;
        }
        case pong:
            break;
        case continuation:
        case text:
        case binary:
            if (b0 & 0x80) return true;
            break;
        default:
            throw Error("bad WebSocket opcode");
        }
    }
}

// Shared memory: a header, then two rings (calls, replies) of messages (u32 length + bytes),
// each with its head (bytes written) and tail (bytes read) counters.

constexpr std::uint32_t shmMagic = 0x314D4353; // "SCM1"
constexpr std::size_t ringHeader = 64;
constexpr std::size_t shmSize(std::uint32_t capacity) { return ringHeader + 2 * (ringHeader + capacity); }

std::uint32_t load(const std::uint8_t* p) { return __atomic_load_n(reinterpret_cast<const std::uint32_t*>(p), __ATOMIC_ACQUIRE); }
void store(std::uint8_t* p, std::uint32_t v) { __atomic_store_n(reinterpret_cast<std::uint32_t*>(p), v, __ATOMIC_RELEASE); }

/// One ring, written by one process and read by another.
class Ring {
public:
    Ring(std::uint8_t* base, std::uint32_t capacity) : base_(base), data_(base + ringHeader), capacity_(capacity) {}

    /// Writes a message: false when there is no room for it yet.
    bool push(const Bytes& message)
    {
        if (message.size() + 4 > capacity_) throw Error("frame larger than the shared memory ring");
        const std::uint32_t head = load(base_);
        const std::uint32_t tail = load(base_ + 4);
        const auto size = static_cast<std::uint32_t>(message.size());
        if (capacity_ - (head - tail) < size + 4) return false;
        std::uint8_t length[4];
        for (int i = 0; i < 4; ++i) length[i] = static_cast<std::uint8_t>(size >> (8 * i));
        copyIn(head, length, 4);
        copyIn(head + 4, message.data(), size);
        store(base_, head + 4 + size);
        return true;
    }

    /// Reads a message: false when there is none.
    bool pop(Bytes& message)
    {
        const std::uint32_t tail = load(base_ + 4);
        const std::uint32_t head = load(base_);
        if (head - tail < 4) return false;
        std::uint8_t length[4];
        copyOut(tail, length, 4);
        const std::uint32_t size = Reader(length, 4).number<std::uint32_t>();
        if (size > capacity_ || head - tail < 4 + size) throw Error("corrupt shared memory ring");
        message.resize(size);
        copyOut(tail + 4, message.data(), size);
        store(base_ + 4, tail + 4 + size);
        return true;
    }

private:
    void copyIn(std::uint32_t at, const std::uint8_t* p, std::size_t n)
    {
        const std::size_t offset = at % capacity_;
        const std::size_t first = std::min<std::size_t>(n, capacity_ - offset);
        std::memcpy(data_ + offset, p, first);
        std::memcpy(data_, p + first, n - first);
    }
    void copyOut(std::uint32_t at, std::uint8_t* p, std::size_t n) const
    {
        const std::size_t offset = at % capacity_;
        const std::size_t first = std::min<std::size_t>(n, capacity_ - offset);
        std::memcpy(p, data_ + offset, first);
        std::memcpy(p + first, data_, n - first);
    }

    std::uint8_t* base_;
    std::uint8_t* data_;
    std::uint32_t capacity_;
};

/// Calls `ready` until it holds (true), `deadline` or `stop` (false), pausing longer each time.
template <class Ready>
bool waitFor(Ready&& ready, Clock::time_point deadline, const std::atomic<bool>* stop)
{
    std::chrono::microseconds pause(0);
    for (;;) {
        if (ready()) return true;
        if ((stop && *stop) || Clock::now() >= deadline) return false;
        if (pause.count())
            std::this_thread::sleep_for(pause);
        else
            std::this_thread::yield();
        pause = std::min(pause + std::chrono::microseconds(50), std::chrono::microseconds(1000));
    }
}

std::string shmName(const std::string& address) { return address.rfind('/', 0) == 0 ? address : "/" + address; }

/// Shared memory mapped in this process.
class Mapping {
public:
    /// `capacity`: of each ring; 0 to read it from the segment (fixed from then on: the other process
    /// cannot move the rings).
    Mapping(void* data, std::size_t size, std::uint32_t capacity)
        : data_(static_cast<std::uint8_t*>(data)), size_(size), capacity_(capacity ? capacity : load(data_ + 4))
    {
    }
    Mapping(const Mapping&) = delete;
    Mapping& operator=(const Mapping&) = delete;
    ~Mapping() { ::munmap(data_, size_); }

    std::uint8_t* data() const { return data_; }
    std::uint32_t capacity() const { return capacity_; }
    Ring ring(int k) const { return Ring(data_ + ringHeader + k * (ringHeader + capacity()), capacity()); }

private:
    std::uint8_t* data_;
    std::size_t size_;
    std::uint32_t capacity_;
};

std::unique_ptr<Mapping> map(int fd, std::size_t size, std::uint32_t capacity = 0)
{
    void* p = ::mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (p == MAP_FAILED) fail("mmap");
    return std::make_unique<Mapping>(p, size, capacity);
}

#if defined(__linux__)
// POSIX message queues (Linux): `<name>.call` and `<name>.reply`, made by the server, a message per frame.

/// Message queue descriptor, closed on destruction.
class Queue {
public:
    Queue() : q_(none()) {}
    explicit Queue(mqd_t q) : q_(q) {}
    Queue(Queue&& other) noexcept : q_(other.q_) { other.q_ = none(); }
    Queue& operator=(Queue&& other) noexcept
    {
        if (this != &other) {
            reset();
            q_ = other.q_;
            other.q_ = none();
        }
        return *this;
    }
    Queue(const Queue&) = delete;
    Queue& operator=(const Queue&) = delete;
    ~Queue() { reset(); }

    mqd_t get() const { return q_; }
    explicit operator bool() const { return q_ != none(); }
    void reset()
    {
        if (q_ != none()) ::mq_close(q_);
        q_ = none();
    }
    /// Bytes of a message at most.
    std::size_t messageSize() const
    {
        mq_attr attr{};
        if (::mq_getattr(q_, &attr) != 0) fail("mq_getattr");
        return static_cast<std::size_t>(attr.mq_msgsize);
    }

private:
    static mqd_t none() { return static_cast<mqd_t>(-1); }
    mqd_t q_;
};

/// The CLOCK_REALTIME time mq_timedsend / mq_timedreceive wait until: `deadline`, at most 100 ms from now
/// (the stop flag of a server is checked in between).
timespec slice(Clock::time_point deadline)
{
    const Clock::duration left =
        std::max(Clock::duration::zero(), std::min<Clock::duration>(deadline - Clock::now(), std::chrono::milliseconds(100)));
    timespec at{};
    ::clock_gettime(CLOCK_REALTIME, &at);
    const long long ns = std::chrono::duration_cast<std::chrono::nanoseconds>(left).count() + at.tv_nsec;
    at.tv_sec += static_cast<time_t>(ns / 1000000000);
    at.tv_nsec = static_cast<long>(ns % 1000000000);
    return at;
}

/// Sends `frame` before `deadline` or `stop`: false when the queue stayed full.
bool mqSend(const Queue& q, const Bytes& frame, Clock::time_point deadline, const std::atomic<bool>* stop)
{
    for (;;) {
        const timespec at = slice(deadline);
        if (::mq_timedsend(q.get(), reinterpret_cast<const char*>(frame.data()), frame.size(), 0, &at) == 0) return true;
        if (errno == EMSGSIZE) throw Error("frame larger than the messages of the message queue");
        if (errno != ETIMEDOUT && errno != EINTR) fail("mq_timedsend");
        if ((stop && *stop) || Clock::now() >= deadline) return false;
    }
}

/// Receives a frame before `deadline` or `stop`: false when none came.
bool mqReceive(const Queue& q, Bytes& frame, Clock::time_point deadline, const std::atomic<bool>* stop)
{
    frame.resize(q.messageSize());
    for (;;) {
        const timespec at = slice(deadline);
        const ssize_t n = ::mq_timedreceive(q.get(), reinterpret_cast<char*>(frame.data()), frame.size(), nullptr, &at);
        if (n >= 0) {
            frame.resize(static_cast<std::size_t>(n));
            return true;
        }
        if (errno != ETIMEDOUT && errno != EINTR) fail("mq_timedreceive");
        if ((stop && *stop) || Clock::now() >= deadline) return false;
    }
}
#endif

// Clients.

/// Client exchanging whole frames, for calls made from several threads at once: frames are sent one
/// at a time; one waiting call at a time reads the replies, handing each to the call of its id (a
/// table of the calls waiting). The connection is dropped on a failure, once no call reads it.
class FrameChannel : public Channel {
public:
    Bytes exchange(const Bytes& frame, bool wait, std::chrono::milliseconds timeout) override
    {
        const Clock::time_point deadline = Clock::now() + timeout;
        const std::uint32_t id = header(frame).id;
        std::unique_lock<std::mutex> lock(mutex_);
        // Waiting before the frame is sent: its reply may be read by another call.
        if (wait) waiting_[id];
        try {
            if (broken_ && !reading_) {
                drop();
                broken_ = false;
            }
            open(deadline);
            send(frame, deadline);
        } catch (...) {
            waiting_.erase(id);
            broken_ = true;
            throw;
        }
        if (!wait) return {};
        for (;;) {
            auto found = waiting_.find(id);
            if (found->second) {
                Bytes reply = std::move(*found->second);
                waiting_.erase(found);
                return reply;
            }
            if (Clock::now() >= deadline) {
                // Its reply, coming later, is skipped.
                waiting_.erase(found);
                throw Error("no reply within " + std::to_string(timeout.count()) + " ms");
            }
            if (reading_) {
                ready_.wait_until(lock, deadline);
                continue;
            }
            reading_ = true;
            lock.unlock();
            Bytes reply;
            bool got = false;
            try {
                got = receive(reply, deadline);
            } catch (...) {
                lock.lock();
                reading_ = false;
                broken_ = true;
                waiting_.erase(id);
                ready_.notify_all();
                throw;
            }
            lock.lock();
            reading_ = false;
            if (got) {
                const auto to = waiting_.find(header(reply).id);
                if (to != waiting_.end()) to->second = std::move(reply);
            }
            ready_.notify_all();
        }
    }

protected:
    /// Called with `mutex_` held, as `send` and `drop`; `receive` is called without it, by one call
    /// at a time.
    virtual void open(Clock::time_point deadline) = 0;
    virtual void send(const Bytes& frame, Clock::time_point deadline) = 0;
    virtual bool receive(Bytes& frame, Clock::time_point deadline) = 0;
    virtual void drop() = 0;

    /// Held to send.
    std::mutex mutex_;

private:
    std::condition_variable ready_;
    /// Calls waiting for their reply, by id: the reply once read.
    std::map<std::uint32_t, std::optional<Bytes>> waiting_;
    bool reading_ = false;
    bool broken_ = false;
};

class TcpChannel final : public FrameChannel {
public:
    explicit TcpChannel(std::string address) : address_(std::move(address)) {}

private:
    void open(Clock::time_point deadline) override
    {
        if (fd_) return;
        fd_ = openSocket(address_, SOCK_STREAM, false, deadline);
        in_ = std::make_unique<Input>(fd_.get());
    }
    void send(const Bytes& frame, Clock::time_point deadline) override
    {
        sendAll(fd_.get(), frame.data(), frame.size(), deadline);
    }
    bool receive(Bytes& frame, Clock::time_point deadline) override { return readFrame(*in_, frame, deadline, nullptr); }
    void drop() override
    {
        in_.reset();
        fd_.reset();
    }

    std::string address_;
    Fd fd_;
    std::unique_ptr<Input> in_;
};

class UdpChannel final : public FrameChannel {
public:
    explicit UdpChannel(std::string address) : address_(std::move(address)) {}

private:
    void open(Clock::time_point) override
    {
        if (!fd_) fd_ = openSocket(address_, SOCK_DGRAM, false);
    }
    void send(const Bytes& frame, Clock::time_point) override
    {
        if (frame.size() > maxDatagram) throw Error("frame too large for a datagram");
        if (::send(fd_.get(), frame.data(), frame.size(), sendFlags) < 0) fail("send");
    }
    bool receive(Bytes& frame, Clock::time_point deadline) override
    {
        if (!await(fd_.get(), deadline, nullptr)) return false;
        frame.resize(65536);
        const ssize_t n = ::recv(fd_.get(), frame.data(), frame.size(), 0);
        if (n < 0) fail("recv");
        frame.resize(static_cast<std::size_t>(n));
        return true;
    }
    void drop() override { fd_.reset(); }

    std::string address_;
    Fd fd_;
};

/// One POST per call, on a connection of its own (calls from several threads at once share nothing).
class HttpChannel final : public Channel {
public:
    HttpChannel(std::string address, std::string path) : address_(std::move(address)), path_(std::move(path)) {}

    Bytes exchange(const Bytes& frame, bool wait, std::chrono::milliseconds timeout) override
    {
        const Clock::time_point deadline = Clock::now() + timeout;
        Fd fd = openSocket(address_, SOCK_STREAM, false, deadline);
        sendAll(fd.get(),
                "POST " + path_ + " HTTP/1.1\r\nHost: " + split(address_).host +
                    "\r\nContent-Type: application/octet-stream\r\nContent-Length: " + std::to_string(frame.size()) +
                    "\r\nConnection: close\r\n\r\n",
                deadline);
        sendAll(fd.get(), frame.data(), frame.size(), deadline);
        Input in(fd.get());
        std::string head;
        if (!in.until("\r\n\r\n", head, 16384, deadline, nullptr)) throw Error("no HTTP response in time");
        const std::string status = head.size() > 12 ? head.substr(9, 3) : "";
        Bytes reply;
        if (!in.take(contentLength(head), reply, deadline, nullptr)) throw Error("no HTTP response in time");
        if (status != "200" && status != "204") throw Error("HTTP " + status + " " + std::string(reply.begin(), reply.end()));
        if (!wait) return {};
        if (status != "200" || header(reply).id != header(frame).id)
            throw Error("no reply within " + std::to_string(timeout.count()) + " ms");
        return reply;
    }

private:
    std::string address_;
    std::string path_;
};

class WebSocketChannel final : public FrameChannel {
public:
    WebSocketChannel(std::string address, std::string path)
        : address_(std::move(address)), path_(std::move(path)), random_(std::random_device()())
    {
    }

private:
    void open(Clock::time_point deadline) override
    {
        if (fd_) return;
        fd_ = openSocket(address_, SOCK_STREAM, false, deadline);
        in_ = std::make_unique<Input>(fd_.get());
        std::uint8_t nonce[16];
        for (std::uint8_t& b : nonce) b = static_cast<std::uint8_t>(random_() & 0xff);
        const std::string key = base64(nonce, sizeof nonce);
        sendAll(fd_.get(), "GET " + path_ + " HTTP/1.1\r\nHost: " + split(address_).host +
                               "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key +
                               "\r\nSec-WebSocket-Version: 13\r\n\r\n",
                deadline);
        std::string head;
        if (!in_->until("\r\n\r\n", head, 16384, deadline, nullptr)) throw Error("no WebSocket handshake in time");
        if (head.compare(0, 12, "HTTP/1.1 101") != 0 || headerValue(head, "sec-websocket-accept") != acceptKey(key))
            throw Error("WebSocket handshake refused");
    }
    void send(const Bytes& frame, Clock::time_point deadline) override
    {
        sendAll(fd_.get(), wsFrame(binary, frame.data(), frame.size(), &random_), deadline);
    }
    bool receive(Bytes& frame, Clock::time_point deadline) override
    {
        // Pongs are sent as the calls are, under mutex_ (which also guards the mask's random numbers).
        return wsRead(fd_.get(), *in_, frame, &random_, deadline, nullptr, &mutex_);
    }
    void drop() override
    {
        in_.reset();
        fd_.reset();
    }

    std::string address_;
    std::string path_;
    std::mt19937 random_;
    Fd fd_;
    std::unique_ptr<Input> in_;
};

/// Opens the segment made by the server (waiting for it), writes the calls ring, reads the replies ring.
class ShmChannel final : public FrameChannel {
public:
    explicit ShmChannel(const std::string& address) : name_(shmName(address)) {}

private:
    void open(Clock::time_point deadline) override
    {
        if (!mapping_ && !waitFor([this] { return attach(); }, deadline, nullptr))
            throw Error("no shared memory " + name_);
    }
    bool attach()
    {
        const Fd fd(::shm_open(name_.c_str(), O_RDWR, 0));
        struct stat st {};
        if (!fd || ::fstat(fd.get(), &st) != 0 || static_cast<std::size_t>(st.st_size) < shmSize(0)) return false;
        std::unique_ptr<Mapping> m = map(fd.get(), static_cast<std::size_t>(st.st_size));
        if (load(m->data()) != shmMagic || shmSize(m->capacity()) != static_cast<std::size_t>(st.st_size)) return false;
        mapping_ = std::move(m);
        return true;
    }
    void send(const Bytes& frame, Clock::time_point deadline) override
    {
        Ring calls = mapping_->ring(0);
        if (!waitFor([&] { return calls.push(frame); }, deadline, nullptr)) throw Error("shared memory ring full");
    }
    bool receive(Bytes& frame, Clock::time_point deadline) override
    {
        Ring replies = mapping_->ring(1);
        return waitFor([&] { return replies.pop(frame); }, deadline, nullptr);
    }
    void drop() override { mapping_.reset(); }

    std::string name_;
    std::unique_ptr<Mapping> mapping_;
};

#if defined(__linux__)
/// Opens the queues made by the server (waiting for them), sends on `<name>.call`, receives on `<name>.reply`.
class MqChannel final : public FrameChannel {
public:
    explicit MqChannel(const std::string& address) : name_(shmName(address)) {}

private:
    void open(Clock::time_point deadline) override
    {
        if (!calls_ && !waitFor([this] { return attach(); }, deadline, nullptr))
            throw Error("no message queues " + name_ + ".call, " + name_ + ".reply");
    }
    bool attach()
    {
        Queue calls(::mq_open((name_ + ".call").c_str(), O_WRONLY));
        Queue replies(::mq_open((name_ + ".reply").c_str(), O_RDONLY));
        if (!calls || !replies) return false;
        calls_ = std::move(calls);
        replies_ = std::move(replies);
        return true;
    }
    void send(const Bytes& frame, Clock::time_point deadline) override
    {
        if (!mqSend(calls_, frame, deadline, nullptr)) throw Error("message queue " + name_ + ".call full");
    }
    bool receive(Bytes& frame, Clock::time_point deadline) override { return mqReceive(replies_, frame, deadline, nullptr); }
    void drop() override
    {
        calls_.reset();
        replies_.reset();
    }

    std::string name_;
    Queue calls_;
    Queue replies_;
};
