#pragma once

// Wire format of the calls between binaries, shared with the Python peers (python/*/wire.py).
// Little-endian; bool and char: 1 byte; string, bytes: u32 length + bytes; vector, list, set:
// u32 count + items; array: its items; optional: u8 flag + value; map: u32 count + key, value;
// struct: its fields in order; enum, bitmask: its underlying type. Bounds (`string<16>`, `vector<T, 8>`) are
// checked when encoding and decoding.
// Frame: 16-byte header (magic "SCF1", u8 kind, u8 flags, u16 message, u32 call id, u32 payload
// length), then the payload: the inputs of a call, or the result then the outputs of a reply, or
// the error text, then for a declared exception (flag `typed`) its u16 index in the `raises` of the
// message and its fields.

#include <algorithm>
#include <array>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <exception>
#include <iostream>
#include <list>
#include <map>
#include <optional>
#include <set>
#include <stdexcept>
#include <string>
#include <type_traits>
#include <utility>
#include <vector>

namespace {{ _project_identifier() }}::remote {

/// Failure of a remote call: transport, timeout, malformed frame, or error sent back by the peer.
class Error : public std::runtime_error {
public:
    using std::runtime_error::runtime_error;
};

using Bytes = std::vector<std::uint8_t>;

#if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__)
constexpr bool littleEndian() { return __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__; }
#else
inline bool littleEndian()
{
    const std::uint16_t one = 1;
    std::uint8_t first = 0;
    std::memcpy(&first, &one, 1);
    return first == 1;
}
#endif

struct Header;
class Writer;
inline Bytes frame(Header h, Writer&& payload);

class Writer {
public:
    Writer() = default;

    /// A writer whose bytes become a frame without being copied (frame(Header, Writer&&)): room is kept
    /// for the header in front of the payload.
    static Writer framed()
    {
        Writer w;
        w.bytes_.reserve(256);
        w.bytes_.resize(headroom);
        w.base_ = headroom;
        return w;
    }

    void raw(const void* data, std::size_t size)
    {
        if (!size) return;
        const std::size_t at = bytes_.size();
        bytes_.resize(at + size);
        std::memcpy(bytes_.data() + at, data, size);
    }

    void reserve(std::size_t size) { bytes_.reserve(bytes_.size() + size); }

    template <class T>
    void number(T value)
    {
        static_assert(std::is_arithmetic_v<T>, "numbers only");
        std::uint8_t b[sizeof(T)];
        std::memcpy(b, &value, sizeof(T));
        if (!littleEndian()) std::reverse(b, b + sizeof(T));
        raw(b, sizeof(T));
    }

    void count(std::size_t n)
    {
        if (n > 0xffffffffu) throw Error("too many items to encode");
        number(static_cast<std::uint32_t>(n));
    }

    /// The encoded bytes (of a writer not framed()).
    const Bytes& bytes() const { return bytes_; }

    /// Bytes written (the payload of a framed() writer).
    std::size_t size() const { return bytes_.size() - base_; }

private:
    friend Bytes frame(Header h, Writer&& payload);
    static constexpr std::size_t headroom = 16;

    Bytes bytes_;
    std::size_t base_ = 0;
};

class Reader {
public:
    Reader(const std::uint8_t* data, std::size_t size) : data_(data), size_(size) {}
    explicit Reader(const Bytes& bytes) : Reader(bytes.data(), bytes.size()) {}

    void raw(void* out, std::size_t size)
    {
        if (size > remaining()) throw Error("truncated frame");
        if (size) std::memcpy(out, data_ + pos_, size);
        pos_ += size;
    }

    template <class T>
    T number()
    {
        static_assert(std::is_arithmetic_v<T>, "numbers only");
        std::uint8_t b[sizeof(T)];
        raw(b, sizeof(T));
        if (!littleEndian()) std::reverse(b, b + sizeof(T));
        T value;
        std::memcpy(&value, b, sizeof(T));
        return value;
    }

    std::size_t count() { return number<std::uint32_t>(); }

    std::size_t remaining() const { return size_ - pos_; }

    /// Containers nested deeper (recursive types) are refused before the stack overflows.
    static constexpr std::size_t maxDepth = 100;
    /// More items than bytes left (each item takes a byte but those of empty structs) beyond
    /// this many is a broken or hostile frame.
    static constexpr std::size_t maxEmptyItems = 1u << 16;

    /// The count of a container's items.
    std::size_t items()
    {
        const std::size_t n = count();
        if (n > remaining() && n > maxEmptyItems) throw Error("count over the frame");
        return n;
    }

    /// Held while a container is decoded: one level deeper.
    class Nested {
    public:
        explicit Nested(Reader& r) : r_(r)
        {
            if (++r_.depth_ > maxDepth) {
                --r_.depth_;
                throw Error("frame nested too deep");
            }
        }
        ~Nested() { --r_.depth_; }
        Nested(const Nested&) = delete;
        Nested& operator=(const Nested&) = delete;

    private:
        Reader& r_;
    };

    /// Throws unless everything was read.
    void end() const
    {
        if (pos_ != size_) throw Error("unexpected bytes at the end of a frame");
    }

private:
    const std::uint8_t* data_;
    std::size_t size_;
    std::size_t pos_ = 0;
    std::size_t depth_ = 0;
};

// encode(Writer&, const T&) and decode(Reader&, T&) for each type; those of the types of the
// project are in codec.hpp.

/// Throws when a string, bytes or container is over its bound (`string<16>`, `vector<T, 8>`).
template <class T>
void checkBound(const T& v, std::size_t max)
{
    if (v.size() > max)
        throw Error("size " + std::to_string(v.size()) + " over the bound of " + std::to_string(max));
}

inline void encode(Writer& w, bool v) { w.number<std::uint8_t>(v ? 1 : 0); }
inline void decode(Reader& r, bool& v) { v = r.number<std::uint8_t>() != 0; }

inline void encode(Writer& w, char v) { w.number(static_cast<std::uint8_t>(v)); }
inline void decode(Reader& r, char& v) { v = static_cast<char>(r.number<std::uint8_t>()); }

template <class T>
using IsNumber = std::enable_if_t<std::is_arithmetic_v<T> && !std::is_same_v<T, bool> && !std::is_same_v<T, char>, int>;

template <class T, IsNumber<T> = 0>
void encode(Writer& w, T v)
{
    w.number(v);
}
template <class T, IsNumber<T> = 0>
void decode(Reader& r, T& v)
{
    v = r.number<T>();
}

template <class E, std::enable_if_t<std::is_enum_v<E>, int> = 0>
void encode(Writer& w, E v)
{
    w.number(static_cast<std::underlying_type_t<E>>(v));
}
template <class E, std::enable_if_t<std::is_enum_v<E>, int> = 0>
void decode(Reader& r, E& v)
{
    v = static_cast<E>(r.number<std::underlying_type_t<E>>());
}

inline void encode(Writer& w, const std::string& v)
{
    w.count(v.size());
    w.raw(v.data(), v.size());
}
inline void decode(Reader& r, std::string& v)
{
    const std::size_t n = r.count();
    if (n > r.remaining()) throw Error("truncated frame");
    v.resize(n);
    r.raw(v.data(), n);
}

inline void encode(Writer& w, const Bytes& v)
{
    w.count(v.size());
    w.raw(v.data(), v.size());
}
inline void decode(Reader& r, Bytes& v)
{
    const std::size_t n = r.count();
    if (n > r.remaining()) throw Error("truncated frame");
    v.resize(n);
    r.raw(v.data(), n);
}

/// Numbers whose items are laid out in memory as on the wire (little-endian host): sequences of them are
/// copied at once.
template <class T>
constexpr bool isRawNumber()
{
    return std::is_arithmetic_v<T> && !std::is_same_v<T, bool>;
}

template <class T>
void encode(Writer& w, const std::vector<T>& v)
{
    w.count(v.size());
    if constexpr (isRawNumber<T>()) {
        if (littleEndian()) {
            w.raw(v.data(), v.size() * sizeof(T));
            return;
        }
    }
    for (const T& x : v) encode(w, x);
}
template <class T>
void decode(Reader& r, std::vector<T>& v)
{
    const Reader::Nested nested(r);
    const std::size_t n = r.items();
    if constexpr (isRawNumber<T>()) {
        if (littleEndian()) {
            if (n > r.remaining() / sizeof(T)) throw Error("truncated frame");
            v.resize(n);
            r.raw(v.data(), n * sizeof(T));
            return;
        }
    }
    v.clear();
    v.reserve(std::min(n, r.remaining() / sizeof(T)));
    for (std::size_t i = 0; i < n; ++i) {
        v.emplace_back();
        decode(r, v.back());
    }
}

template <class T>
void encode(Writer& w, const std::list<T>& v)
{
    w.count(v.size());
    for (const T& x : v) encode(w, x);
}
template <class T>
void decode(Reader& r, std::list<T>& v)
{
    const Reader::Nested nested(r);
    const std::size_t n = r.items();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        T x{};
        decode(r, x);
        v.push_back(std::move(x));
    }
}

template <class T>
void encode(Writer& w, const std::set<T>& v)
{
    w.count(v.size());
    for (const T& x : v) encode(w, x);
}
template <class T>
void decode(Reader& r, std::set<T>& v)
{
    const Reader::Nested nested(r);
    const std::size_t n = r.items();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        T x{};
        decode(r, x);
        v.insert(std::move(x));
    }
}

template <class T, std::size_t N>
void encode(Writer& w, const std::array<T, N>& v)
{
    if constexpr (isRawNumber<T>()) {
        if (littleEndian()) {
            w.raw(v.data(), N * sizeof(T));
            return;
        }
    }
    for (const T& x : v) encode(w, x);
}
template <class T, std::size_t N>
void decode(Reader& r, std::array<T, N>& v)
{
    if constexpr (isRawNumber<T>()) {
        if (littleEndian()) {
            r.raw(v.data(), N * sizeof(T));
            return;
        }
    }
    for (T& x : v) decode(r, x);
}

template <class T>
void encode(Writer& w, const std::optional<T>& v)
{
    w.number<std::uint8_t>(v ? 1 : 0);
    if (v) encode(w, *v);
}
template <class T>
void decode(Reader& r, std::optional<T>& v)
{
    const Reader::Nested nested(r);
    if (r.number<std::uint8_t>()) {
        T x{};
        decode(r, x);
        v = std::move(x);
    } else {
        v.reset();
    }
}

template <class K, class V>
void encode(Writer& w, const std::map<K, V>& v)
{
    w.count(v.size());
    for (const auto& [key, value] : v) {
        encode(w, key);
        encode(w, value);
    }
}
template <class K, class V>
void decode(Reader& r, std::map<K, V>& v)
{
    const Reader::Nested nested(r);
    const std::size_t n = r.items();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        K key{};
        V value{};
        decode(r, key);
        decode(r, value);
        v.emplace(std::move(key), std::move(value));
    }
}

/// Frame header.
struct Header {
    static constexpr std::size_t size = 16;
    /// Largest payload accepted.
    static constexpr std::uint32_t maxLength = 64u << 20;
    enum Kind : std::uint8_t { call = 1, reply = 2, error = 3 };
    /// Flag of a call waiting for its reply.
    static constexpr std::uint8_t wantReply = 1;
    /// Flag of an error frame holding a declared exception.
    static constexpr std::uint8_t typed = 2;

    std::uint8_t kind = call;
    std::uint8_t flags = 0;
    std::uint16_t message = 0;
    std::uint32_t id = 0;
    std::uint32_t length = 0;
};

namespace detail {
/// Writes the 16 bytes of `h` (its length set to `length`) at `out`.
inline void putHeader(std::uint8_t* out, Header h, std::size_t length)
{
    if (length > Header::maxLength) throw Error("frame too large");
    h.length = static_cast<std::uint32_t>(length);
    const auto put = [&out](auto value) {
        std::uint8_t b[sizeof(value)];
        std::memcpy(b, &value, sizeof(value));
        if (!littleEndian()) std::reverse(b, b + sizeof(value));
        std::memcpy(out, b, sizeof(value));
        out += sizeof(value);
    };
    std::memcpy(out, "SCF1", 4);
    out += 4;
    put(h.kind);
    put(h.flags);
    put(h.message);
    put(h.id);
    put(h.length);
}
} // namespace detail

inline Bytes frame(Header h, const Bytes& payload)
{
    Bytes out(Header::size + payload.size());
    detail::putHeader(out.data(), h, payload.size());
    if (!payload.empty()) std::memcpy(out.data() + Header::size, payload.data(), payload.size());
    return out;
}

/// The frame of the payload written by `payload`, built in its own buffer when it is framed().
inline Bytes frame(Header h, Writer&& payload)
{
    if (payload.base_ != Header::size) return frame(h, payload.bytes_);
    detail::putHeader(payload.bytes_.data(), h, payload.size());
    return std::move(payload.bytes_);
}

/// Header of a frame; `size` may hold the header only.
inline Header header(const std::uint8_t* data, std::size_t size)
{
    if (size < Header::size || std::memcmp(data, "SCF1", 4) != 0) throw Error("not a frame");
    Reader r(data + 4, Header::size - 4);
    Header h;
    h.kind = r.number<std::uint8_t>();
    h.flags = r.number<std::uint8_t>();
    h.message = r.number<std::uint16_t>();
    h.id = r.number<std::uint32_t>();
    h.length = r.number<std::uint32_t>();
    if (h.length > Header::maxLength) throw Error("frame too large");
    return h;
}

inline Header header(const Bytes& frame) { return header(frame.data(), frame.size()); }

/// Reads the payload of a whole frame, without copying it (`frame` must outlive the reader).
inline Reader payloadReader(const Bytes& frame)
{
    const Header h = header(frame);
    if (frame.size() != Header::size + h.length) throw Error("frame of the wrong size");
    return Reader(frame.data() + Header::size, h.length);
}

/// The payload of a whole frame.
inline Bytes payload(const Bytes& frame)
{
    payloadReader(frame);
    return Bytes(frame.begin() + Header::size, frame.end());
}

/// A declared exception of a remote call (`index` in the `raises` of its message), encoded.
class Raised : public Error {
public:
    Raised(std::uint16_t index, Bytes value, const std::string& what)
        : Error(what), index(index), value(std::move(value))
    {
    }

    std::uint16_t index;
    Bytes value;
};

inline Bytes errorFrame(std::uint32_t id, const std::string& message, const Raised* raised = nullptr)
{
    Writer w = Writer::framed();
    encode(w, message);
    Header h;
    h.kind = Header::error;
    h.id = id;
    if (raised) {
        h.flags = Header::typed;
        w.number(raised->index);
        w.raw(raised->value.data(), raised->value.size());
    }
    return frame(h, std::move(w));
}

/// Answers a call frame through `handle(message, reader, writer) -> bool` (false: unknown message):
/// the reply frame, or nothing when the call wants none. Failures are sent back as error frames,
/// or written to std::cerr when no reply is wanted.
template <class Handle>
std::optional<Bytes> respond(const Bytes& call, Handle&& handle)
{
    const Header h = header(call);
    const bool wanted = (h.flags & Header::wantReply) != 0;
    std::string failure;
    std::optional<Raised> raised;
    try {
        if (h.kind != Header::call) throw Error("not a call");
        Reader reader = payloadReader(call);
        Writer writer = Writer::framed();
        if (!handle(h.message, reader, writer)) throw Error("unknown message " + std::to_string(h.message));
        if (!wanted) return std::nullopt;
        Header r;
        r.kind = Header::reply;
        r.message = h.message;
        r.id = h.id;
        return frame(r, std::move(writer));
    } catch (const Raised& e) {
        failure = e.what();
        raised = e;
    } catch (const std::exception& e) {
        failure = e.what();
    } catch (...) {
        failure = "unknown exception";
    }
    if (wanted) return errorFrame(h.id, failure, raised ? &*raised : nullptr);
    std::cerr << "remote call " << h.message << " failed: " << failure << '\n';
    return std::nullopt;
}

} // namespace {{ _project_identifier() }}::remote
