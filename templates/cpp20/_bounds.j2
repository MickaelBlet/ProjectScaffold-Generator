{% macro bounds(t=none, v=none, depth=none) %}
{#
  C++ statements, on one line, checking the bounds of value `v` of type `t` (`string<16>`,
  `vector<T, 8>`, through aliases; structs check their own fields): nothing when unbounded.
  Parameters: t, v, depth (of the loops, from 0).
#}
{% set item = 'x' ~ depth ~ '_' %}
{% set next = depth + 1 %}
{% filter inline %}
{% if t.kind == 'primitive' %}
  {% if t.max is not none %}checkBound({{ v }}, {{ t.max }});{% endif %}
{% elif t.kind == 'ref' %}
  {% if t.typeKind == 'alias' %}{{ bounds(t=typeByKey[t.key].type, v=v, depth=depth) }}{% endif %}
{% elif t.kind == 'optional' %}
  {% set inner = bounds(t=t.of, v='*' ~ v, depth=depth) %}
  {% if inner != '' %}if ({{ v }}) { {{ inner }} }{% endif %}
{% else %}
  {# map, array, vector, list, set: the size, then each element #}
  {% set sized = t.max is not none and t.kind != 'array' %}
  {% if t.kind == 'map' %}
    {% set inner = bounds(t=t.key, v=item ~ '.first', depth=next) ~ bounds(t=t.value, v=item ~ '.second', depth=next) %}
  {% else %}
    {% set inner = bounds(t=t.of, v=item, depth=next) %}
  {% endif %}
  {% if sized %}checkBound({{ v }}, {{ t.max }});{% endif %}
  {% if inner != '' %}
    {% if sized %}{{ ' ' }}{% endif %}
    for (const auto& {{ item }} : {{ v }}) { {{ inner }} }
  {% endif %}
{% endif %}
{% endfilter %}
{% endmacro %}
