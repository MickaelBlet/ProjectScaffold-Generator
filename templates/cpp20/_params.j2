{% macro params(params=none) %}
{% from '_id.j2' import id as _id %}
{% from '_scalar.j2' import scalar as _scalar %}
{% from '_type.j2' import type as _type %}
{#
  Parameter list: `in` by value for scalars (`const` when marked so), else `const T&`;
  `out` / `inout` as `T&`. Parameter: params.
#}
{% filter inline %}
{% for p in params %}
  {% if p.direction != 'in' %}
    {{ _type(t=p.type) }}&
  {% elif _scalar(t=p.type) == 'true' %}
    {% if p.const %}const {% endif %}{{ _type(t=p.type) }}
  {% else %}
    const {{ _type(t=p.type) }}&
  {% endif %}
  {{ ' ' ~ _id(name=p.name) }}{% if not loop.last %}, {% endif %}
{% endfor %}
{% endfilter %}
{% endmacro %}
