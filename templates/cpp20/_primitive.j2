{% macro primitive(name=none) %}
{#
  C++ type of a primitive of the model. Parameter: name.
#}
{% filter inline %}
{% if name in ['int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64'] %}
  std::{{ name }}_t
{% elif name == 'float32' %}
  float
{% elif name == 'float64' %}
  double
{% elif name == 'string' %}
  std::string
{% elif name == 'bytes' %}
  std::vector<std::uint8_t>
{% else %}
  {{ name }}
{% endif %}
{% endfilter %}
{% endmacro %}
