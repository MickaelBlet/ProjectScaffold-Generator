{% from '_id.j2' import id as _id %}
{% from '_includes.j2' import includes as _includes %}
{% from '_name.j2' import name as _name %}
{% from '_ns.j2' import ns as _ns %}
{% from '_primitive.j2' import primitive as _primitive %}
{% from '_type.j2' import type as _type %}
{% from '_value.j2' import value as _value %}
{% include '_banner.j2' %}
#pragma once

{{ _includes(e=item) }}
{%- filter user('includes') +%}
{% endfilter +%}

namespace {{ _ns(e=item) }} {

{{ item.description|doc_comment }}{##}

{% if item.kind == 'struct' %}
struct {{ _name(e=item) }} {
{% for f in item.fields %}
{{ f.description|doc_comment('    /// ') }}
    {{ _type(t=f.type) }} {{ _id(name=f.name) }}{% if f.hasDefault %} = {{ _value(v=f.default, t=f.type) }}{% else %}{}{% endif %};
{% endfor %}

    bool operator==(const {{ _name(e=item) }}&) const = default;
    {%+ filter user('members') +%}
    {%+ endfilter +%}
};
{% elif item.kind == 'exception' %}
struct {{ _name(e=item) }} : std::exception {
{% for f in item.fields %}
{{ f.description|doc_comment('    /// ') }}
    {{ _type(t=f.type) }} {{ _id(name=f.name) }}{% if f.hasDefault %} = {{ _value(v=f.default, t=f.type) }}{% else %}{}{% endif %};
{% endfor %}

    const char* what() const noexcept override { return "{{ item.name }}"; }
    {%+ filter user('members') +%}
    {%+ endfilter +%}
};
{% elif item.kind == 'enum' %}
enum class {{ _name(e=item) }} : {{ _primitive(name=item.underlying) }} {
{% for v in item['values'] %}
    {{ _id(name=v.name) }} = {{ v.value }},
{% endfor %}
};
{% elif item.kind == 'bitmask' %}
{% set name = _name(e=item) %}
{% set bits = _primitive(name=item.underlying) %}
enum class {{ name }} : {{ bits }} {
{% for f in item.flags %}
    {{ _id(name=f.name) }} = {{ bits }}{1} << {{ f.bit }},
{% endfor %}
};

constexpr {{ name }} operator|({{ name }} a, {{ name }} b)
{
    return static_cast<{{ name }}>(static_cast<{{ bits }}>(a) | static_cast<{{ bits }}>(b));
}
constexpr {{ name }} operator&({{ name }} a, {{ name }} b)
{
    return static_cast<{{ name }}>(static_cast<{{ bits }}>(a) & static_cast<{{ bits }}>(b));
}
constexpr {{ name }} operator^({{ name }} a, {{ name }} b)
{
    return static_cast<{{ name }}>(static_cast<{{ bits }}>(a) ^ static_cast<{{ bits }}>(b));
}
constexpr {{ name }} operator~({{ name }} a) { return static_cast<{{ name }}>(~static_cast<{{ bits }}>(a)); }
constexpr {{ name }}& operator|=({{ name }}& a, {{ name }} b) { return a = a | b; }
constexpr {{ name }}& operator&=({{ name }}& a, {{ name }} b) { return a = a & b; }
constexpr {{ name }}& operator^=({{ name }}& a, {{ name }} b) { return a = a ^ b; }
/// True when every flag of `flags` is set in `value`.
constexpr bool has({{ name }} value, {{ name }} flags) { return (value & flags) == flags; }
{% elif item.kind == 'union' %}
{% set name = _name(e=item) %}
{% set disc = _type(t=item.discriminator) %}
class {{ name }} {
public:
    /// Discriminator: selects the case held.
    {{ disc }} _d() const { return d_; }
{% for c in item.cases %}
{% set type = _type(t=c.type) %}
{% set id = _id(name=c.name) %}
{% set when %}{% for l in c.labels %}{{ _value(v=l, t=item.discriminator) }}, {% endfor %}{% if c.isDefault %}the values no case lists{% endif %}{% endset %}
{# Held for these labels. #}

{{ c.description|doc_comment('    /// ') }}
    /// Held for {{ when.rsplit(', ', 1)|join('') }}; reading another case throws std::bad_variant_access.
    const {{ type }}& {{ id }}() const { return std::get<{{ c.index }}>(v_); }
    {{ type }}& {{ id }}() { return std::get<{{ c.index }}>(v_); }
    void {{ id }}({{ type }} value, {{ disc }} d{% if c.label != none %} = {{ _value(v=c.label, t=item.discriminator) }}{% endif %})
    {
        d_ = d;
        v_.emplace<{{ c.index }}>(std::move(value));
    }
{% endfor %}
{% if not item.hasDefault %}

    /// No case, for the discriminator values no case lists.
    void _default({{ disc }} d)
    {
        d_ = d;
        v_.emplace<0>();
    }
{% endif %}

    bool operator==(const {{ name }}&) const = default;
    {%+ filter user('members') +%}
    {%+ endfilter +%}

private:
{% if item.cases|length > 0 and item.cases[0].label != none %}
    {{ disc }} d_ = {{ _value(v=item.cases[0].label, t=item.discriminator) }};
    std::variant<std::monostate{% for c in item.cases %}, {{ _type(t=c.type) }}{% endfor %}> v_{std::in_place_index<1>};
{% else %}
    {{ disc }} d_{};
    std::variant<std::monostate{% for c in item.cases %}, {{ _type(t=c.type) }}{% endfor %}> v_;
{% endif %}
};
{% elif item.kind == 'alias' %}
using {{ _name(e=item) }} = {{ _type(t=item.type) }};
{% elif item.kind == 'primitive' %}
{% filter user('definition') +%}
using {{ _name(e=item) }} = void*; // TODO: native type of {{ item.name }}
{% endfilter +%}
{% endif %}

} // namespace {{ _ns(e=item) }}
