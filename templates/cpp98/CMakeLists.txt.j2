{% from '_main.j2' import main as _main %}
{% set ns = namespace() %}
# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.
{% set ns_ = project.ident|snake %}
cmake_minimum_required(VERSION 3.16)
project({{ ns_ }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 98)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

{% filter user('options') +%}
{% endfilter +%}

{% set ns.sources = 0 %}
{% for f in files %}
{% if '.cpp' in f %}
{% set ns.sources = (ns.sources + 1) %}
{% endif %}
{% endfor %}
{% if ns.sources > 0 %}
add_library({{ ns_ }}
{% for f in files %}
{% if '.cpp' in f %}
    {{ f }}
{% endif %}
{% endfor %}
)
set(SCAFFOLD_SCOPE PUBLIC)
{% else %}
add_library({{ ns_ }} INTERFACE)
set(SCAFFOLD_SCOPE INTERFACE)
{% endif %}
target_include_directories({{ ns_ }} ${SCAFFOLD_SCOPE} ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features({{ ns_ }} ${SCAFFOLD_SCOPE} cxx_std_98)

{% if remoteLinks|length > 0 or anyActive %}
# Threads of the {{ ([remoteLinks|length > 0 and 'transports (src/remote/transport.cpp)', anyActive and 'active modules (active.hpp)']|select|join(' and ')) }}.
find_package(Threads REQUIRED)
target_link_libraries({{ ns_ }} ${SCAFFOLD_SCOPE} Threads::Threads)
{% if remoteLinks|length > 0 %}
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries({{ ns_ }} ${SCAFFOLD_SCOPE} rt)
endif()
{% endif %}

{% endif %}
{% filter user('dependencies') +%}
{% for d in dependencies %}
{% set dep = d.name|snake %}
if(NOT TARGET {{ dep }} AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }}/CMakeLists.txt)
    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }} ${CMAKE_CURRENT_BINARY_DIR}/{{ dep }})
endif()
if(TARGET {{ dep }})
    target_link_libraries({{ ns_ }} ${SCAFFOLD_SCOPE} {{ dep }})
else()
    message(WARNING "dependency {{ d.name }} ({{ d.file }}) not found: generate it in ../{{ dep }}")
endif()
{% endfor %}
{% endfilter +%}
{% if modules|length > 0 %}
{% for system in systems %}
{% if system.binary %}
{% set exe = (ns_ ~ '_' ~ system.binary.name)|snake %}
{% else %}
{% set exe = ns_ ~ '_app' %}
{% endif %}

add_executable({{ exe }} src/{{ _main(system=system) }})
target_link_libraries({{ exe }} PRIVATE {{ ns_ }})
{% endfor %}
{% endif %}

{% filter user('end') +%}
{% endfilter +%}
