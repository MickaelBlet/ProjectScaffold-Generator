{% macro includes(e=none) %}
{% from '_header.j2' import header as _header %}
{% set ns = namespace() %}
{#
  `#include` lines of an entity: the standard headers of what it uses, then the headers of the
  types, interfaces, bases and modules it uses. Parameter: e.
#}
{% set root = project.ident|snake %}
{% set ns.std = [] %}
{% set ns.own = [] %}
{% for b in e.uses.builtins %}
  {% if b in ['int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64'] %}
    {% set ns.std = ns.std + ['<stdint.h>'] %}
  {% elif b == 'bytes' %}
    {% set ns.std = ns.std + ['<stdint.h>', '<vector>'] %}
  {% elif b in ['string', 'vector', 'list', 'set', 'map'] %}
    {% set ns.std = ns.std + ['<' ~ b ~ '>'] %}
  {% elif b == 'variant' %}
    {% set ns.std = ns.std + ['<stdexcept>'] %}
  {% elif b == 'exception' %}
    {% set ns.std = ns.std + ['<exception>'] %}
  {% endif %}
{% endfor %}
{% for t in e.uses.types %}
  {% set ns.own = ns.own + ['<' ~ _header(e=t) ~ '>'] %}
{% endfor %}
{% if e.entity == 'module' %}
  {% for base in e.bases %}
    {% set ns.own = ns.own + ['<' ~ _header(e=base) ~ '>'] %}
  {% endfor %}
  {% if e.active %}
    {% set ns.own = ns.own + ['<' ~ root ~ '/active.hpp>'] %}
  {% endif %}
  {% for p in e.ports %}
    {% if p.interface %}
      {% set ns.own = ns.own + ['<' ~ _header(e=p.interface) ~ '>'] %}
      {% if p.role == 'out' %}
        {% set ns.own = ns.own + ['<' ~ root ~ '/ports.hpp>'] %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
{# Optional, Array and Make (default values) in every header. #}
{% set ns.std = ns.std + ['<scaffold/support.hpp>'] %}
{% if e.entity == 'module' or e.entity == 'system' %}
  {% for c in e.instances %}
    {% set ns.own = ns.own + ['<' ~ _header(e=c) ~ '>'] %}
    {% if c.abstract %}
      {% set ns.std = ns.std + ['<cstddef>'] %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set self_ = '<' ~ _header(e=e) ~ '>' %}
{% set ns.std = ns.std|unique|list|sort %}
{% set ns.own = ns.own|unique|list|sort %}
{% for header in ns.std %}
#include {{ header }}
{% endfor %}
{% for header in ns.own %}
{% if header != self_ %}
#include {{ header }}
{% endif %}
{% endfor %}
{%+ endmacro %}
