{% macro init(m=none) %}
{% from '_accessor.j2' import accessor as _accessor %}
{% from '_member.j2' import member as _member %}
{% from '_value.j2' import value as _value %}
{% set ns = namespace() %}
{#
  Member initializer list of a module's constructor (no member initializers in C++98): the
  adapters of its in ports, its abstract children (null until created), its attributes (their
  default, else value-initialized), in the order they are declared. Parameter: m.
#}
{% set ns.inits = '' -%}
{%- for p in m.ports -%}
  {%- if p.role == 'in' and (p.interface and p.delegates|length == 0) -%}
    {%- set ns.inits = ns.inits ~ '|' ~ p.name ~ 'In_(*this)' -%}
  {%- endif -%}
{%- endfor -%}
{%- for c in m.instances -%}
  {%- if c.abstract -%}
    {%- set accessor -%}
      {{- _accessor(name=c.name) -}}
    {%- endset -%}
    {%- set ns.inits = ns.inits ~ '|' ~ accessor ~ '_(NULL)' -%}
  {%- endif -%}
{%- endfor -%}
{%- for a in m.attributes -%}
  {%- if not a.static -%}
    {%- set init -%}
      {{- _member(name=a.name) -}}
      {{- '(' -}}
      {%- if a.hasDefault -%}
        {{- _value(v=a.default, t=a.type) -}}
      {%- endif -%}
      {{- ')' -}}
    {%- endset -%}
    {%- set ns.inits = ns.inits ~ '|' ~ init -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.inits != '' -%}
  {{- (' : ' ~ ns.inits)|replace('|', '', 1)|replace('|', ', ') -}}
{%- endif %}
{%+ endmacro %}
