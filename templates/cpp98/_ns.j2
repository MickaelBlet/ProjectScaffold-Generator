{% macro ns(e=none) %}
{#
  Namespace of an entity, without leading `::`: the project's (`robot`), a dependency's
  (`common`), a module's parents (`robot::core`), or for a type of a module the module
  (`robot::core::sensor`). Parameter: e.
#}
{% set root = project.ident|snake -%}
{%- if e.entity == 'type' or e.entity == 'interface' -%}
  {%- if e.dependency -%}
    {{- e.dependency|snake -}}
  {%- else -%}
    {{- root -}}
  {%- endif -%}
  {#- A type of a module: in the namespace of the module's content. -#}
  {%- if e.entity == 'type' -%}
    {%- for part in e.scope -%}
      {{- '::' -}}
      {{- part|snake -}}
    {%- endfor -%}
  {%- endif -%}
{%- elif e.entity == 'module' -%}
  {{- root -}}
  {%- for parent in e.namespace -%}
    {%- set part = parent|snake -%}
    {{- '::' ~ part -}}
  {%- endfor -%}
{%- else -%}
  {{- root -}}
{%- endif %}
{%+ endmacro %}
