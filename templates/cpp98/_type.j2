{% macro type(t=none) %}
{% from '_id.j2' import id as _id %}
{% from '_primitive.j2' import primitive as _primitive %}
{#
  C++ spelling of a type reference: `std::map<std::string, ::common::Pose>`, `::robot::core::sensor::Mode`
  for a type of a module; `void` for none.
  Template arguments are spaced where C++98 needs it: `< ::a::B>` (`<:` is a digraph) and
  `vector<int> >` (`>>` is a shift). Parameter: t.
#}
{% filter inline %}
{% if t == none %}
  void
{% elif t.kind == 'primitive' %}
  {{ _primitive(name=t.name) }}
{% elif t.kind == 'ref' %}
  ::{{ (t.dependency or project.ident)|snake }}
  {% for part in t.scope %}::{{ part|snake }}{% endfor %}
  ::{{ _id(name=t.name) }}
{% else %}
  {% if t.kind == 'map' %}
    {% set inner = type(t=t.key) ~ ', ' ~ type(t=t.value) %}
  {% elif t.kind == 'array' %}
    {% set inner = type(t=t.of) ~ ', ' ~ t.size %}
  {% else %}
    {% set inner = type(t=t.of) %}
  {% endif %}
  {% if t.kind == 'array' %}
    ::scaffold::Array<
  {% elif t.kind == 'optional' %}
    ::scaffold::Optional<
  {% else %}
    std::{{ t.kind }}<
  {% endif %}
  {% if inner.startswith(':') %} {% endif %}{{ inner }}{% if inner.endswith('>') %} {% endif %}>
{% endif %}
{% endfilter %}
{% endmacro %}
