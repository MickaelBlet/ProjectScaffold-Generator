/// {{ _name(e=item) }} of another binary: each call is encoded and sent over the channel
/// given to open(), and waits for its reply when it has a result or the link acknowledges calls.
class {{ item.name }}Proxy : public {{ _qualified(e=item) }} {
public:
    /// Sends the calls over `channel` (deleted with the proxy); `ack`: every call waits for its
    /// reply, within `timeoutMs` milliseconds.
    void open(Channel* channel, bool ack = false, long timeoutMs = 5000) { caller_.open(channel, ack, timeoutMs); }
{% for msg in item.messages %}
{% set wait %}{% if msg.returns or msg.outputs|length > 0 %}true{% else %}false{% endif %}{% endset %}
{# Declared exceptions thrown as such. #}

    {{ _type(t=msg.returns) }} {{ _id(name=msg.name) }}({{ _params(params=msg.params) }})
    {
        Writer request_;
{% for p in msg.inputs %}
{% set ns.value = _id(name=p.name) %}
{% set ns.check = _bounds(t=p.type, v=ns.value, depth=0) %}
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
        encode(request_, {{ ns.value }});
{% endfor %}
{% if msg.raises|length > 0 %}
        Bytes reply_;
        try {
            reply_ = caller_.call({{ loop.index0 }}, request_.bytes(), {{ wait }});
        } catch (const Raised& e) {
{% for r in msg.raises %}
            if (e.index == {{ loop.index0 }}) raiseAs< {{ _type(t=r) }}>(e);
{% endfor %}
            throw Error(e.what());
        }
{% elif wait == 'true' %}
        const Bytes reply_ = caller_.call({{ loop.index0 }}, request_.bytes(), true);
{% else %}
        caller_.call({{ loop.index0 }}, request_.bytes(), false);
{% endif %}
{% if wait == 'true' %}
        Reader reader_(reply_);
{% if msg.returns %}
        {{ _type(t=msg.returns) }} result_ = {{ _type(t=msg.returns) }}();
        decode(reader_, result_);
{% set ns.check = _bounds(t=msg.returns, v='result_', depth=0) %}
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
{% endif %}
{% for p in msg.outputs %}
{% set ns.value = _id(name=p.name) %}
{% set ns.check = _bounds(t=p.type, v=ns.value, depth=0) %}
{# Decoded, then checked. #}
        decode(reader_, {{ ns.value }});
{% if ns.check != '' %}
        {{ ns.check }}
{% endif %}
{% endfor %}
        reader_.end();
{% if msg.returns %}
        return result_;
{% endif %}
{% endif %}
    }
{% endfor %}

    {%+ filter user('public') +%}
    {%+ endfilter +%}

private:
    Caller caller_;
    {%+ filter user('private') +%}
    {%+ endfilter +%}
};

