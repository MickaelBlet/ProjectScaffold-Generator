{% else %}
            encode(writer_, target_->{{ _id(name=msg.name) }}({{ _args(params=msg.params) }}));
{% endif %}
{% else %}
            target_->{{ _id(name=msg.name) }}({{ _args(params=msg.params) }});
{% endif %}
{% for p in msg.outputs %}
{% set ns.value = _id(name=p.name) %}
{% set ns.check = _bounds(t=p.type, v=ns.value, depth=0) %}
{% if ns.check != '' %}
