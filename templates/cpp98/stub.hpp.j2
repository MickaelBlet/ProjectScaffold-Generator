/// Receives the calls of {{ _name(e=item) }} from another binary and makes them on the
/// port bound. The calls come on the threads of the transport: several at once over tcp, http and
/// websocket (one per connection).
class {{ item.name }}Stub : private Handler, private Calls {
public:
    {{ item.name }}Stub() : target_(0) {}
    ~{{ item.name }}Stub() { server_.reset(); }

    void bind({{ _qualified(e=item) }}& target) { target_ = &target; }

    /// Receives the calls over `transport`, at `address`; `capacity`: bytes of each ring of shm.
    void serve(const std::string& transport, const std::string& address,
               uint32_t capacity = remote::ringCapacity)
    {
        server_.reset(remote::serve(transport, address, *this, capacity));
    }

    /// Makes the call of a frame: true with the reply frame in `reply`, false when the call wants none.
    bool dispatch(const Bytes& frame, Bytes& reply) { return respond(frame, *this, reply); }

