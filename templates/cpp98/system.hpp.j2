{% from '_accessor.j2' import accessor as _accessor %}
{% from '_includes.j2' import includes as _includes %}
{% from '_namespace_close.j2' import namespace_close as _namespace_close %}
{% from '_namespace_open.j2' import namespace_open as _namespace_open %}
{% from '_ns.j2' import ns as _ns %}
{% from '_qualified.j2' import qualified as _qualified %}
{% set ns = namespace() %}
{% include '_banner.j2' %}
#pragma once

{{ _includes(e=system) -}}
{% set ns.remote = [] %}
{% for r in system.proxies %}
  {% set ns.remote = ns.remote + [r.interface.name ~ 'Proxy'] %}
{% endfor %}
{% for r in system.stubs %}
  {% set ns.remote = ns.remote + [r.interface.name ~ 'Stub'] %}
{% endfor %}
{% set ns.remote = ns.remote|unique|list|sort %}
{% for r in ns.remote %}
#include <{{ project.ident|snake }}/remote/{{ r }}.hpp>
{% endfor %}
{% filter user('includes') +%}
{% endfilter +%}

{% set ns_ %}{{ _ns(e=system) }}{% endset +%}
{{ _namespace_open(ns_=ns_) }}{##}

{{ project.description|doc_comment }}
{% if system.binary %}
{{ system.binary.description|doc_comment }}
/// The top-level modules of binary {{ system.binary.name }} of {{ project.name }}, wired together and to
/// the other binaries.
{% else %}
/// The top-level modules of {{ project.name }}, wired together.
{% endif %}
class {{ system.name }} {
public:
    {{ system.name }}();
    ~{{ system.name }}();

{% for c in system.instances %}
    {{ _qualified(e=c) }}& {{ _accessor(name=c.name) }}() { return {% if c.abstract %}*{% endif %}{{ _accessor(name=c.name) }}_; }
{% endfor %}

    {%+ filter user('public') +%}
    {%+ endfilter +%}

private:
    // Not copyable.
    {{ system.name }}(const {{ system.name }}&);
    {{ system.name }}& operator=(const {{ system.name }}&);

{% for c in system.instances %}
{% if c.abstract %}
    {{ _qualified(e=c) }}* {{ _accessor(name=c.name) }}_; // abstract: created in the constructor, deleted by the destructor
{% else %}
    {{ _qualified(e=c) }} {{ _accessor(name=c.name) }}_;
{% endif %}
{% endfor %}
{% for r in system.proxies %}
    remote::{{ r.interface.name }}Proxy {{ r.link.name|camel }}Proxy_; // {{ r.link.name }}, to binary {{ r.peer.binary }}
{% endfor %}
{% for r in system.stubs %}
    remote::{{ r.interface.name }}Stub {{ r.link.name|camel }}Stub_; // {{ r.link.name }}, from binary {{ r.peer.binary }}
{% endfor %}
    {%+ filter user('private') +%}
    {%+ endfilter +%}
};

{{ _namespace_close(ns_=ns_) -}}
