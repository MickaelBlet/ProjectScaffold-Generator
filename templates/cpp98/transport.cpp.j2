namespace {

/// Milliseconds of the monotonic clock.
typedef long long Millis;

Millis now()
{
    timespec t;
    ::clock_gettime(CLOCK_MONOTONIC, &t);
    return static_cast<Millis>(t.tv_sec) * 1000 + t.tv_nsec / 1000000;
}

const Millis forever = 0x7fffffffffffffffLL;

#ifdef MSG_NOSIGNAL
const int sendFlags = MSG_NOSIGNAL;
#else
const int sendFlags = 0;
#endif

/// Largest datagram payload.
const std::size_t maxDatagram = 65507;

/// End of a stream, closed by the peer.
class Closed : public Error {
public:
    Closed() : Error("connection closed") {}
};

/// The failure of a system call, with errno: `throw failure("send")`.
Error failure(const std::string& what) { return Error(what + ": " + std::strerror(errno)); }

/// A flag set by one thread, read by others.
class Flag {
public:
    Flag() : set_(false) {}
    void set()
    {
        Lock lock(mutex_);
        set_ = true;
    }
    bool get() const
    {
        Lock lock(mutex_);
        return set_;
    }

private:
    mutable Mutex mutex_;
    bool set_;
};

/// File descriptor, closed on destruction; not copyable.
class Fd {
public:
    explicit Fd(int fd = -1) : fd_(fd) {}
    ~Fd() { reset(); }

    int get() const { return fd_; }
    bool valid() const { return fd_ >= 0; }
    void reset(int fd = -1)
    {
        if (fd_ >= 0) ::close(fd_);
        fd_ = fd;
    }
    /// The descriptor, no longer closed here.
    int release()
    {
        const int fd = fd_;
        fd_ = -1;
        return fd;
    }

private:
    Fd(const Fd&);
    Fd& operator=(const Fd&);

    int fd_;
};

struct HostPort {
    std::string host;
    std::string port;
};

HostPort split(const std::string& address)
{
    const std::size_t colon = address.rfind(':');
    if (colon == std::string::npos) throw Error("address '" + address + "' is not host:port");
    HostPort at;
    at.host = address.substr(0, colon);
    if (at.host.size() >= 2 && at.host[0] == '[' && at.host[at.host.size() - 1] == ']')
        at.host = at.host.substr(1, at.host.size() - 2);
    at.port = address.substr(colon + 1);
    return at;
}

void configure(int fd, int type)
{
    const int one = 1;
    if (type == SOCK_STREAM) ::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
#ifdef SO_NOSIGPIPE
    ::setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
#endif
}

/// Addresses found by getaddrinfo, freed with it.
class AddressList {
public:
    explicit AddressList(addrinfo* list) : list_(list) {}
    ~AddressList() { ::freeaddrinfo(list_); }

private:
    AddressList(const AddressList&);
    AddressList& operator=(const AddressList&);

    addrinfo* list_;
};

bool await(int fd, Millis deadline, const Flag* stop, short events = POLLIN);

/// Connects `fd` to `a` before `deadline`.
bool connectBy(int fd, const addrinfo* a, Millis deadline)
{
    const int flags = ::fcntl(fd, F_GETFL, 0);
    ::fcntl(fd, F_SETFL, flags | O_NONBLOCK);
    bool connected = ::connect(fd, a->ai_addr, a->ai_addrlen) == 0;
    if (!connected && errno == EINPROGRESS && await(fd, deadline, 0, POLLOUT)) {
        int error = 0;
        socklen_t size = sizeof error;
        connected = ::getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) == 0 && error == 0;
    }
    ::fcntl(fd, F_SETFL, flags);
    return connected;
}

/// Socket connected to `address`, or bound to it (and listening for a stream) when `bind`; to close.
int openSocket(const std::string& address, int type, bool bind, Millis deadline = forever)
{
    const HostPort at = split(address);
    addrinfo hints;
    std::memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = type;
    if (bind) hints.ai_flags = AI_PASSIVE;
    addrinfo* found = 0;
    const int rc = ::getaddrinfo(at.host.empty() ? 0 : at.host.c_str(), at.port.c_str(), &hints, &found);
    if (rc != 0) throw Error("cannot resolve '" + address + "': " + ::gai_strerror(rc));
    const AddressList list(found);
    for (const addrinfo* a = found; a; a = a->ai_next) {
        Fd fd(::socket(a->ai_family, a->ai_socktype, a->ai_protocol));
        if (!fd.valid()) continue;
        ::fcntl(fd.get(), F_SETFD, FD_CLOEXEC);
        configure(fd.get(), type);
        if (bind) {
            const int one = 1;
            ::setsockopt(fd.get(), SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
            if (::bind(fd.get(), a->ai_addr, a->ai_addrlen) != 0) continue;
            if (type == SOCK_STREAM && ::listen(fd.get(), 16) != 0) continue;
        } else if (!connectBy(fd.get(), a, deadline)) {
            continue;
        }
        return fd.release();
    }
    throw failure((bind ? "cannot listen on " : "cannot connect to ") + address);
}

/// Waits until `fd` has input (or room for output with POLLOUT): false at `deadline`, or when
/// `stop` is set.
bool await(int fd, Millis deadline, const Flag* stop, short events)
{
    for (;;) {
        if (stop && stop->get()) return false;
        const Millis left = deadline - now();
        if (left <= 0) return false;
        pollfd p;
        p.fd = fd;
        p.events = events;
        p.revents = 0;
        const int rc = ::poll(&p, 1, static_cast<int>(std::min<Millis>(left + 1, 100)));
        if (rc > 0) return true;
        if (rc < 0 && errno != EINTR) throw failure("poll");
    }
}

/// Sends everything before `deadline` or `stop` (a peer not reading blocks no one past them).
void sendAll(int fd, const void* data, std::size_t size, Millis deadline = forever, const Flag* stop = 0)
{
    const char* p = static_cast<const char*>(data);
    while (size) {
        const ssize_t n = ::send(fd, p, size, sendFlags | MSG_DONTWAIT);
        if (n < 0) {
            if (errno == EINTR) continue;
            if (errno == EAGAIN || errno == EWOULDBLOCK) {
                if (!await(fd, deadline, stop, POLLOUT)) throw Error(stop && stop->get() ? "stopped" : "send timed out");
                continue;
            }
            throw failure("send");
        }
        p += n;
        size -= static_cast<std::size_t>(n);
    }
}

void sendAll(int fd, const std::string& text, Millis deadline = forever, const Flag* stop = 0)
{
    sendAll(fd, text.data(), text.size(), deadline, stop);
}
void sendAll(int fd, const Bytes& bytes, Millis deadline = forever, const Flag* stop = 0)
{
    sendAll(fd, dataOf(bytes), bytes.size(), deadline, stop);
}

/// Buffered input of a stream socket.
class Input {
public:
    explicit Input(int fd) : fd_(fd) {}

    /// The next `size` bytes: false at `deadline` or on `stop`; throws Closed at the end of the stream.
    bool take(std::size_t size, std::string& out, Millis deadline, const Flag* stop)
    {
        while (data_.size() < size)
            if (!fill(deadline, stop)) return false;
        out.assign(data_, 0, size);
        data_.erase(0, size);
        return true;
    }

    /// The bytes up to `delimiter` included, at most `limit` of them.
    bool until(const std::string& delimiter, std::string& out, std::size_t limit, Millis deadline, const Flag* stop)
    {
        std::size_t at;
        while ((at = data_.find(delimiter)) == std::string::npos) {
            if (data_.size() > limit) throw Error("header too long");
            if (!fill(deadline, stop)) return false;
        }
        return take(at + delimiter.size(), out, deadline, stop);
    }

private:
    bool fill(Millis deadline, const Flag* stop)
    {
        if (!await(fd_, deadline, stop)) return false;
        char chunk[8192];
        ssize_t n;
        do {
            n = ::recv(fd_, chunk, sizeof chunk, 0);
        } while (n < 0 && errno == EINTR);
        if (n < 0) throw failure("recv");
        if (n == 0) throw Closed();
        data_.append(chunk, static_cast<std::size_t>(n));
        return true;
    }

    int fd_;
    std::string data_;
};

Bytes toBytes(const std::string& s) { return Bytes(s.begin(), s.end()); }

/// A frame read from a stream: false at `deadline` or on `stop`.
bool readFrame(Input& in, Bytes& frame, Millis deadline, const Flag* stop)
{
    std::string head;
    if (!in.take(Header::size, head, deadline, stop)) return false;
    const Header h = header(reinterpret_cast<const uint8_t*>(head.data()), head.size());
    std::string body;
    if (!in.take(h.length, body, deadline, stop)) return false;
    frame = toBytes(head + body);
    return true;
}

std::string lower(std::string s)
{
    for (std::size_t i = 0; i < s.size(); ++i) s[i] = static_cast<char>(std::tolower(static_cast<unsigned char>(s[i])));
    return s;
}

/// Value of header `name` (lower case) in an HTTP head: false when absent.
bool headerValue(const std::string& head, const std::string& name, std::string& value)
{
    std::size_t start = head.find("\r\n");
    while (start != std::string::npos) {
        start += 2;
        const std::size_t end = head.find("\r\n", start);
        if (end == std::string::npos) break;
        const std::string line = head.substr(start, end - start);
        const std::size_t colon = line.find(':');
        if (colon != std::string::npos && lower(line.substr(0, colon)) == name) {
            const std::size_t first = line.find_first_not_of(" \t", colon + 1);
            const std::size_t last = line.find_last_not_of(" \t");
            value = first == std::string::npos ? std::string() : line.substr(first, last - first + 1);
            return true;
        }
        start = end;
    }
    return false;
}

std::size_t contentLength(const std::string& head)
{
    std::string value;
    if (!headerValue(head, "content-length", value)) return 0;
    char* end = 0;
    const unsigned long n = std::strtoul(value.c_str(), &end, 10);
    if (end == value.c_str() || *end || n > Header::size + Header::maxLength) throw Error("bad Content-Length");
    return static_cast<std::size_t>(n);
}

// WebSocket handshake: base64(SHA-1(key + GUID)).

uint32_t rol(uint32_t x, int n) { return (x << n) | (x >> (32 - n)); }

void sha1(const std::string& text, uint8_t out[20])
{
    uint32_t h[5] = {0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u};
    std::string m = text;
    const uint64_t bits = static_cast<uint64_t>(text.size()) * 8;
    m += static_cast<char>(0x80);
    while (m.size() % 64 != 56) m += '\0';
    for (int i = 7; i >= 0; --i) m += static_cast<char>((bits >> (8 * i)) & 0xff);
    for (std::size_t c = 0; c < m.size(); c += 64) {
        uint32_t w[80];
        for (std::size_t i = 0; i < 16; ++i) {
            w[i] = 0;
            for (std::size_t k = 0; k < 4; ++k)
                w[i] = w[i] << 8 | static_cast<uint32_t>(static_cast<uint8_t>(m[c + 4 * i + k]));
        }
        for (std::size_t i = 16; i < 80; ++i) w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        uint32_t a = h[0], b = h[1], x = h[2], d = h[3], e = h[4];
        for (std::size_t i = 0; i < 80; ++i) {
            uint32_t f, k;
            if (i < 20) {
                f = (b & x) | (~b & d);
                k = 0x5A827999u;
            } else if (i < 40) {
                f = b ^ x ^ d;
                k = 0x6ED9EBA1u;
            } else if (i < 60) {
                f = (b & x) | (b & d) | (x & d);
                k = 0x8F1BBCDCu;
            } else {
                f = b ^ x ^ d;
                k = 0xCA62C1D6u;
            }
            const uint32_t t = rol(a, 5) + f + e + k + w[i];
            e = d;
            d = x;
            x = rol(b, 30);
            b = a;
            a = t;
        }
        h[0] += a;
        h[1] += b;
        h[2] += x;
        h[3] += d;
        h[4] += e;
    }
    for (std::size_t i = 0; i < 20; ++i) out[i] = static_cast<uint8_t>(h[i / 4] >> (24 - 8 * (i % 4)));
}

std::string base64(const uint8_t* p, std::size_t n)
{
    static const char* abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::string out;
    for (std::size_t i = 0; i < n; i += 3) {
        const uint32_t v = static_cast<uint32_t>(p[i]) << 16 | (i + 1 < n ? static_cast<uint32_t>(p[i + 1]) << 8 : 0) |
                           (i + 2 < n ? static_cast<uint32_t>(p[i + 2]) : 0);
        out += abc[(v >> 18) & 63];
        out += abc[(v >> 12) & 63];
        out += i + 1 < n ? abc[(v >> 6) & 63] : '=';
        out += i + 2 < n ? abc[v & 63] : '=';
    }
    return out;
}

std::string acceptKey(const std::string& key)
{
    uint8_t digest[20];
    sha1(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11", digest);
    return base64(digest, sizeof digest);
}

/// Masking keys and nonces of WebSocket clients (xorshift, seeded from /dev/urandom).
class Random {
public:
    Random() : state_(0)
    {
        const int fd = ::open("/dev/urandom", O_RDONLY);
        if (fd >= 0) {
            if (::read(fd, &state_, sizeof state_) != static_cast<ssize_t>(sizeof state_)) state_ = 0;
            ::close(fd);
        }
        state_ ^= static_cast<uint32_t>(now()) ^ static_cast<uint32_t>(reinterpret_cast<std::size_t>(this));
        if (!state_) state_ = 0x9E3779B9u;
    }
    uint32_t next()
    {
        state_ ^= state_ << 13;
        state_ ^= state_ >> 17;
        state_ ^= state_ << 5;
        return state_;
    }

private:
    uint32_t state_;
};

enum Opcode { continuation = 0x0, text = 0x1, binary = 0x2, close = 0x8, ping = 0x9, pong = 0xA };

/// A WebSocket frame; clients mask theirs with `mask` (the key comes from it).
std::string wsFrame(uint8_t opcode, const uint8_t* data, std::size_t size, Random* mask)
{
    std::string out;
    out += static_cast<char>(0x80 | opcode);
    const uint8_t masked = mask ? 0x80 : 0;
    if (size < 126) {
        out += static_cast<char>(masked | size);
    } else if (size <= 0xffff) {
        out += static_cast<char>(masked | 126);
        out += static_cast<char>(size >> 8);
        out += static_cast<char>(size & 0xff);
    } else {
        out += static_cast<char>(masked | 127);
        for (int i = 7; i >= 0; --i) out += static_cast<char>((static_cast<uint64_t>(size) >> (8 * i)) & 0xff);
    }
    if (!mask) {
        out.append(reinterpret_cast<const char*>(data), size);
        return out;
    }
    uint8_t key[4];
    for (std::size_t i = 0; i < 4; ++i) key[i] = static_cast<uint8_t>(mask->next() & 0xff);
    out.append(reinterpret_cast<const char*>(key), 4);
    for (std::size_t i = 0; i < size; ++i) out += static_cast<char>(data[i] ^ key[i % 4]);
    return out;
}

/// The next WebSocket message (fragments joined), answering pings: false at `deadline` or on
/// `stop`; throws Closed on a close frame.
bool wsRead(int fd, Input& in, Bytes& message, Random* mask, Millis deadline, const Flag* stop,
            Mutex* sending = 0)
{
    message.clear();
    for (;;) {
        std::string head;
        if (!in.take(2, head, deadline, stop)) return false;
        const uint8_t b0 = static_cast<uint8_t>(head[0]);
        const uint8_t b1 = static_cast<uint8_t>(head[1]);
        uint64_t size = b1 & 0x7f;
        std::string more;
        if (size >= 126) {
            const std::size_t k = size == 126 ? 2 : 8;
            if (!in.take(k, more, deadline, stop)) return false;
            size = 0;
            for (std::size_t i = 0; i < more.size(); ++i) size = size << 8 | static_cast<uint8_t>(more[i]);
        }
        const bool control = (b0 & 0x08) != 0;
        // Control frames: whole, 125 bytes at most (RFC 6455).
        if (control && (size > 125 || !(b0 & 0x80))) throw Error("bad WebSocket control frame");
        if (message.size() + size > Header::size + Header::maxLength) throw Error("WebSocket message too large");
        std::string key;
        if ((b1 & 0x80) && !in.take(4, key, deadline, stop)) return false;
        std::string data;
        if (!in.take(static_cast<std::size_t>(size), data, deadline, stop)) return false;
        if (!key.empty())
            for (std::size_t i = 0; i < data.size(); ++i) data[i] = static_cast<char>(data[i] ^ key[i % 4]);
        switch (b0 & 0x0f) {
        case close:
            throw Closed();
        case ping: {
            if (sending) sending->lock();
            try {
                sendAll(fd, wsFrame(pong, reinterpret_cast<const uint8_t*>(data.data()), data.size(), mask), deadline,
                        stop);
            } catch (...) {
                if (sending) sending->unlock();
                throw;
            }
            if (sending) sending->unlock();
            break;
        }
        case pong:
            break;
        case continuation:
        case text:
        case binary:
            message.insert(message.end(), data.begin(), data.end());
            if (b0 & 0x80) return true;
            break;
        default:
            throw Error("bad WebSocket opcode");
        }
    }
}

// Shared memory: a header, then two rings (calls, replies) of messages (u32 length + bytes),
// each with its head (bytes written) and tail (bytes read) counters.

const uint32_t shmMagic = 0x314D4353; // "SCM1"
const std::size_t ringHeader = 64;
std::size_t shmSize(uint32_t capacity) { return ringHeader + 2 * (ringHeader + capacity); }

uint32_t load(const uint8_t* p) { return __atomic_load_n(reinterpret_cast<const uint32_t*>(p), __ATOMIC_ACQUIRE); }
void store(uint8_t* p, uint32_t v) { __atomic_store_n(reinterpret_cast<uint32_t*>(p), v, __ATOMIC_RELEASE); }

/// One ring, written by one process and read by another.
class Ring {
public:
    Ring(uint8_t* base, uint32_t capacity) : base_(base), data_(base + ringHeader), capacity_(capacity) {}

    /// Writes a message: false when there is no room for it yet.
    bool push(const Bytes& message)
    {
        if (message.size() + 4 > capacity_) throw Error("frame larger than the shared memory ring");
        const uint32_t head = load(base_);
        const uint32_t tail = load(base_ + 4);
        const uint32_t size = static_cast<uint32_t>(message.size());
        if (capacity_ - (head - tail) < size + 4) return false;
        Writer w;
        w.number(size);
        copyIn(head, dataOf(w.bytes()), 4);
        copyIn(head + 4, dataOf(message), size);
        store(base_, head + 4 + size);
        return true;
    }

    /// Reads a message: false when there is none.
    bool pop(Bytes& message)
    {
        const uint32_t tail = load(base_ + 4);
        const uint32_t head = load(base_);
        if (head - tail < 4) return false;
        uint8_t length[4];
        copyOut(tail, length, 4);
        const uint32_t size = Reader(length, 4).number<uint32_t>();
        if (size > capacity_ || head - tail < 4 + size) throw Error("corrupt shared memory ring");
        message.resize(size);
        copyOut(tail + 4, dataOf(message), size);
        store(base_ + 4, tail + 4 + size);
        return true;
    }

private:
    void copyIn(uint32_t at, const uint8_t* p, std::size_t n)
    {
        const std::size_t offset = at % capacity_;
        const std::size_t first = std::min<std::size_t>(n, capacity_ - offset);
        if (first) std::memcpy(data_ + offset, p, first);
        if (n > first) std::memcpy(data_, p + first, n - first);
    }
    void copyOut(uint32_t at, uint8_t* p, std::size_t n) const
    {
        const std::size_t offset = at % capacity_;
        const std::size_t first = std::min<std::size_t>(n, capacity_ - offset);
        if (first) std::memcpy(p, data_ + offset, first);
        if (n > first) std::memcpy(p + first, data_, n - first);
    }

    uint8_t* base_;
    uint8_t* data_;
    uint32_t capacity_;
};

/// Calls `ready()` until it holds (true), `deadline` or `stop` (false), pausing longer each time.
template <class Ready>
bool waitFor(Ready ready, Millis deadline, const Flag* stop)
{
    long pauseUs = 0;
    for (;;) {
        if (ready()) return true;
        if ((stop && stop->get()) || now() >= deadline) return false;
        if (pauseUs)
            ::usleep(static_cast<useconds_t>(pauseUs));
        else
            ::sched_yield();
        pauseUs = std::min(pauseUs + 50, 1000L);
    }
}

/// Pushes a message onto a ring, for waitFor().
struct Push {
    Push(Ring& ring, const Bytes& message) : ring(ring), message(message) {}
    bool operator()() const { return ring.push(message); }
    Ring& ring;
    const Bytes& message;
};

/// Pops a message from a ring, for waitFor().
struct Pop {
    Pop(Ring& ring, Bytes& message) : ring(ring), message(message) {}
    bool operator()() const { return ring.pop(message); }
    Ring& ring;
    Bytes& message;
};

std::string shmName(const std::string& address) { return address.compare(0, 1, "/") == 0 ? address : "/" + address; }

/// Shared memory mapped in this process.
class Mapping {
public:
    /// `capacity`: of each ring; 0 to read it from the segment (fixed from then on: the other process
    /// cannot move the rings).
    Mapping(void* data, std::size_t size, uint32_t capacity)
        : data_(static_cast<uint8_t*>(data)), size_(size), capacity_(capacity ? capacity : load(data_ + 4))
    {
    }
    ~Mapping() { ::munmap(data_, size_); }

    uint8_t* data() const { return data_; }
    uint32_t capacity() const { return capacity_; }
    Ring ring(int k) const { return Ring(data_ + ringHeader + k * (ringHeader + capacity()), capacity()); }

private:
    Mapping(const Mapping&);
    Mapping& operator=(const Mapping&);

    uint8_t* data_;
    std::size_t size_;
    uint32_t capacity_;
};

/// The shared memory of `fd`, mapped; to delete.
Mapping* map(int fd, std::size_t size, uint32_t capacity = 0)
{
    void* p = ::mmap(0, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (p == MAP_FAILED) throw failure("mmap");
    return new Mapping(p, size, capacity);
}

#if defined(__linux__)
// POSIX message queues (Linux): `<name>.call` and `<name>.reply`, made by the server, a message per frame.

/// Message queue descriptor, closed on destruction; not copyable.
class Queue {
public:
    explicit Queue(mqd_t q = static_cast<mqd_t>(-1)) : q_(q) {}
    ~Queue() { reset(); }

    mqd_t get() const { return q_; }
    bool valid() const { return q_ != static_cast<mqd_t>(-1); }
    void reset(mqd_t q = static_cast<mqd_t>(-1))
    {
        if (valid()) ::mq_close(q_);
        q_ = q;
    }
    /// The descriptor, no longer closed here.
    mqd_t release()
    {
        const mqd_t q = q_;
        q_ = static_cast<mqd_t>(-1);
        return q;
    }
    /// Bytes of a message at most.
    std::size_t messageSize() const
    {
        mq_attr attr;
        std::memset(&attr, 0, sizeof attr);
        if (::mq_getattr(q_, &attr) != 0) throw failure("mq_getattr");
        return static_cast<std::size_t>(attr.mq_msgsize);
    }

private:
    Queue(const Queue&);
    Queue& operator=(const Queue&);

    mqd_t q_;
};

/// The CLOCK_REALTIME time mq_timedsend / mq_timedreceive wait until: `deadline`, at most 100 ms from now
/// (the stop flag of a server is checked in between).
timespec slice(Millis deadline)
{
    const Millis left = std::max<Millis>(0, std::min<Millis>(deadline - now(), 100));
    timespec at;
    ::clock_gettime(CLOCK_REALTIME, &at);
    const long long ns = static_cast<long long>(left) * 1000000 + at.tv_nsec;
    at.tv_sec += static_cast<time_t>(ns / 1000000000);
    at.tv_nsec = static_cast<long>(ns % 1000000000);
    return at;
}

/// Sends `frame` before `deadline` or `stop`: false when the queue stayed full.
bool mqSend(const Queue& q, const Bytes& frame, Millis deadline, const Flag* stop)
{
    for (;;) {
        const timespec at = slice(deadline);
        if (::mq_timedsend(q.get(), reinterpret_cast<const char*>(dataOf(frame)), frame.size(), 0, &at) == 0)
            return true;
        if (errno == EMSGSIZE) throw Error("frame larger than the messages of the message queue");
        if (errno != ETIMEDOUT && errno != EINTR) throw failure("mq_timedsend");
        if ((stop && stop->get()) || now() >= deadline) return false;
    }
}

/// Receives a frame before `deadline` or `stop`: false when none came.
bool mqReceive(const Queue& q, Bytes& frame, Millis deadline, const Flag* stop)
{
    frame.resize(q.messageSize());
    for (;;) {
        const timespec at = slice(deadline);
        const ssize_t n = ::mq_timedreceive(q.get(), reinterpret_cast<char*>(dataOf(frame)), frame.size(), 0, &at);
        if (n >= 0) {
            frame.resize(static_cast<std::size_t>(n));
            return true;
        }
        if (errno != ETIMEDOUT && errno != EINTR) throw failure("mq_timedreceive");
        if ((stop && stop->get()) || now() >= deadline) return false;
    }
}
#endif

// Clients.

/// Client exchanging whole frames, for calls made from several threads at once: frames are sent one
/// at a time; one waiting call at a time reads the replies, handing each to the call of its id (a
/// table of the calls waiting). The connection is dropped on a failure, once no call reads it.
class FrameChannel : public Channel {
public:
    FrameChannel() : reading_(false), broken_(false) {}

    Bytes exchange(const Bytes& frame, bool wait, long timeoutMs)
    {
        const Millis deadline = now() + timeoutMs;
        const uint32_t id = header(frame).id;
        Lock lock(mutex_);
        // Waiting before the frame is sent: its reply may be read by another call.
        if (wait) waiting_[id] = Reply();
        try {
            if (broken_ && !reading_) {
                drop();
                broken_ = false;
            }
            open(deadline);
            send(frame, deadline);
        } catch (...) {
            waiting_.erase(id);
            broken_ = true;
            throw;
        }
        if (!wait) return Bytes();
        for (;;) {
            Reply& mine = waiting_[id];
            if (mine.got) {
                Bytes reply;
                reply.swap(mine.frame);
                waiting_.erase(id);
                return reply;
            }
            const Millis left = deadline - now();
            if (left <= 0) {
                // Its reply, coming later, is skipped.
                waiting_.erase(id);
                throw Error("no reply within " + toString(timeoutMs) + " ms");
            }
            if (reading_) {
                ready_.waitFor(mutex_, std::min<Millis>(left, 100));
                continue;
            }
            reading_ = true;
            mutex_.unlock();
            Bytes reply;
            bool got = false;
            try {
                got = receive(reply, deadline);
            } catch (...) {
                mutex_.lock();
                reading_ = false;
                broken_ = true;
                waiting_.erase(id);
                ready_.notifyAll();
                throw;
            }
            mutex_.lock();
            reading_ = false;
            if (got) {
                const std::map<uint32_t, Reply>::iterator to = waiting_.find(header(reply).id);
                if (to != waiting_.end()) {
                    to->second.frame.swap(reply);
                    to->second.got = true;
                }
            }
            ready_.notifyAll();
        }
    }

protected:
    /// Called with `mutex_` held, as `send` and `drop`; `receive` is called without it, by one call
    /// at a time.
    virtual void open(Millis deadline) = 0;
    virtual void send(const Bytes& frame, Millis deadline) = 0;
    virtual bool receive(Bytes& frame, Millis deadline) = 0;
    virtual void drop() = 0;

    /// Held to send.
    Mutex mutex_;

private:
    struct Reply {
        Reply() : got(false) {}
        bool got;
        Bytes frame;
    };

    Condition ready_;
    /// Calls waiting for their reply, by id.
    std::map<uint32_t, Reply> waiting_;
    bool reading_;
    bool broken_;
};

class TcpChannel : public FrameChannel {
public:
    explicit TcpChannel(const std::string& address) : address_(address) {}

private:
    void open(Millis deadline)
    {
        if (fd_.valid()) return;
        fd_.reset(openSocket(address_, SOCK_STREAM, false, deadline));
        in_.reset(new Input(fd_.get()));
    }
    void send(const Bytes& frame, Millis deadline) { sendAll(fd_.get(), frame, deadline); }
    bool receive(Bytes& frame, Millis deadline) { return readFrame(*in_, frame, deadline, 0); }
    void drop()
    {
        in_.reset();
        fd_.reset();
    }

    std::string address_;
    Fd fd_;
    Owned<Input> in_;
};

class UdpChannel : public FrameChannel {
public:
    explicit UdpChannel(const std::string& address) : address_(address) {}

private:
    void open(Millis)
    {
        if (!fd_.valid()) fd_.reset(openSocket(address_, SOCK_DGRAM, false));
    }
    void send(const Bytes& frame, Millis)
    {
        if (frame.size() > maxDatagram) throw Error("frame too large for a datagram");
        if (::send(fd_.get(), dataOf(frame), frame.size(), sendFlags) < 0) throw failure("send");
    }
    bool receive(Bytes& frame, Millis deadline)
    {
        if (!await(fd_.get(), deadline, 0)) return false;
        frame.resize(65536);
        const ssize_t n = ::recv(fd_.get(), dataOf(frame), frame.size(), 0);
        if (n < 0) throw failure("recv");
        frame.resize(static_cast<std::size_t>(n));
        return true;
    }
    void drop() { fd_.reset(); }

    std::string address_;
    Fd fd_;
};

/// One POST per call, on a connection of its own (calls from several threads at once share nothing).
class HttpChannel : public Channel {
public:
    HttpChannel(const std::string& address, const std::string& path) : address_(address), path_(path) {}

    Bytes exchange(const Bytes& frame, bool wait, long timeoutMs)
    {
        const Millis deadline = now() + timeoutMs;
        Fd fd(openSocket(address_, SOCK_STREAM, false, deadline));
        sendAll(fd.get(),
                "POST " + path_ + " HTTP/1.1\r\nHost: " + split(address_).host +
                    "\r\nContent-Type: application/octet-stream\r\nContent-Length: " + toString(frame.size()) +
                    "\r\nConnection: close\r\n\r\n",
                deadline);
        sendAll(fd.get(), frame, deadline);
        Input in(fd.get());
        std::string head;
        if (!in.until("\r\n\r\n", head, 16384, deadline, 0)) throw Error("no HTTP response in time");
        const std::string status = head.size() > 12 ? head.substr(9, 3) : "";
        std::string body;
        if (!in.take(contentLength(head), body, deadline, 0)) throw Error("no HTTP response in time");
        if (status != "200" && status != "204") throw Error("HTTP " + status + " " + body);
        if (!wait) return Bytes();
        Bytes reply = toBytes(body);
        if (status != "200" || header(reply).id != header(frame).id)
            throw Error("no reply within " + toString(timeoutMs) + " ms");
        return reply;
    }

private:
    std::string address_;
    std::string path_;
};

class WebSocketChannel : public FrameChannel {
public:
    WebSocketChannel(const std::string& address, const std::string& path) : address_(address), path_(path) {}

private:
    void open(Millis deadline)
    {
        if (fd_.valid()) return;
        fd_.reset(openSocket(address_, SOCK_STREAM, false, deadline));
        in_.reset(new Input(fd_.get()));
        uint8_t nonce[16];
        for (std::size_t i = 0; i < sizeof nonce; ++i) nonce[i] = static_cast<uint8_t>(random_.next() & 0xff);
        const std::string key = base64(nonce, sizeof nonce);
        sendAll(fd_.get(), "GET " + path_ + " HTTP/1.1\r\nHost: " + split(address_).host +
                               "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key +
                               "\r\nSec-WebSocket-Version: 13\r\n\r\n",
                deadline);
        std::string head;
        if (!in_->until("\r\n\r\n", head, 16384, deadline, 0)) throw Error("no WebSocket handshake in time");
        std::string accept;
        if (head.compare(0, 12, "HTTP/1.1 101") != 0 || !headerValue(head, "sec-websocket-accept", accept) ||
            accept != acceptKey(key))
            throw Error("WebSocket handshake refused");
    }
    void send(const Bytes& frame, Millis deadline)
    {
        sendAll(fd_.get(), wsFrame(binary, dataOf(frame), frame.size(), &random_), deadline);
    }
    bool receive(Bytes& frame, Millis deadline)
    {
        // Pongs are sent as the calls are, under mutex_ (which also guards the mask's random numbers).
        return wsRead(fd_.get(), *in_, frame, &random_, deadline, 0, &mutex_);
    }
    void drop()
    {
        in_.reset();
        fd_.reset();
    }

    std::string address_;
    std::string path_;
    Random random_;
    Fd fd_;
    Owned<Input> in_;
};

/// Opens the segment made by the server (waiting for it), writes the calls ring, reads the replies ring.
class ShmChannel : public FrameChannel {
public:
    explicit ShmChannel(const std::string& address) : name_(shmName(address)) {}

    /// Maps the segment when the server made it: true when mapped.
    bool attach()
    {
        const Fd fd(::shm_open(name_.c_str(), O_RDWR, 0));
        struct stat st;
        if (!fd.valid() || ::fstat(fd.get(), &st) != 0 || static_cast<std::size_t>(st.st_size) < shmSize(0))
            return false;
        Owned<Mapping> m(map(fd.get(), static_cast<std::size_t>(st.st_size)));
        if (load(m->data()) != shmMagic || shmSize(m->capacity()) != static_cast<std::size_t>(st.st_size))
            return false;
        mapping_.reset(m.release());
        return true;
    }

private:
    /// Attaches, for waitFor().
    struct Attach {
        explicit Attach(ShmChannel& channel) : channel(channel) {}
        bool operator()() const { return channel.attach(); }
        ShmChannel& channel;
    };

    void open(Millis deadline)
    {
        if (!mapping_.get() && !waitFor(Attach(*this), deadline, 0)) throw Error("no shared memory " + name_);
    }
    void send(const Bytes& frame, Millis deadline)
    {
        Ring calls = mapping_->ring(0);
        if (!waitFor(Push(calls, frame), deadline, 0)) throw Error("shared memory ring full");
    }
    bool receive(Bytes& frame, Millis deadline)
    {
        Ring replies = mapping_->ring(1);
        return waitFor(Pop(replies, frame), deadline, 0);
    }
    void drop() { mapping_.reset(); }

    std::string name_;
    Owned<Mapping> mapping_;
};

#if defined(__linux__)
/// Opens the queues made by the server (waiting for them), sends on `<name>.call`, receives on `<name>.reply`.
class MqChannel : public FrameChannel {
public:
    explicit MqChannel(const std::string& address) : name_(shmName(address)) {}

    /// Opens the queues when the server made them: true when open.
    bool attach()
    {
        Queue calls(::mq_open((name_ + ".call").c_str(), O_WRONLY));
        Queue replies(::mq_open((name_ + ".reply").c_str(), O_RDONLY));
        if (!calls.valid() || !replies.valid()) return false;
        calls_.reset(calls.release());
        replies_.reset(replies.release());
        return true;
    }

private:
    /// Attaches, for waitFor().
    struct Attach {
        explicit Attach(MqChannel& channel) : channel(channel) {}
        bool operator()() const { return channel.attach(); }
        MqChannel& channel;
    };

    void open(Millis deadline)
    {
        if (!calls_.valid() && !waitFor(Attach(*this), deadline, 0))
            throw Error("no message queues " + name_ + ".call, " + name_ + ".reply");
    }
    void send(const Bytes& frame, Millis deadline)
    {
        if (!mqSend(calls_, frame, deadline, 0)) throw Error("message queue " + name_ + ".call full");
    }
    bool receive(Bytes& frame, Millis deadline) { return mqReceive(replies_, frame, deadline, 0); }
    void drop()
    {
        calls_.reset();
        replies_.reset();
    }

    std::string name_;
    Queue calls_;
    Queue replies_;
};
