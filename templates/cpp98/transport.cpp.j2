// Servers.

/// Work of a server thread.
class Task {
public:
    virtual ~Task() {}
    virtual void run() = 0;
};

/// Threads of a server, stopped and joined by halt().
class Threads : public Server {
protected:
    Threads() {}

    /// Runs `task` (deleted when done) on a thread of its own.
    void spawn(Task* task)
    {
        Lock lock(mutex_);
        for (std::list<Job*>::iterator it = jobs_.begin(); it != jobs_.end();) {
            if ((*it)->done.get()) {
                ::pthread_join((*it)->thread, 0);
                delete *it;
                it = jobs_.erase(it);
            } else {
                ++it;
            }
        }
        Job* job = new Job(task);
        if (::pthread_create(&job->thread, 0, &Threads::start, job) != 0) {
            delete job;
            throw failure("pthread_create");
        }
        jobs_.push_back(job);
    }

    /// Stops the threads: first thing each server's destructor does.
    void halt()
    {
        stop_.set();
        for (;;) {
            std::list<Job*> jobs;
            {
                Lock lock(mutex_);
                jobs.swap(jobs_);
            }
            if (jobs.empty()) return;
            for (std::list<Job*>::iterator it = jobs.begin(); it != jobs.end(); ++it) {
                ::pthread_join((*it)->thread, 0);
                delete *it;
            }
        }
    }

    Flag stop_;

private:
    struct Job {
        explicit Job(Task* task) : task(task), thread() {}
        Owned<Task> task;
        pthread_t thread;
        Flag done;
    };

    static void* start(void* p)
    {
        Job* job = static_cast<Job*>(p);
        try {
            job->task->run();
        } catch (const std::exception& e) {
            std::cerr << "remote server: " << e.what() << '\n';
        } catch (...) {
            std::cerr << "remote server: unknown exception\n";
        }
        job->done.set();
        return 0;
    }

    Mutex mutex_;
    std::list<Job*> jobs_;
};

/// Calls `T::loop()` on a thread of a server.
template <class T>
class Loop : public Task {
public:
    explicit Loop(T& server) : server_(server) {}
    void run() { server_.loop(); }

private:
    T& server_;
};

/// Handles the connections of a stream socket, one thread each.
typedef void (*Session)(int fd, Handler& handler, const Flag& stop);

class StreamServer : public Threads {
public:
    StreamServer(const std::string& address, Handler& handler, Session session)
        : listener_(openSocket(address, SOCK_STREAM, true)), handler_(handler), session_(session)
    {
        spawn(new Loop<StreamServer>(*this));
    }
    ~StreamServer() { halt(); }

    void loop()
    {
        while (await(listener_.get(), forever, &stop_)) {
            const int fd = ::accept(listener_.get(), 0, 0);
            if (fd < 0) {
                // Out of descriptors or memory: the listener stays readable, pause rather than spin.
                if (errno != EINTR && errno != EAGAIN && errno != ECONNABORTED) ::usleep(100000);
                continue;
            }
            ::fcntl(fd, F_SETFD, FD_CLOEXEC);
            configure(fd, SOCK_STREAM);
            spawn(new Connection(*this, fd));
        }
    }

private:
    /// One connection, closed when its session ends.
    class Connection : public Task {
    public:
        Connection(StreamServer& server, int fd) : server_(server), fd_(fd) {}
        void run()
        {
            try {
                server_.session_(fd_.get(), server_.handler_, server_.stop_);
            } catch (const Error&) {
                // Connection closed or broken.
            }
        }

    private:
        StreamServer& server_;
        Fd fd_;
    };

    Fd listener_;
    Handler& handler_;
    Session session_;
};

void tcpSession(int fd, Handler& handler, const Flag& stop)
{
    Input in(fd);
    Bytes frame;
    Bytes reply;
    while (readFrame(in, frame, forever, &stop))
        if (handler.handle(frame, reply)) sendAll(fd, reply, forever, &stop);
}

std::string httpResponse(const std::string& status, const std::string& body, const std::string& type)
{
    return "HTTP/1.1 " + status + "\r\nContent-Type: " + type + "\r\nContent-Length: " + toString(body.size()) +
           "\r\n\r\n" + body;
}

void httpSession(int fd, Handler& handler, const Flag& stop)
{
    Input in(fd);
    for (;;) {
        std::string head;
        if (!in.until("\r\n\r\n", head, 16384, forever, &stop)) return;
        std::string body;
        if (!in.take(contentLength(head), body, forever, &stop)) return;
        std::string response;
        if (head.compare(0, 5, "POST ") != 0) {
            response = httpResponse("405 Method Not Allowed", "", "text/plain");
        } else {
            try {
                Bytes reply;
                response = handler.handle(toBytes(body), reply)
                               ? httpResponse("200 OK", std::string(reply.begin(), reply.end()), "application/octet-stream")
                               : httpResponse("204 No Content", "", "text/plain");
            } catch (const std::exception& e) {
                response = httpResponse("400 Bad Request", e.what(), "text/plain");
            }
        }
        sendAll(fd, response, forever, &stop);
        std::string connection;
        if (headerValue(head, "connection", connection) && lower(connection) == "close") return;
    }
}

void webSocketSession(int fd, Handler& handler, const Flag& stop)
{
    Input in(fd);
    std::string head;
    if (!in.until("\r\n\r\n", head, 16384, forever, &stop)) return;
    std::string key;
    if (!headerValue(head, "sec-websocket-key", key) || head.compare(0, 4, "GET ") != 0) {
        sendAll(fd, httpResponse("400 Bad Request", "WebSocket only", "text/plain"), forever, &stop);
        return;
    }
    sendAll(fd, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " +
                    acceptKey(key) + "\r\n\r\n",
            forever, &stop);
    Bytes message;
    Bytes reply;
    while (wsRead(fd, in, message, 0, forever, &stop))
        if (handler.handle(message, reply))
            sendAll(fd, wsFrame(binary, dataOf(reply), reply.size(), 0), forever, &stop);
}

class UdpServer : public Threads {
public:
    UdpServer(const std::string& address, Handler& handler)
        : socket_(openSocket(address, SOCK_DGRAM, true)), handler_(handler)
    {
        spawn(new Loop<UdpServer>(*this));
    }
    ~UdpServer() { halt(); }

    void loop()
    {
        Bytes buffer(65536);
        Bytes reply;
        while (await(socket_.get(), forever, &stop_)) {
            sockaddr_storage from;
            std::memset(&from, 0, sizeof from);
            socklen_t size = sizeof from;
            const ssize_t n = ::recvfrom(socket_.get(), dataOf(buffer), buffer.size(), 0,
                                         reinterpret_cast<sockaddr*>(&from), &size);
            if (n < 0) continue;
            try {
                const Bytes frame(buffer.begin(), buffer.begin() + n);
                if (!handler_.handle(frame, reply)) continue;
                if (reply.size() > maxDatagram) reply = errorFrame(header(frame).id, "reply too large for a datagram");
                ::sendto(socket_.get(), dataOf(reply), reply.size(), sendFlags, reinterpret_cast<sockaddr*>(&from),
                         size);
            } catch (const Error&) {
                // Not a frame.
            }
        }
    }

private:
    Fd socket_;
    Handler& handler_;
};

/// Makes the segment (replacing a stale one), reads the calls ring, writes the replies ring.
class ShmServer : public Threads {
public:
    ShmServer(const std::string& address, Handler& handler, uint32_t capacity)
        : name_(shmName(address)), handler_(handler)
    {
        ::shm_unlink(name_.c_str());
        const Fd fd(::shm_open(name_.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600));
        if (!fd.valid()) throw failure("cannot create shared memory " + name_);
        const std::size_t size = shmSize(capacity);
        if (::ftruncate(fd.get(), static_cast<off_t>(size)) != 0) throw failure("ftruncate");
        mapping_.reset(map(fd.get(), size, capacity));
        store(mapping_->data() + 4, capacity);
        store(mapping_->data(), shmMagic);
        spawn(new Loop<ShmServer>(*this));
    }
    ~ShmServer()
    {
        halt();
        mapping_.reset();
        ::shm_unlink(name_.c_str());
    }

    void loop()
    {
        Ring calls = mapping_->ring(0);
        Ring replies = mapping_->ring(1);
        Bytes frame;
        Bytes reply;
        while (waitFor(Pop(calls, frame), forever, &stop_)) {
            try {
                // A reply finding no room within a second is lost: the client gave up on it.
                if (handler_.handle(frame, reply)) waitFor(Push(replies, reply), now() + 1000, &stop_);
            } catch (const std::exception&) {
                // Not a frame, or a reply larger than the ring: the next call is served.
            }
        }
    }

private:
    std::string name_;
    Handler& handler_;
    Owned<Mapping> mapping_;
};

#if defined(__linux__)
/// Makes the queues (replacing stale ones), receives the calls on `<name>.call`, sends the replies on
/// `<name>.reply`.
class MqServer : public Threads {
public:
    MqServer(const std::string& address, Handler& handler, uint32_t maxMessages, uint32_t messageSize)
        : name_(shmName(address)), handler_(handler)
    {
        calls_.reset(make(name_ + ".call", maxMessages, messageSize));
        replies_.reset(make(name_ + ".reply", maxMessages, messageSize));
        spawn(new Loop<MqServer>(*this));
    }
    ~MqServer()
    {
        halt();
        calls_.reset();
        replies_.reset();
        ::mq_unlink((name_ + ".call").c_str());
        ::mq_unlink((name_ + ".reply").c_str());
    }

    void loop()
    {
        Bytes frame;
        Bytes reply;
        while (mqReceive(calls_, frame, forever, &stop_)) {
            try {
                if (!handler_.handle(frame, reply)) continue;
                if (reply.size() > replies_.messageSize())
                    reply = errorFrame(header(frame).id, "reply larger than the messages of the message queue");
                // A reply finding no room within a second is lost: the client gave up on it.
                mqSend(replies_, reply, now() + 1000, &stop_);
            } catch (const std::exception&) {
                // Not a frame, or the reply could not be sent: the next call is served.
            }
        }
    }

private:
    static mqd_t make(const std::string& name, uint32_t maxMessages, uint32_t messageSize)
    {
        ::mq_unlink(name.c_str());
        mq_attr attr;
        std::memset(&attr, 0, sizeof attr);
        attr.mq_maxmsg = static_cast<long>(maxMessages);
        attr.mq_msgsize = static_cast<long>(messageSize);
        const mqd_t q = ::mq_open(name.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600, &attr);
        if (q == static_cast<mqd_t>(-1)) throw failure("cannot create message queue " + name);
        return q;
    }

    std::string name_;
    Handler& handler_;
    Queue calls_;
    Queue replies_;
};
#endif

volatile std::sig_atomic_t stopSignal = 0;

extern "C" void onStop(int) { stopSignal = 1; }

} // namespace

bool supported(const std::string& transport)
{
    return transport == "tcp" || transport == "udp" || transport == "http" || transport == "websocket" ||
           transport == "shm"
#if defined(__linux__)
           || transport == "mq"
#endif
        ;
}

std::string address(const char* variable, const std::string& fallback)
{
    const char* value = std::getenv(variable);
    return value && *value ? value : fallback;
}

Channel* connect(const std::string& transport, const std::string& address, const std::string& path)
{
    if (transport == "tcp") return new TcpChannel(address);
    if (transport == "udp") return new UdpChannel(address);
    if (transport == "http") return new HttpChannel(address, path);
    if (transport == "websocket") return new WebSocketChannel(address, path);
    if (transport == "shm") return new ShmChannel(address);
#if defined(__linux__)
    if (transport == "mq") return new MqChannel(address);
#endif
    throw Error("transport '" + transport + "' is not generated: implement a remote::Channel");
}

Server* serve(const std::string& transport, const std::string& address, Handler& handler, uint32_t capacity,
              uint32_t maxMessages, uint32_t messageSize)
{
    if (transport == "tcp") return new StreamServer(address, handler, tcpSession);
    if (transport == "udp") return new UdpServer(address, handler);
    if (transport == "http") return new StreamServer(address, handler, httpSession);
    if (transport == "websocket") return new StreamServer(address, handler, webSocketSession);
    if (transport == "shm") return new ShmServer(address, handler, capacity);
#if defined(__linux__)
    if (transport == "mq") return new MqServer(address, handler, maxMessages, messageSize);
#else
    (void)maxMessages;
    (void)messageSize;
#endif
    throw Error("transport '" + transport + "' is not generated: implement a remote::Server");
}

void waitForStop()
{
    typedef void (*SignalHandler)(int);
    stopSignal = 0;
    const SignalHandler previousInt = std::signal(SIGINT, onStop);
    const SignalHandler previousTerm = std::signal(SIGTERM, onStop);
    while (!stopSignal) ::usleep(100000);
    std::signal(SIGINT, previousInt);
    std::signal(SIGTERM, previousTerm);
}

