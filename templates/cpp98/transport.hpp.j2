/// Owner of a heap object, deleted with it (std::unique_ptr of C++11); not copyable.
template <class T>
class Owned {
public:
    explicit Owned(T* p = 0) : p_(p) {}
    ~Owned() { delete p_; }

    void reset(T* p = 0)
    {
        if (p == p_) return;
        delete p_;
        p_ = p;
    }
    /// The object, no longer deleted here.
    T* release()
    {
        T* p = p_;
        p_ = 0;
        return p;
    }
    T* get() const { return p_; }
    T& operator*() const { return *p_; }
    T* operator->() const { return p_; }

private:
    Owned(const Owned&);
    Owned& operator=(const Owned&);

    T* p_;
};

/// A pthread mutex; not copyable.
class Mutex {
public:
    Mutex() { pthread_mutex_init(&mutex_, 0); }
    ~Mutex() { pthread_mutex_destroy(&mutex_); }
    void lock() { pthread_mutex_lock(&mutex_); }
    void unlock() { pthread_mutex_unlock(&mutex_); }
    pthread_mutex_t* native() { return &mutex_; }

private:
    Mutex(const Mutex&);
    Mutex& operator=(const Mutex&);

    pthread_mutex_t mutex_;
};

/// Holds a mutex locked while in scope.
class Lock {
public:
    explicit Lock(Mutex& mutex) : mutex_(mutex) { mutex_.lock(); }
    ~Lock() { mutex_.unlock(); }

private:
    Lock(const Lock&);
    Lock& operator=(const Lock&);

    Mutex& mutex_;
};

/// A pthread condition variable; not copyable.
class Condition {
public:
    Condition() { pthread_cond_init(&cond_, 0); }
    ~Condition() { pthread_cond_destroy(&cond_); }
    void wait(Mutex& mutex) { pthread_cond_wait(&cond_, mutex.native()); }
    /// Waits `ms` milliseconds at most.
    void waitFor(Mutex& mutex, long long ms)
    {
        timespec at;
        clock_gettime(CLOCK_REALTIME, &at);
        const long long ns = at.tv_nsec + ms % 1000 * 1000000LL;
        at.tv_sec += static_cast<time_t>(ms / 1000 + ns / 1000000000LL);
        at.tv_nsec = static_cast<long>(ns % 1000000000LL);
        pthread_cond_timedwait(&cond_, mutex.native(), &at);
    }
    void notifyAll() { pthread_cond_broadcast(&cond_); }

private:
    Condition(const Condition&);
    Condition& operator=(const Condition&);

    pthread_cond_t cond_;
};

/// Client end of a link: sends call frames, receives their replies.
class Channel {
public:
    virtual ~Channel() {}
    /// Sends `frame`; when `wait`, returns the reply frame of the same call id, received within
    /// `timeoutMs` milliseconds (else returns nothing). Throws Error.
    virtual Bytes exchange(const Bytes& frame, bool wait, long timeoutMs) = 0;
};

/// Server end of a link, receiving the calls on threads of its own until deleted.
class Server {
public:
    virtual ~Server() {}
};

/// Answers call frames.
class Handler {
public:
    virtual ~Handler() {}
    /// Makes the call of `frame`: true with the reply frame in `reply`, false when the call wants none.
    virtual bool handle(const Bytes& frame, Bytes& reply) = 0;
};

/// Whether `transport` is implemented here.
bool supported(const std::string& transport);

/// The value of environment variable `variable`, else `fallback`.
std::string address(const char* variable, const std::string& fallback);

/// Channel to the server at `address` (`host:port`, or a name for shm and mq), to delete; `path`: request
/// path of http and websocket. Connects on the first call, and again on the next call after a failure.
Channel* connect(const std::string& transport, const std::string& address, const std::string& path = "/");

/// Bytes of each ring of shm, by default.
const uint32_t ringCapacity = 1u << 20;

/// Messages each queue of mq holds, and bytes of a message, by default (those of Linux).
const uint32_t mqMaxMessages = 10;
const uint32_t mqMessageSize = 8192;

/// Server at `address`, to delete, calling `handler` (which outlives it) for each call received;
/// `capacity`: bytes of each ring of shm; `maxMessages`, `messageSize`: of each queue of mq.
Server* serve(const std::string& transport, const std::string& address, Handler& handler,
              uint32_t capacity = ringCapacity, uint32_t maxMessages = mqMaxMessages,
              uint32_t messageSize = mqMessageSize);

/// Blocks until SIGINT or SIGTERM.
void waitForStop();

/// Numbered calls over a channel, from any thread (several at once: each waits for the reply of its
/// own id): what proxies are made of.
class Caller {
public:
    Caller() : ack_(false), timeoutMs_(5000), next_(0), calls_(0) {}

    /// Takes `channel` (deleted with the caller), once the calls under way are over.
    void open(Channel* channel, bool ack, long timeoutMs)
    {
        Lock lock(mutex_);
        while (calls_) idle_.wait(mutex_);
        channel_.reset(channel);
        ack_ = ack;
        timeoutMs_ = timeoutMs;
    }

    bool opened() const
    {
        Lock lock(mutex_);
        return channel_.get() != 0;
    }

    /// Sends message `message` with its encoded inputs; waits for the reply when the message has a
    /// result, or the link acknowledges calls. Returns the payload of the reply (empty without).
    Bytes call(uint16_t message, const Bytes& inputs, bool result)
    {
        Channel* channel;
        Header h;
        long timeoutMs;
        bool wait;
        {
            // Not held during the call: calls made meanwhile (from other threads, or from the
            // handler of a call received during it) go on.
            Lock lock(mutex_);
            if (!channel_.get()) throw Error("remote call on a proxy not opened");
            channel = channel_.get();
            wait = result || ack_;
            timeoutMs = timeoutMs_;
            h.id = ++next_;
            ++calls_;
        }
        h.kind = Header::call;
        h.flags = wait ? Header::wantReply : 0;
        h.message = message;
        Bytes reply;
        try {
            reply = channel->exchange(frame(h, inputs), wait, timeoutMs);
        } catch (...) {
            done();
            throw;
        }
        done();
        if (!wait) return Bytes();
        const Header r = header(reply);
        Bytes out = payload(reply);
        if (r.kind == Header::error) {
            Reader reader(out);
            std::string text;
            decode(reader, text);
            if (r.flags & Header::typed) {
                const uint16_t index = reader.number<uint16_t>();
                throw Raised(index, Bytes(out.end() - static_cast<std::ptrdiff_t>(reader.remaining()), out.end()),
                             "remote call failed: " + text);
            }
            throw Error("remote call failed: " + text);
        }
        if (r.kind != Header::reply) throw Error("not a reply");
        return out;
    }

private:
    Caller(const Caller&);
    Caller& operator=(const Caller&);

    /// A call is over.
    void done()
    {
        Lock lock(mutex_);
        if (--calls_ == 0) idle_.notifyAll();
    }

    mutable Mutex mutex_;
    Condition idle_;
    Owned<Channel> channel_;
    bool ack_;
    long timeoutMs_;
    uint32_t next_;
    /// Calls under way.
    int calls_;
};

/// Declared exception `e` of a called method (`index` in the `raises` of its message), to send back.
template <class E>
Raised raised(uint16_t index, const E& e)
{
    Writer w;
    encode(w, e);
    return Raised(index, w.bytes(), e.what());
}

/// Throws the declared exception `E` held by `e`.
template <class E>
void raiseAs(const Raised& e)
{
    Reader r(e.value);
    E x;
    decode(r, x);
    throw x;
}

