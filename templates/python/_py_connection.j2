{% from '_py_endpoint.j2' import py_endpoint as _py_endpoint %}
{#
  Wiring of a link inside a module or the system, with its constraints as a comment. Included
  (not rendered): its user section belongs to the including file. Parameter: connection.
#}
{% set l = connection.link -%}
{%- set k = l.constraints -%}
{%- set wiring -%}
  {{- _py_endpoint(x=connection.from) -}}
  {{- '.connect(' -}}
  {{- _py_endpoint(x=connection.to) -}}
  {{- ')' -}}
{%- endset %}
        # {{ l.name }}: {{ l.from.module }}:{{ l.from.port }} -> {{ l.to.module }}:{{ l.to.port }}, {{ k.direction }}, {{ k.performance.class }}{% if k.performance.maxLatencyMs %}, max {{ k.performance.maxLatencyMs }} ms{% endif %}{% if k.performance.rateHz %}, {{ k.performance.rateHz }} Hz{% endif %}{% if k.ack.required %}, ack{% if k.ack.timeoutMs %} within {{ k.ack.timeoutMs }} ms{% endif %}{% endif +%}
{{ l.description|doc_comment('        # ') }}
{% if k.remote.enabled %}
        {%+ filter user('link.' ~ l.name) +%}
        # Remote over {{ k.remote.transport|default('an unset transport', true) }}: replace with a proxy of that transport.
        {{ wiring }}
        {%+ endfilter +%}
{% else %}
        {{ wiring }}
{% endif %}
