{% macro py_params(msg=none) %}
{% from '_py_id.j2' import py_id as _py_id %}
{% from '_py_type.j2' import py_type as _py_type %}
{#
  Parameters of a message or method in Python: its inputs (in, inout) with their type hints; out
  and inout values are given back (see _py_results). Parameter: msg.
#}
{% filter inline %}
{% for p in msg.inputs %}, {{ _py_id(name=p.name) }}: {{ _py_type(t=p.type, prefix='data.') }}{% endfor %}
{% endfilter %}
{% endmacro %}
