{% from '_py_id.j2' import py_id as _py_id %}
{% include '_py_banner.j2' %}
{% set root = project.ident|snake %}
"""Runs a system of {{ project.name|replace('\\', '\\\\')|replace('"', '\\"') }}: `python -m {{ root }}{% if systems|length > 1 %} <system>{% endif %}`."""
from __future__ import annotations

import importlib
import sys

SYSTEMS = {
{% for system in systems %}
{% set module %}{% set file = system.name|snake %}{{ _py_id(name=file) }}{% endset %}
    '{% if system.binary %}{{ system.binary.name|snake }}{% else %}app{% endif %}': '{{ root }}.systems.{{ module }}',
{% endfor %}
}


def main() -> int:
    names = sys.argv[1:]
    if len(names) != 1 and len(SYSTEMS) == 1:
        names = list(SYSTEMS)
    if len(names) != 1 or names[0] not in SYSTEMS:
        print('usage: python -m {{ root }} ' + '|'.join(SYSTEMS), file=sys.stderr)
        return 2
    importlib.import_module(SYSTEMS[names[0]]).main()
    return 0


if __name__ == '__main__':
    sys.exit(main())
