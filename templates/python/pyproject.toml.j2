{% from '_py_id.j2' import py_id as _py_id %}
{% set root = project.ident|snake %}
# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.

[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project.ident|kebab }}"
version = "0.1.0"
description = "{{ project.description|split('\n')|select|list|first|replace('\\', '\\\\')|replace('"', '\\"') }}"
requires-python = ">=3.8"
{% filter user('project') +%}
{% endfilter +%}
{% if modules|length > 0 %}

[project.scripts]
{% for system in systems %}
{% set module %}{% set file = system.name|snake %}{{ _py_id(name=file) }}{% endset %}
{{ project.ident|kebab }}{% if system.binary %}-{{ system.binary.name|kebab }}{% endif %} = "{{ root }}.systems.{{ module }}:main"
{% endfor %}
{% endif %}

[tool.setuptools.packages.find]
include = ["{{ root }}*"]

{% filter user('end') +%}
{% endfilter +%}
