{% from '_component.j2' import component as _component %}
{% set ns = namespace() %}
# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.
{% set ns_ = project.ident|snake -%}
{%- set ns.components = '' -%}
{%- for m in modules -%}
  {%- set isComponent -%}
    {{- _component(m=m) -}}
  {%- endset -%}
  {%- if isComponent == 'true' -%}
    {%- set ns.components = ns.components ~ m.path ~ ',' -%}
  {%- endif -%}
{%- endfor -%}
{%- set ns.components = ns.components|split(',')|select|list %}
cmake_minimum_required(VERSION 3.18)
project({{ ns_ }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 98)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

{% filter user('options') +%}
{% endfilter +%}

# omniORB 4: omniidl, headers and libraries (Debian / Ubuntu: omniidl libomniorb4-dev).
find_program(OMNIIDL omniidl REQUIRED)
find_path(OMNIORB_INCLUDE_DIR omniORB4/CORBA.h REQUIRED)
find_library(OMNIORB_LIBRARY omniORB4 REQUIRED)
find_library(OMNIDYNAMIC_LIBRARY omniDynamic4 REQUIRED)
find_library(OMNITHREAD_LIBRARY omnithread REQUIRED)
find_package(Threads REQUIRED)

if(NOT COMMAND scaffold_sca_idl)
    # C++ of an IDL file into <out>: <name>.hh, <name>SK.cc (stubs and skeletons), <name>DynSK.cc
    # (TypeCodes and Any operators); their list in <var>. Further arguments: IDL include directories.
    function(scaffold_sca_idl idl out var)
        get_filename_component(name ${idl} NAME_WE)
        set(files ${out}/${name}.hh ${out}/${name}SK.cc ${out}/${name}DynSK.cc)
        set(includes)
        foreach(dir ${ARGN})
            list(APPEND includes -I${dir})
        endforeach()
        file(MAKE_DIRECTORY ${out})
        add_custom_command(OUTPUT ${files}
            COMMAND ${OMNIIDL} -bcxx -Wba -Wbh=.hh -Wbs=SK.cc -Wbd=DynSK.cc ${includes} -C${out} ${idl}
            DEPENDS ${idl}
            VERBATIM)
        # Generated code: no warnings of ours.
        set_source_files_properties(${files} PROPERTIES COMPILE_OPTIONS -w)
        set(${var} ${files} PARENT_SCOPE)
    endfunction()
endif()

# The SCA Core Framework interfaces (idl/CF.idl) and sca/support.hpp, once for every project built
# together.
if(NOT TARGET scaffold_sca)
    scaffold_sca_idl(${CMAKE_CURRENT_SOURCE_DIR}/idl/CF.idl ${CMAKE_CURRENT_BINARY_DIR}/scaffold_sca CF_SOURCES
        ${CMAKE_CURRENT_SOURCE_DIR}/idl)
    add_library(scaffold_sca STATIC ${CF_SOURCES} src/sca/support.cpp)
    target_include_directories(scaffold_sca SYSTEM PUBLIC ${CMAKE_CURRENT_BINARY_DIR}/scaffold_sca ${OMNIORB_INCLUDE_DIR})
    target_include_directories(scaffold_sca PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
    target_link_libraries(scaffold_sca PUBLIC ${OMNIDYNAMIC_LIBRARY} ${OMNIORB_LIBRARY} ${OMNITHREAD_LIBRARY}
        Threads::Threads)
    target_compile_features(scaffold_sca PUBLIC cxx_std_98)
endif()

# The types and interfaces of the project (idl/{{ ns_ }}.idl), and its modules.
scaffold_sca_idl(${CMAKE_CURRENT_SOURCE_DIR}/idl/{{ ns_ }}.idl ${CMAKE_CURRENT_BINARY_DIR}/idl SCAFFOLD_IDL_SOURCES
    ${CMAKE_CURRENT_SOURCE_DIR}/idl
{% for d in dependencies %}
    ${CMAKE_CURRENT_SOURCE_DIR}/../{{ d.name|snake }}/idl
{% endfor %}
)
add_library({{ ns_ }} STATIC
    ${SCAFFOLD_IDL_SOURCES}
{% for f in files %}
{% if '.cpp' in f %}
{% if not ('src/main/' in f or 'src/sca/' in f) %}
    {{ f }}
{% endif %}
{% endif %}
{% endfor %}
)
target_include_directories({{ ns_ }} SYSTEM PUBLIC ${CMAKE_CURRENT_BINARY_DIR}/idl)
target_include_directories({{ ns_ }} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries({{ ns_ }} PUBLIC scaffold_sca)

{% filter user('dependencies') +%}
{% for d in dependencies %}
{% set dep = d.name|snake %}
if(NOT TARGET {{ dep }} AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }}/CMakeLists.txt)
    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }} ${CMAKE_CURRENT_BINARY_DIR}/{{ dep }})
endif()
if(TARGET {{ dep }})
    target_link_libraries({{ ns_ }} PUBLIC {{ dep }})
else()
    message(WARNING "dependency {{ d.name }} ({{ d.file }}) not found: generate it in ../{{ dep }}")
endif()
{% endfor %}
{% endfilter +%}
{% if ns.components|length > 0 %}

# The descriptors of a component, installed in dom/components/<name> (the SDR layout of a Core
# Framework).
{% for path in ns.components %}
{% set m = modules|selectattr('path', 'equalto', path)|first %}
install(FILES
    dom/components/{{ m.name }}/{{ m.name }}.spd.xml
    dom/components/{{ m.name }}/{{ m.name }}.scd.xml
    dom/components/{{ m.name }}/{{ m.name }}.prf.xml
    DESTINATION dom/components/{{ m.name }})
{% endfor %}

# An executable per binary serving its components (src/main/main.cpp: those of no binary),
# installed in dom/bin where their SPDs name it.
{% for b in binaries %}
{% set ns.served = modules|selectattr('depth', 'equalto', 0)|selectattr('abstract', 'equalto', false)|selectattr('binary', 'equalto', b.name)|first %}
{% if ns.served %}
{% set exe = (ns_ ~ '_' ~ b.name)|snake %}
add_executable({{ exe }} src/main/{{ b.name|snake }}_main.cpp)
target_link_libraries({{ exe }} PRIVATE {{ ns_ }})
install(TARGETS {{ exe }} DESTINATION dom/bin)
{% endif %}
{% endfor %}
{% set ns.served = modules|selectattr('depth', 'equalto', 0)|selectattr('abstract', 'equalto', false)|selectattr('binary', 'none')|first %}
{% if ns.served %}
add_executable({{ ns_ }}_app src/main/main.cpp)
target_link_libraries({{ ns_ }}_app PRIVATE {{ ns_ }})
install(TARGETS {{ ns_ }}_app DESTINATION dom/bin)
{% endif %}

# The waveform: its SAD, and every component in one process without a Core Framework.
add_executable({{ ns_ }}_waveform src/main/waveform.cpp)
target_link_libraries({{ ns_ }}_waveform PRIVATE {{ ns_ }})
install(FILES dom/waveforms/{{ ns_ }}/{{ ns_ }}.sad.xml DESTINATION dom/waveforms/{{ ns_ }})
install(TARGETS {{ ns_ }}_waveform DESTINATION bin)
{% endif %}

{% filter user('end') +%}
{% endfilter +%}
