{% macro cx_empty(t=none, owner=none) %}
{% from '_cx_kind.j2' import cx_kind as _cx_kind %}
{% from '_cx_name.j2' import cx_name as _cx_name %}
{#
  Empty value of a type, returned by a generated handler or method: `::CORBA::string_dup("")`,
  `new T()` for variable-length types, else `T()`. Parameters: t, owner.
#}
{% set kind -%}
  {{- _cx_kind(t=t) -}}
{%- endset -%}
{%- set name -%}
  {{- _cx_name(t=t, owner=owner) -}}
{%- endset -%}
{%- if kind == 'string' -%}
  {{- '::CORBA::string_dup("")' -}}
{%- elif kind == 'variable' -%}
  {{- 'new ' ~ name ~ '()' -}}
{%- else -%}
  {{- name ~ '()' -}}
{%- endif %}
{%+ endmacro %}
