{% macro cx_member(t=none, owner=none) %}
{% from '_cx_kind.j2' import cx_kind as _cx_kind %}
{% from '_cx_name.j2' import cx_name as _cx_name %}
{#
  C++ type holding a value: `::CORBA::String_var` for strings, else the type. Parameters: t, owner.
#}
{% set kind = _cx_kind(t=t) %}
{% filter inline %}
{% if kind == 'string' %}
  ::CORBA::String_var
{% else %}
  {{ _cx_name(t=t, owner=owner) }}
{% endif %}
{% endfilter %}
{% endmacro %}
