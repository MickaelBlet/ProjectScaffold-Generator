{% macro cx_member_id(name=none, scope=none) %}
{% from '_cx_id.j2' import cx_id as _cx_id %}
{#
  C++ name of a member of an IDL scope (see _idl_member). Parameters: name, scope.
#}
{% filter inline %}
{% if name|lower == scope|lower %}
  {{ name }}_
{% else %}
  {{ _cx_id(name=name) }}
{% endif %}
{% endfilter %}
{% endmacro %}
