{% macro cx_name(t=none, owner=none) %}
{% from '_cx_id.j2' import cx_id as _cx_id %}
{% from '_idl_name.j2' import idl_name as _idl_name %}
{#
  C++ type of a type reference in the CORBA mapping: `::CORBA::Long`, `::robot::Pose`; the
  containers are the typedefs of the IDL module `owner` (where the entity naming them is declared):
  `::robot::PoseSeq`. Strings are `char*`. Parameters: t, owner.
#}
{% filter inline %}
{% if t.kind == 'primitive' %}
  {% if t.name in ['int8', 'uint8'] %}
    ::CORBA::Octet
  {% elif t.name == 'int16' %}
    ::CORBA::Short
  {% elif t.name == 'uint16' %}
    ::CORBA::UShort
  {% elif t.name == 'int32' %}
    ::CORBA::Long
  {% elif t.name == 'uint32' %}
    ::CORBA::ULong
  {% elif t.name == 'int64' %}
    ::CORBA::LongLong
  {% elif t.name == 'uint64' %}
    ::CORBA::ULongLong
  {% elif t.name == 'float32' %}
    ::CORBA::Float
  {% elif t.name == 'float64' %}
    ::CORBA::Double
  {% elif t.name == 'bool' %}
    ::CORBA::Boolean
  {% elif t.name == 'char' %}
    ::CORBA::Char
  {% elif t.name == 'string' %}
    char*
  {% elif t.name == 'bytes' %}
    ::CF::OctetSequence
  {% else %}
    {{ t.name }}
  {% endif %}
{% elif t.kind == 'ref' %}
  ::{{ (t.dependency or project.ident)|snake }}::{{ _cx_id(name=t.flatName) }}
{% else %}
  {{ '::' ~ owner ~ '::' }}{{ _idl_name(t=t) }}
{% endif %}
{% endfilter %}
{% endmacro %}
