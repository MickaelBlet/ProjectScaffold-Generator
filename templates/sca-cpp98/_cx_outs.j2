{% macro cx_outs(params=none, owner=none, pad=none) %}
{% from '_cx_id.j2' import cx_id as _cx_id %}
{% from '_cx_kind.j2' import cx_kind as _cx_kind %}
{% from '_cx_name.j2' import cx_name as _cx_name %}
{#
  Statements giving the `out` parameters of an operation an empty value (variable-length ones must
  be set before returning). Parameters: params, owner, pad (indentation).
#}
{% for p in params if p.direction == 'out' %}
{% set kind = _cx_kind(t=p.type) %}
{% set name = _cx_name(t=p.type, owner=owner) %}
{% set id = _cx_id(name=p.name) %}
{% if kind == 'string' %}
{{ pad }}{{ id }} = ::CORBA::string_dup("");
{% elif kind == 'variable' %}
{{ pad }}{{ id }} = new {{ name }}();
{% else %}
{{ pad }}{{ id }} = {{ name }}();
{% endif %}
{% endfor %}
{% endmacro %}
