{% macro cx_ret(t=none, owner=none) %}
{% from '_cx_kind.j2' import cx_kind as _cx_kind %}
{% from '_cx_name.j2' import cx_name as _cx_name %}
{#
  C++ return type of an operation: `void`, `T`, `char*` for strings, `T*` for variable-length
  types (the caller owns them). Parameters: t (nil: none), owner.
#}
{% filter inline %}
{% if t == none %}
  void
{% else %}
  {{ _cx_name(t=t, owner=owner) }}{% if _cx_kind(t=t) == 'variable' %}*{% endif %}
{% endif %}
{% endfilter %}
{% endmacro %}
