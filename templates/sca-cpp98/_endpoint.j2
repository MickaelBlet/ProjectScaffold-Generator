{% macro endpoint(x=none, skip=none) %}
{% from '_accessor.j2' import accessor as _accessor %}
{% from '_id.j2' import id as _id %}
{#
  Expression reaching a port from the scope wiring it: `core().sensor().out()`; `skip` first
  modules of `via` left out (1: from the component holding the port). Parameters: x, skip.
#}
{% filter inline %}
{% for child in x.via[skip:] %}
  {{ _accessor(name=child) }}().
{% endfor %}
{{ _id(name=x.port) }}()
{% endfilter %}
{% endmacro %}
