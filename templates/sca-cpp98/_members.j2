{% macro members(m=none, names=none, access=none, root=none) %}
{% from '_cx_get.j2' import cx_get as _cx_get %}
{% from '_cx_id.j2' import cx_id as _cx_id %}
{% from '_cx_in.j2' import cx_in as _cx_in %}
{% from '_cx_kind.j2' import cx_kind as _cx_kind %}
{% from '_cx_name.j2' import cx_name as _cx_name %}
{% from '_cx_params.j2' import cx_params as _cx_params %}
{% from '_cx_ret.j2' import cx_ret as _cx_ret %}
{% from '_id.j2' import id as _id %}
{% from '_member.j2' import member as _member %}
{#
  Types (typedefs of their IDL types), attribute accessors and methods of a module with an access level (`public`, `protected`,
  `private`): attribute members stay private, private attributes have no accessors.
  Parameters: m, names (taken by the model: no accessor of that name), access, root.
#}
{% set types = m.types|selectattr('access', 'equalto', access) %}
{% if types|length > 0 %}

{% for t in types %}
    typedef ::{{ root }}::{{ _cx_id(name=t.flatName) }} {{ _cx_id(name=t.name) }};
{% endfor %}
{% endif %}
{% set attributes = m.attributes|selectattr('access', 'equalto', access) %}
{% if access != 'private' and attributes|length > 0 %}

{% for a in attributes %}
{% set setter = 'set' ~ a.name|ucfirst %}
{% set kind -%}
  {{- _cx_kind(t=a.type) -}}
{%- endset %}
{{ a.description|doc_comment('    /// ') }}
{% if not (a.name in names) %}
    {%+ if a.static %}static {% endif %}{{ _cx_get(t=a.type, owner=root) }} {{ _id(name=a.name) }}(){% if not a.static %} const{% endif %} { return {{ _member(name=a.name) }}{% if a.static %}(){% endif %}{% if kind == 'string' %}.in(){% endif %}; }
{% endif %}
{% if not (a.const or setter in names) %}
    {%+ if a.static %}static {% endif %}void {{ setter }}({{ _cx_in(t=a.type, owner=root) }} value) { {{ _member(name=a.name) }}{% if a.static %}(){% endif %} = value; }
{% endif %}
{% endfor %}
{% endif %}
{% set methods = m.methods|selectattr('access', 'equalto', access) %}
{% for x in methods %}

{{ x.description|doc_comment('    /// ') }}
{% for r in x.raises %}
    /// @throws {{ _cx_name(t=r, owner=root) }}
{% endfor %}
    {%+ if x.static %}static {% endif %}{% if x.virtual and x.override == false %}virtual {% endif %}{{ _cx_ret(t=x.returns, owner=root) }} {{ _id(name=x.name) }}({{ _cx_params(params=x.params, owner=root) }}){% if x.const %} const{% endif %}{% if x.pure %} = 0{% endif %};
{% endfor %}
{%+ endmacro %}
