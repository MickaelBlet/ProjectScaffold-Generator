{% macro port_name(module=none, port=none, component=none) %}
{#
  Name of a port in the waveform (getPort, SCD, SAD): its own name on the component, else its path
  inside the component (`Store.query`). Parameters: module (path), port, component (path).
#}
{% if module != component -%}
  {%- set prefix = component ~ '.' -%}
  {{- module|replace(prefix, '', 1) ~ '.' -}}
{%- endif -%}
{{- port -}}
{%+ endmacro %}
