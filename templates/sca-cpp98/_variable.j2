{% macro variable(t=none, depth=none) %}
{#
  `true` for a variable-length type of the C++ mapping (strings, sequences, any, and the structs
  and unions holding one): returned as `T*`, passed out as `T_out`. Parameters: t, depth.
#}
{% filter inline %}
{% if t.kind == 'primitive' %}
  {% if t.name in ['string', 'bytes'] %}true{% endif %}
{% elif t.kind == 'ref' %}
  {% set def = typeByKey[t.key] %}
  {% set next = depth + 1 %}
  {% if next > 16 %}
    true
  {% elif def.kind in ['struct', 'exception'] %}
    {% for f in def.fields %}
      {% if variable(t=f.type, depth=next) == 'true' %}
        true
        {% break %}
      {% endif %}
    {% endfor %}
  {% elif def.kind == 'union' %}
    {% for c in def.cases %}
      {% if variable(t=c.type, depth=next) == 'true' %}
        true
        {% break %}
      {% endif %}
    {% endfor %}
  {% elif def.kind == 'alias' %}
    {{ variable(t=def.type, depth=next) }}
  {% elif def.kind == 'primitive' %}
    true
  {% endif %}
{% else %}
  true
{% endif %}
{% endfilter %}
{% endmacro %}
