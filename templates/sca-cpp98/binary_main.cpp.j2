{% from '_header.j2' import header as _header %}
{% from '_qualified.j2' import qualified as _qualified %}
{% include '_banner.j2' %}
{% if binary %}
  {% set process = binary.name %}
  {% set components = modules|selectattr('depth', 'equalto', 0)|selectattr('abstract', 'equalto', false)|selectattr('binary', 'equalto', binary.name) %}
{% else %}
  {% set process = project.name %}
  {% set components = modules|selectattr('depth', 'equalto', 0)|selectattr('abstract', 'equalto', false)|selectattr('binary', 'none') %}
{% endif %}
{% if binary %}
// Executable of binary {{ binary.name }}: its SCA components in one process, bound in the naming
// service by their usage names, where the waveform (SAD) finds them, until SIGINT or SIGTERM.
{% else %}
// Executable of the SCA components in no binary: in one process, bound in the naming service by
// their usage names, where the waveform (SAD) finds them, until SIGINT or SIGTERM.
{% endif %}
{% for m in components %}
#include <{{ _header(e=m) }}>
{% endfor %}
{% filter user('includes') +%}
{% endfilter +%}

int main(int argc, char** argv)
{
    {%+ filter user('main') +%}
    try {
        ::sca::Runtime runtime(argc, argv);
        const ::sca::ExecParams params(argc, argv);
        std::vector<std::pair< ::sca::Resource*, std::string> > components;
{% for m in components %}
        components.push_back(std::make_pair(new {{ _qualified(e=m) }}, std::string("{{ m.name }}_1")));
{% endfor %}
        runtime.serve(components, params);
        runtime.shutdown();
        for (std::size_t i = 0; i < components.size(); ++i) delete components[i].first;
        return 0;
    } catch (const ::CORBA::Exception& e) {
        ::sca::reportError("{{ process }}", e);
    } catch (const std::exception& e) {
        ::sca::reportError("{{ process }}", e.what());
    }
    return 1;
    {%+ endfilter +%}
}
