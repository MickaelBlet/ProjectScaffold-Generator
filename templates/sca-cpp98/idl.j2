{% from '_idl_id.j2' import idl_id as _idl_id %}
{% from '_idl_literal.j2' import idl_literal as _idl_literal %}
{% from '_idl_member.j2' import idl_member as _idl_member %}
{% from '_idl_type.j2' import idl_type as _idl_type %}
{% set ns = namespace(done=[], ready=false) %}
{% include '_banner.j2' %}
{% set ns_ = project.ident|snake %}
{% set guard = ns_|upper ~ '_IDL' %}
// Types, constants and interfaces of {{ project.name }}, in IDL module {{ ns_ }}: the containers of the
// model as typedefs (sequences; maps as sequences of key / value structs), each type after the ones
// it names.
#ifndef {{ guard }}
#define {{ guard }}

#include "CF.idl"
{% for d in dependencies %}
#include "{{ d.name|snake }}.idl"
{% endfor %}
{% filter user('includes') +%}
{% endfilter +%}

{% set idl_body %}
{% set idl = namespace(declared=[]) %}
{# Types of modules too, by their flat name (Core_Sensor_Mode). #}
{% set idl_types = types + moduleTypes %}
{% for pass in idl_types %}
  {% for e in idl_types %}
    {% if e.key in ns.done %}
      {% continue %}
    {% endif %}
    {% set ns.ready = true %}
    {% for u in e.uses.types %}
      {% if u.dependency == none and u.key != e.key and u.key not in ns.done %}
        {% set ns.ready = false %}
      {% endif %}
    {% endfor %}
    {% if ns.ready %}
      {% set ns.done = ns.done + [e.key] %}
      {# A recursive struct or union: declared first, for the sequences of it. #}
      {% if e.uses.types|selectattr('key', 'equalto', e.key)|length > 0 %}
        {% with e = e %}{% include '_idl_forward.j2' %}{% endwith %}
      {% endif %}
      {% with e = e %}{% include '_idl_type_containers.j2' %}{% endwith %}
      {% with e = e %}{% include '_idl_decl.j2' %}{% endwith %}
    {% endif %}
  {% endfor %}
{% endfor %}
{# Types naming each other: all declared first, then defined in their order. #}
{% for e in idl_types if e.key not in ns.done %}
  {% with e = e %}{% include '_idl_forward.j2' %}{% endwith %}
{% endfor %}
{% for e in idl_types if e.key not in ns.done %}
  {% with e = e %}{% include '_idl_type_containers.j2' %}{% endwith %}
  {% with e = e %}{% include '_idl_decl.j2' %}{% endwith %}
{% endfor %}
{% for c in constants %}
{% set idl_value = _idl_literal(v=c.value, t=c.type) +%}

{{ c.description|doc_comment('    // ') }}
{% if idl_value == '' %}
    // {{ c.name }}: no IDL constant of its type.
{% else %}
    const {{ _idl_type(t=c.type) }} {{ _idl_id(name=c.name) }} = {{ idl_value }};
{% endif %}
{% endfor %}
{% for i in interfaces %}
{% for m in i.messages %}
  {% for p in m.params %}
    {% with t = p.type %}{% include '_idl_containers.j2' %}{% endwith %}
  {% endfor %}
  {% if m.returns %}
    {% with t = m.returns %}{% include '_idl_containers.j2' %}{% endwith %}
  {% endif %}
{% endfor %}

{{ i.description|doc_comment('    // ') }}
    interface {{ _idl_id(name=i.name) }} {
{% for m in i.messages %}
{{ m.description|doc_comment('        // ') }}
        {%+ if m.returns %}{{ _idl_type(t=m.returns) }}{% else %}void{% endif %} {{ _idl_member(name=m.name, scope=i.name) }}({% for p in m.params %}{{ p.direction }} {{ _idl_type(t=p.type) }} {{ _idl_id(name=p.name) }}{% if not loop.last %}, {% endif %}{% endfor %}){% if m.raises|length > 0 %} raises ({% for r in m.raises %}{{ _idl_type(t=r) }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %};
{% endfor %}
    };
{% endfor %}
{# Containers of the attributes and methods of the modules (their C++ types). #}
{% for m in modules %}
  {% for a in m.attributes %}
    {% with t = a.type %}{% include '_idl_containers.j2' %}{% endwith %}
  {% endfor %}
  {% for x in m.methods %}
    {% for p in x.params %}
      {% with t = p.type %}{% include '_idl_containers.j2' %}{% endwith %}
    {% endfor %}
    {% if x.returns %}
      {% with t = x.returns %}{% include '_idl_containers.j2' %}{% endwith %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% endset %}
{% set idl_text = idl_body|trim %}
{% if idl_text != '' %}
{{ project.description|doc_comment('// ') }}
module {{ ns_ }} {
{{ idl_body }}

    {%+ filter user('module') +%}
    {%+ endfilter +%}
};
{% else %}
// {{ project.name }} has no types, constants nor interfaces of its own.
{% endif %}

#endif
