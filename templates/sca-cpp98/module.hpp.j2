{% from '_accessor.j2' import accessor as _accessor %}
{% from '_component.j2' import component as _component %}
{% from '_cx_args.j2' import cx_args as _cx_args %}
{% from '_cx_id.j2' import cx_id as _cx_id %}
{% from '_cx_init.j2' import cx_init as _cx_init %}
{% from '_cx_member.j2' import cx_member as _cx_member %}
{% from '_cx_member_id.j2' import cx_member_id as _cx_member_id %}
{% from '_cx_params.j2' import cx_params as _cx_params %}
{% from '_cx_ret.j2' import cx_ret as _cx_ret %}
{% from '_endpoint.j2' import endpoint as _endpoint %}
{% from '_header.j2' import header as _header %}
{% from '_id.j2' import id as _id %}
{% from '_iface_ns.j2' import iface_ns as _iface_ns %}
{% from '_init.j2' import init as _init %}
{% from '_member.j2' import member as _member %}
{% from '_members.j2' import members as _members %}
{% from '_namespace_close.j2' import namespace_close as _namespace_close %}
{% from '_namespace_open.j2' import namespace_open as _namespace_open %}
{% from '_ns.j2' import ns as _ns %}
{% from '_qualified.j2' import qualified as _qualified %}
{% set ns = namespace() %}
{% include '_banner.j2' %}
#pragma once
{% set m = item -%}
{%- set root = project.ident|snake -%}
{%- set class -%}
  {{- _id(name=m.name) -}}
{%- endset -%}
{%- set component -%}
  {{- _component(m=m) -}}
{%- endset -%}
{#- A component deriving from another component is a CF::Resource through it. -#}
{%- set ns.baseComponent = false -%}
{%- for b in m.bases -%}
  {%- set isComponent -%}
    {{- _component(m=b) -}}
  {%- endset -%}
  {%- if isComponent == 'true' and ns.baseComponent == false -%}
    {%- set ns.baseComponent = b -%}
  {%- endif -%}
{%- endfor -%}
{%- set virtuals = m.methods|selectattr('virtual', 'equalto', true)|length -%}
{#- Names given by the model: attribute accessors do not take them. -#}
{%- set methodNames = m.methods|map(attribute='name') -%}
{%- set portNames = m.ports|map(attribute='name') -%}
{%- set names = (methodNames + portNames) -%}
{%- set polymorphic = false -%}
{%- if component == 'true' or (m.abstract or (m.isBase or (virtuals > 0 or m.bases|length > 0))) -%}
  {%- set polymorphic = true -%}
{%- endif -%}
{%- set ns.inherits = '' -%}
{%- if component == 'true' and ns.baseComponent == false -%}
  {%- set ns.inherits = '|public ::sca::Resource' -%}
{%- endif -%}
{%- for b in m.bases -%}
  {%- set base -%}
    {{- _qualified(e=b) -}}
  {%- endset -%}
  {%- set ns.inherits = ns.inherits ~ '|public ' ~ base -%}
{%- endfor %}


#include <{{ root }}.hh>
#include <sca/support.hpp>
{% for b in m.bases %}
#include <{{ _header(e=b) }}>
{% endfor %}
{% for c in m.instances %}
#include <{{ _header(e=c) }}>
{% endfor %}
{% if component == 'true' %}
#include <string>
#include <vector>
{% endif %}
{% filter user('includes') +%}
{% endfilter +%}

{% set ns_ %}{{ _ns(e=m) }}{% endset +%}
{{ _namespace_open(ns_=ns_) }}{##}

{{ m.description|doc_comment }}
{% if component == 'true' %}
/// SCA component {{ m.name }} (CF::Resource): its ports through getPort, its attributes as properties
/// (configure / query); served by the executable of its binary, described in dom/components/{{ m.name }}.
{% endif %}
class {{ class }}{% if ns.inherits != '' %} : {{ ns.inherits|replace('|', '', 1)|replace('|', ', ') }}{% endif %} {
public:
{% if m.kind == 'interface' %}
    {{ class }}(){{ _init(m=m) }}
    {
{% for a in m.attributes %}
{% if a.hasDefault and a.static == false %}
{% set member -%}
  {{- _member(name=a.name) -}}
{%- endset %}
{{ _cx_init(target=member, v=a.default, t=a.type, owner=root, pad='        ', depth=0) }}
{%- endif %}
{% endfor %}
    }
    virtual ~{{ class }}() {}
{% else %}
    {{ class }}();
    {%+ if polymorphic %}virtual {% endif %}~{{ class }}();
{% endif %}
{% for p in m.ports %}
{% if p.interface %}
{% set __capture -%}
  {{- _iface_ns(i=p.interface) -}}
{%- endset %}{% set ns.ifns = __capture -%}
{%- set __capture -%}
  {{- _cx_id(name=p.interface.name) -}}
{%- endset %}{% set ns.iface = __capture +%}

    /// {% if p.role == 'in' %}Provides{% else %}Uses{% endif %} port {{ p.name }}: {{ p.interface.name }}{% if p.delegates|length > 0 %} ({% if p.role == 'in' %}handled by{% else %}sent by{% endif %} {% for d in p.delegates %}{{ d.module }}:{{ d.port }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif +%}
{{ p.description|doc_comment('    /// ') }}
{% if p.role == 'out' %}
    ::sca::UsesPort< ::{{ ns.ifns }}::{{ ns.iface }}>& {{ _id(name=p.name) }}() { return {{ _member(name=p.name) }}; }
{% elif p.delegates|length > 0 %}
    POA_{{ ns.ifns }}::{{ ns.iface }}& {{ _id(name=p.name) }}() { return {{ _endpoint(x=p.delegates[0], skip=0) }}; }
{% else %}
    POA_{{ ns.ifns }}::{{ ns.iface }}& {{ _id(name=p.name) }}() { return {{ p.name }}In_; }
{% endif %}
{% endif %}
{% endfor %}
{% if m.instances|length > 0 %}

{% for c in m.instances %}
    {{ _qualified(e=c) }}& {{ _accessor(name=c.name) }}() { return {% if c.abstract %}*{% endif %}{{ _accessor(name=c.name) }}_; }
{% endfor %}
{% endif %}
{{ _members(m=m, names=names, access='public', root=root) }}{##}

    {%+ filter user('public') +%}
    {%+ endfilter +%}

protected:
{% for p in m.ports %}
{% if p.role == 'in' and (p.interface and p.delegates|length == 0) %}
{% set __capture -%}
  {{- _iface_ns(i=p.interface) -}}
{%- endset %}{% set ns.ifns = __capture +%}
    // Calls received by provides port {{ p.name }}.
{% for msg in p.interface.messages %}
    {{ _cx_ret(t=msg.returns, owner=ns.ifns) }} on{{ p.name|ucfirst }}{{ msg.name|ucfirst }}({{ _cx_params(params=msg.params, owner=ns.ifns) }});
{% endfor %}
{% endif %}
{% endfor %}
{% if component == 'true' %}

    // CF::Resource: life cycle, properties and ports.
    void onInitialize();
    void onStart();
    void onStop();
    void onRelease();
    void onConfigured(const std::string& id);
    bool configureProperty(const std::string& id, const ::CORBA::Any& value);
    bool queryProperty(const std::string& id, ::CORBA::Any& value);
    void propertyIds(std::vector<std::string>& ids);
    ::CORBA::Object_ptr port(const std::string& name);
{% endif %}
{{ _members(m=m, names=names, access='protected', root=root) }}{##}
    {%+ filter user('protected') +%}
    {%+ endfilter +%}

private:
    // Not copyable.
    {{ class }}(const {{ class }}&);
    {{ class }}& operator=(const {{ class }}&);

{% for p in m.ports %}
{% if p.role == 'in' and (p.interface and p.delegates|length == 0) %}
{% set __capture -%}
  {{- _iface_ns(i=p.interface) -}}
{%- endset %}{% set ns.ifns = __capture -%}
{%- set __capture -%}
  {{- _cx_id(name=p.interface.name) -}}
{%- endset %}{% set ns.iface = __capture %}
{% set servant = p.name|ucfirst ~ 'In' %}
    /// Servant of provides port {{ p.name }}: hands its calls to the handlers above.
    class {{ servant }} : public virtual POA_{{ ns.ifns }}::{{ ns.iface }} {
    public:
        explicit {{ servant }}({{ class }}& owner) : owner_(owner) {}
{% for msg in p.interface.messages %}
        {{ _cx_ret(t=msg.returns, owner=ns.ifns) }} {{ _cx_member_id(name=msg.name, scope=p.interface.name) }}({{ _cx_params(params=msg.params, owner=ns.ifns) }})
        {
            return owner_.on{{ p.name|ucfirst }}{{ msg.name|ucfirst }}({{ _cx_args(params=msg.params) }});
        }
{% endfor %}

    private:
        {{ class }}& owner_;
    };
    {{ servant }} {{ p.name }}In_;
{% elif p.role == 'out' and p.interface %}
    ::sca::UsesPort< ::{{ _iface_ns(i=p.interface) }}::{{ _cx_id(name=p.interface.name) }}> {{ _member(name=p.name) }};
{% endif %}
{% endfor %}
{% for c in m.instances %}
{% if c.abstract %}
    {{ _qualified(e=c) }}* {{ _accessor(name=c.name) }}_; // abstract: created in the constructor, deleted by the destructor
{% else %}
    {{ _qualified(e=c) }} {{ _accessor(name=c.name) }}_;
{% endif %}
{% endfor %}
{% for a in m.attributes %}
{% if a.static %}
{% set type -%}
  {{- _cx_member(t=a.type, owner=root) -}}
{%- endset +%}
    /// Static attribute: a function-local static (set to its default on first use).
    static {{ type }}& {{ _member(name=a.name) }}()
    {
        static {{ type }} value;
{% if a.hasDefault %}
        static bool set = false;
        if (!set) {
            set = true;
{{ _cx_init(target='value', v=a.default, t=a.type, owner=root, pad='            ', depth=0) }}{##}
        }
{% endif %}
        return value;
    }
{% else %}
    {{ _cx_member(t=a.type, owner=root) }} {{ _member(name=a.name) }}; // set by the constructor
{% endif %}
{% endfor %}
{{ _members(m=m, names=names, access='private', root=root) }}{##}
    {%+ filter user('private') +%}
    {%+ endfilter +%}
};

{{ _namespace_close(ns_=ns_) -}}
