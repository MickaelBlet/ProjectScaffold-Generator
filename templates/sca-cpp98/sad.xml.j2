{% from '_component.j2' import component as _component %}
{% from '_port_name.j2' import port_name as _port_name %}
{% from '_waveform_links.j2' import waveform_links as _waveform_links %}
{% set ns = namespace(components=[]) %}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE softwareassembly PUBLIC "-//JTRS//DTD SCA V2.2.2 SAD//EN" "softwareassembly.dtd">
{% include '_xml_banner.j2' %}
{% set root = project.ident|snake %}
{% for m in modules %}
  {% if _component(m=m) == 'true' %}
    {% set ns.components = ns.components + [m.path] %}
  {% endif %}
{% endfor %}
{% set waveLinks = _waveform_links()|split(';')|select|list %}
<!-- Waveform {{ project.name|escape|string }}: a component per concrete top-level module, the binaries as host collocations, the first component as assembly controller. -->
<softwareassembly id="DCE:{{ (root ~ '/waveform')|uuid }}" name="{{ project.name|escape|string }}">
{% if project.description != '' %}
    <description>{{ project.description|escape|string }}</description>
{% endif %}
    <componentfiles>
{% for path in ns.components %}
        <componentfile id="{{ path }}_spd" type="SPD">
            <localfile name="/components/{{ path }}/{{ path }}.spd.xml"/>
        </componentfile>
{% endfor %}
    </componentfiles>
    <partitioning>
{% if binaries|length > 0 %}
{% for b in binaries %}
        <hostcollocation id="DCE:{{ (root ~ '/binaries/' ~ b.name)|uuid }}" name="{{ b.name }}">
{% for m in b.modules %}
{% if _component(m=m) == 'true' %}
{% with m = m, pad = '    ' %}{% include '_sad_placement.j2' %}{% endwith %}
{% endif %}
{% endfor %}
        </hostcollocation>
{% endfor %}
{% for path in ns.components %}
{% set ns.inBinary = false %}
{% for b in binaries %}
{% set found = b.modules|selectattr('path', 'equalto', path)|length %}
{% if found > 0 %}
{% set ns.inBinary = true %}
{% endif %}
{% endfor %}
{% if not ns.inBinary %}
{% set m = modules|selectattr('path', 'equalto', path)|first %}
{% with m = m, pad = '' %}{% include '_sad_placement.j2' %}{% endwith %}
{% endif %}
{% endfor %}
{% else %}
{% for path in ns.components %}
{% set m = modules|selectattr('path', 'equalto', path)|first %}
{% with m = m, pad = '' %}{% include '_sad_placement.j2' %}{% endwith %}
{% endfor %}
{% endif %}
    </partitioning>
    <assemblycontroller>
        <componentinstantiationref refid="DCE:{{ (root ~ '/instances/' ~ ns.components[0])|uuid }}"/>
    </assemblycontroller>
{% if waveLinks|length > 0 %}
    <connections>
{% for entry in waveLinks %}
{% set x = entry|split('|')|select|list %}
{% set from = x[1]|split('.')|select|list|first %}
{% set to = x[3]|split('.')|select|list|first %}
{% set fromModule = modules|selectattr('path', 'equalto', from)|first %}
{% set toModule = modules|selectattr('path', 'equalto', to)|first %}
{% set fromComponent = _component(m=fromModule) %}
{% set toComponent = _component(m=toModule) %}
{% if fromComponent == 'true' and toComponent == 'true' %}
        <connectinterface id="{{ x[0] }}">
            <usesport>
                <usesidentifier>{{ _port_name(module=x[1], port=x[2], component=from) }}</usesidentifier>
                <componentinstantiationref refid="DCE:{{ (root ~ '/instances/' ~ from)|uuid }}"/>
            </usesport>
            <providesport>
                <providesidentifier>{{ _port_name(module=x[3], port=x[4], component=to) }}</providesidentifier>
                <componentinstantiationref refid="DCE:{{ (root ~ '/instances/' ~ to)|uuid }}"/>
            </providesport>
        </connectinterface>
{% else %}
        <!-- {{ x[0] }}: {{ x[1] }}:{{ x[2] }} -> {{ x[3] }}:{{ x[4] }}, an end not in a component. -->
{% endif %}
{% endfor %}
    </connections>
{% endif %}
{% set ns.externals = [] %}
{% for s in systems %}
{% for e in s.external %}
{% set top = e.local.module|split('.')|select|list|first %}
{% set topModule = modules|selectattr('path', 'equalto', top)|first %}
{% if _component(m=topModule) == 'true' %}
{% set ns.externals = ns.externals + [e.link.name ~ '|' ~ e.local.module ~ '|' ~ e.local.port ~ '|' ~ top] %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns.externals|length > 0 %}
    <!-- Ports linked to other projects. -->
    <externalports>
{% for entry in ns.externals %}
{% set x = entry|split('|')|select|list %}
{% set owner = modules|selectattr('path', 'equalto', x[1])|first %}
{% set p = owner.ports|selectattr('name', 'equalto', x[2])|first %}
        <port>
            <description>{{ x[0] }}</description>
{% if p.role == 'in' %}
            <providesidentifier>{{ _port_name(module=x[1], port=x[2], component=x[3]) }}</providesidentifier>
{% else %}
            <usesidentifier>{{ _port_name(module=x[1], port=x[2], component=x[3]) }}</usesidentifier>
{% endif %}
            <componentinstantiationref refid="DCE:{{ (root ~ '/instances/' ~ x[3])|uuid }}"/>
        </port>
{% endfor %}
    </externalports>
{% endif %}
</softwareassembly>
