{% from '_exposed.j2' import exposed as _exposed %}
{% from '_port_name.j2' import port_name as _port_name %}
{% from '_repid.j2' import repid as _repid %}
{% set ns = namespace(interfaces=[]) %}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE softwarecomponent PUBLIC "-//JTRS//DTD SCA V2.2.2 SCD//EN" "softwarecomponent.dtd">
{% include '_xml_banner.j2' %}
{% set m = item %}
{% set exposed = _exposed(m=m)|split(',')|select|list %}
{# Interfaces of the ports (ns.interfaces): `repid|name` entries. #}
<softwarecomponent>
    <corbaversion>2.2</corbaversion>
    <componentrepid repid="IDL:CF/Resource:1.0"/>
    <componenttype>resource</componenttype>
    <componentfeatures>
        <supportsinterface repid="IDL:CF/Resource:1.0" supportsname="Resource"/>
        <supportsinterface repid="IDL:CF/LifeCycle:1.0" supportsname="LifeCycle"/>
        <supportsinterface repid="IDL:CF/TestableObject:1.0" supportsname="TestableObject"/>
        <supportsinterface repid="IDL:CF/PropertySet:1.0" supportsname="PropertySet"/>
        <supportsinterface repid="IDL:CF/PortSupplier:1.0" supportsname="PortSupplier"/>
        <ports>
{% for p in m.ports %}
{% if p.interface %}
{% set repid = _repid(i=p.interface) %}
{% set ns.interfaces = ns.interfaces + [repid ~ '|' ~ p.interface.name] %}
{% with role = p.role, name = p.name, repid = repid, description = p.description %}{% include '_scd_port.j2' %}{% endwith %}
{% endif %}
{% endfor %}
{% for x in exposed %}
{% set parts = x|split(':')|select|list %}
{% set inner = modules|selectattr('path', 'equalto', parts[0])|first %}
{% set innerPort = inner.ports|selectattr('name', 'equalto', parts[1])|first %}
{% if innerPort.interface %}
{% set repid = _repid(i=innerPort.interface) %}
{% set portName = _port_name(module=parts[0], port=parts[1], component=m.path) %}
{% set ns.interfaces = ns.interfaces + [repid ~ '|' ~ innerPort.interface.name] %}
{% with role = innerPort.role, name = portName, repid = repid, description = innerPort.description %}{% include '_scd_port.j2' %}{% endwith %}
{% endif %}
{% endfor %}
        </ports>
    </componentfeatures>
    <interfaces>
        <interface repid="IDL:CF/Resource:1.0" name="Resource">
            <inheritsinterface repid="IDL:CF/LifeCycle:1.0"/>
            <inheritsinterface repid="IDL:CF/TestableObject:1.0"/>
            <inheritsinterface repid="IDL:CF/PropertySet:1.0"/>
            <inheritsinterface repid="IDL:CF/PortSupplier:1.0"/>
        </interface>
        <interface repid="IDL:CF/LifeCycle:1.0" name="LifeCycle"/>
        <interface repid="IDL:CF/TestableObject:1.0" name="TestableObject"/>
        <interface repid="IDL:CF/PropertySet:1.0" name="PropertySet"/>
        <interface repid="IDL:CF/PortSupplier:1.0" name="PortSupplier"/>
        <interface repid="IDL:CF/Port:1.0" name="Port"/>
{% for i in ns.interfaces|unique %}
{% set parts = i|split('|')|select|list %}
        <interface repid="{{ parts[0] }}" name="{{ parts[1] }}"/>
{% endfor %}
    </interfaces>
</softwarecomponent>
