{% set ns = namespace() %}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE softpkg PUBLIC "-//JTRS//DTD SCA V2.2.2 SPD//EN" "softpkg.dtd">
{% include '_xml_banner.j2' %}
{% set root = project.ident|snake -%}
{%- if item.binary -%}
  {%- set exe = (root ~ '_' ~ item.binary)|snake -%}
{%- else -%}
  {%- set exe = root ~ '_app' -%}
{%- endif -%}
{%- set id = (root ~ '/components/' ~ item.name)|uuid -%}
{%- set ns.author = '' -%}
{%- for entry in project.metadata.items() -%}
  {%- if entry[0] == 'author' -%}
    {%- set ns.author = entry[1] -%}
  {%- endif -%}
{%- endfor %}
<softpkg id="DCE:{{ id }}" name="{{ item.name }}">
    <author>
{% if ns.author != '' %}
        <name>{{ ns.author|escape|string }}</name>
{% endif %}
    </author>
{% if item.description != '' %}
    <description>{{ item.description|escape|string }}</description>
{% endif %}
    <propertyfile type="PRF">
        <localfile name="{{ item.name }}.prf.xml"/>
    </propertyfile>
    <descriptor>
        <localfile name="{{ item.name }}.scd.xml"/>
    </descriptor>
    <implementation id="DCE:{{ (id ~ '/cpp')|uuid }}">
        <code type="Executable">
            <localfile name="/bin/{{ exe }}"/>
            <entrypoint>/bin/{{ exe }}</entrypoint>
        </code>
        <programminglanguage name="C++"/>
        <humanlanguage name="EN"/>
        <runtime name="omniORB" version="4"/>
        <os name="Linux"/>
    </implementation>
</softpkg>
