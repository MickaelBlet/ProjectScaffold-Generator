syntax = "scaffold1";

/// Two binaries calling each other over every generated transport (tests/remote)
project "Relay";

/// Makes the calls
binary Client;
/// Answers them
binary Server;

enum Mode : uint8 {
  Idle = 0;
  Run = 1;
  Fault = 7;
}

struct Vec3 {
  float64 x;
  float64 y;
  float64 z;
}

/// One of each number
struct Numbers {
  int8 i8;
  uint8 u8;
  int16 i16;
  uint16 u16;
  int32 i32;
  uint32 u32;
  int64 i64;
  uint64 u64;
  float32 f32;
  float64 f64;
}

/// Every kind of field
struct Sample {
  uint64 id;
  Mode mode = Run;
  bool ok = true;
  char letter = a;
  string label = none;
  bytes raw;
  Numbers numbers;
  Vec3 pos;
  vector<Vec3> path;
  array<float32, 4> box;
  set<int16> flags;
  list<int8> history;
  map<string, int32> tags;
  optional<string> note;
}

alias Samples = vector<Sample>;

/// Recursive type
struct Tree {
  string name;
  vector<Tree> children;
}

/// Bounded names
alias Names = vector<string(4), 3>;

bitmask Access : uint8 {
  Read = 1 << 0;
  Write = 1 << 1;
  Exec = 1 << 7;
}

/// Enum discriminator, no default case
union Command switch (Mode) {
  case Idle: string(8) note;
  case Run: float64 speed;
}

/// Integer discriminator, default case
union Item switch (int16) {
  case 1, 2: int32 number;
  case -3: Names names;
  case default: string text;
}

/// Level out of range
exception Refused {
  string(16) reason;
  int32 code;
}

exception Timeout {}

struct Badge {
  string(4) code;
  map<uint8, bytes(2), 2> marks;
  Access access = [Read, Exec];
  Command command = { speed: 1.5 };
}

/// Most names of Names
const uint8 MaxNames = 3;
const string Greeting = hello;
const Mode DefaultMode = Run;
const Access DefaultAccess = [Read, Write];
const Vec3 Origin = { x: 0, y: 0, z: 1.5 };
const map<string, float32> Weights = { a: 0.5 };
const Item FirstItem = { number: 7 };

/// Every call sends its arguments back
interface Echo {
  Sample echo(Sample sample);
  void sum(vector<int32> values, out int64 total);
  bool scale(inout Vec3 v, float64 factor);
  void notify(string text);
  string last();
  Samples samples(uint8 count);
  Tree tree(Tree t);
  optional<string> pick(map<Mode, optional<string>> m, Mode key);
  Names names(Names names);
  Access access(Access a);
  Command command(Command c);
  Item item(Item i);
  bool check(int32 level) raises (Refused, Timeout);
  Badge badge(Badge b);
}

interface Status {
  void report(Mode mode, string from);
}

/// Calls the service over every transport
module Caller {
  binary = Client;

  out Echo tcp;
  out Echo udp;
  out Echo http;
  out Echo websocket;
  out Echo shm;
  out Echo mq;
  out Echo mqtt;
  in Status status;
}

/// Answers the calls
module Service {
  binary = Server;

  in Echo tcp;
  in Echo udp;
  in Echo http;
  in Echo websocket;
  in Echo shm;
  in Echo mq;
  in Echo mqtt;
  out Status status;
}

link echo_tcp: Caller.tcp <-> Service.tcp ack 2000 remote tcp { client: { host: "127.0.0.1", port: 47210 }, server: { host: "0.0.0.0", port: 47210 } };
link echo_udp: Caller.udp <-> Service.udp remote udp;
link echo_http: Caller.http <-> Service.http ack 2000 remote http { path: "/relay/echo" };
link echo_websocket: Caller.websocket <-> Service.websocket ack 2000 remote websocket;
link echo_shm: Caller.shm <-> Service.shm ack 2000 remote shm { name: relay_echo_segment, capacity: 4194304 };
link echo_mq: Caller.mq <-> Service.mq ack 2000 remote mq { name: relay_echo_queues, maxMessages: 8, messageSize: 8192 };
link echo_mqtt: Caller.mqtt <-> Service.mqtt ack 2000 remote mqtt { broker: { host: broker.local, port: 1883 }, topic: "relay/echo", options: { qos: "1" } };
link status: Service.status -> Caller.status remote tcp;
